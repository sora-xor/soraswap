    },
    {
      "id": "REPLACE_WITH_OPERATIONS_APPROVER_ID",
      "role": "operations",
      "public_key": "REPLACE_WITH_SSH_ED25519_PUBLIC_KEY",
      "independent": true
    }
  ],
  "allowed_monitoring_origins": ["https://REPLACE_WITH_MONITORING_ORIGIN"],
  "approval_max_age_seconds": 86400,
  "observation": {
    "duration_seconds": 1800,
    "interval_seconds": 30,
    "minimum_samples": 61,
    "maximum_monitoring_sample_age_seconds": 30,
