{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soraswap.invalid/schema/production-monitoring-snapshot-v1.json",
  "title": "SoraSwap production cutover monitoring snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sampled_at", "sequence", "bindings", "validator_set_sha256", "validators", "api_failures", "oracles", "balances", "readonly_routes", "shared_derivatives_regression"],
  "properties": {
    "schema": {"const": "soraswap-production-monitoring-snapshot/v1"},
    "sampled_at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 0},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_fingerprint", "soraswap_git_sha", "soraswap_tree_sha", "soraswap_source_sha256", "iroha_state_sha256", "approval_id", "approval_sha256", "deploy_generated_at", "deploy_sha256", "contracts_generated_at", "contracts_sha256"],
      "properties": {
        "chain_fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["torii_url", "chain", "block_1_hash"],
          "properties": {
            "torii_url": {"type": "string", "pattern": "^https://"},
            "chain": {"type": "string", "minLength": 12},
            "block_1_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "soraswap_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "soraswap_tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "soraswap_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "iroha_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approval_id": {"type": "string", "minLength": 16},
        "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deploy_generated_at": {"type": "string", "minLength": 16},
        "deploy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contracts_generated_at": {"type": "string", "minLength": 16},
        "contracts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "validator_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validators": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status_block_height", "canonical_height", "commit_qc_height", "highest_qc_height", "finality_age_ms", "status_queue_size", "status_queue_queued", "status_queue_inflight", "proposal_queue_depth", "tx_queue_depth", "oldest_queue_age_ms", "lane_backlog", "api_failures"],
        "properties": {
          "id": {"type": "string", "pattern": "^ed0120[0-9a-f]{64}$"},
          "status_block_height": {"type": "integer", "minimum": 1},
          "canonical_height": {"type": "integer", "minimum": 1},
          "commit_qc_height": {"type": "integer", "minimum": 1},
          "highest_qc_height": {"type": "integer", "minimum": 1},
          "finality_age_ms": {"type": "integer", "minimum": 0},
          "status_queue_size": {"type": "integer", "minimum": 0},
          "status_queue_queued": {"type": "integer", "minimum": 0},
          "status_queue_inflight": {"type": "integer", "minimum": 0},
          "proposal_queue_depth": {"type": "integer", "minimum": 0},
          "tx_queue_depth": {"type": "integer", "minimum": 0},
          "oldest_queue_age_ms": {"type": "integer", "minimum": 0},
          "lane_backlog": {"type": "integer", "minimum": 0},
          "api_failures": {"type": "integer", "minimum": 0}
        }
      }
    },
    "api_failures": {"type": "integer", "minimum": 0},
    "oracles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_sha256", "feeds"],
      "properties": {
        "watch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "feeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "age_seconds"],
            "properties": {
              "id": {"type": "string", "minLength": 3},
              "age_seconds": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "balances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["watch_sha256", "entries"],
      "properties": {
        "watch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "amount"],
            "properties": {
              "id": {"type": "string", "minLength": 3},
              "kind": {"enum": ["signer_fee", "watched"]},
              "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}
            }
          }
        }
      }
    },
    "readonly_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_sha256", "ok", "failure_count"],
      "properties": {
        "set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ok": {"const": true},
        "failure_count": {"const": 0}
      }
    },
    "shared_derivatives_regression": {"type": "boolean"}
  }
}
