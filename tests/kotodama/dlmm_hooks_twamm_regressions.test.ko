module DlmmHookManagerV1Regressions {
  koto_test { target: "../../contracts/dlmm_hooks/hook_manager.ko" }

  fixture hook_actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    actor(
      "custody",
      AccountId::parse("sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V")
    );
    actor(
      "guardian",
      AccountId::parse("sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP")
    );
    grant_permission("owner", "Admin");
    grant_permission("owner", "Entry");
    grant_permission("owner", "AssetOps");
    grant_permission("guardian", "Admin");
    grant_permission("guardian", "AssetOps");
  }

  #[test(fixture = "hook_actors")]
  fn lifecycle_is_immutable_and_starts_paused() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::assert(HookManagerInitialized == 1);
    test::assert(HookManagerWithdrawalOnly == 1);
    test::assert(HookManagerCustodyAccount == test::actor_account("custody"));
    test::assert(TwammActiveOrderCount == 0);
  }

  #[test(fixture = "hook_actors")]
  fn identical_assets_are_rejected_before_initialization() {
    test::expect_reject_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
  }

  #[test(fixture = "hook_actors")]
  fn guardian_can_pause_but_cannot_resume() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "exit_withdrawal_only",
      arguments: Json::parse("{}")
    );
    test::invoke_kotoage_as(
      actor: "guardian",
      kotoage: "enter_withdrawal_only",
      arguments: Json::parse("{}")
    );
    test::expect_reject_as(
      actor: "guardian",
      kotoage: "exit_withdrawal_only",
      arguments: Json::parse("{}")
    );
    test::assert(HookManagerWithdrawalOnly == 1);
  }

  #[test(fixture = "hook_actors")]
  fn invalid_hook_policy_is_atomic() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "configure_hook_policy",
      arguments: Json::parse("{\"hook_id\":\"bad\",\"phase\":\"0\",\"max_fee_pips\":\"1000000\",\"enabled\":\"2\"}")
    );
    test::assert(!HookEnabled.contains(Name::parse("bad")));
  }

  #[test(fixture = "hook_actors")]
  fn paused_twamm_rejects_before_slot_allocation() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "schedule_twamm",
      arguments: Json::parse("{\"order_id\":\"paused\",\"total_in\":\"10\",\"slice_in\":\"1\",\"input_is_base\":\"1\",\"min_total_out\":\"1\",\"start_slot\":\"0\",\"interval_slots\":\"1\"}")
    );
    test::assert(TwammActiveOrderCount == 0);
    test::assert(!TwammOrderOwner.contains(Name::parse("paused")));
  }

  #[test]
  fn final_slice_carries_aggregate_rounding_remainder() {
    let order_id = Name::parse("rounding");
    TwammOrderTotalIn[order_id] = 3;
    TwammOrderMinTotalOut[order_id] = 2;
    TwammOrderExecutedOut[order_id] = 0;
    let first = twamm_min_slice_out(order_id: order_id, amount_in: 1, remaining: 3);
    let final_slice = twamm_min_slice_out(order_id: order_id, amount_in: 1, remaining: 1);
    test::assert(first > 0 && first < 1);
    test::assert(final_slice == 2);
  }

  #[test(fixture = "hook_actors")]
  fn active_order_cap_rejects_without_overwriting_slots() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "exit_withdrawal_only",
      arguments: Json::parse("{}")
    );
    for offset in range(64) {
      TwammSlotOccupied[offset + 1] = 1;
    }
    TwammActiveOrderCount = 64;
    test::expect_reject_as(
      actor: "owner",
      kotoage: "schedule_twamm",
      arguments: Json::parse("{\"order_id\":\"overflow\",\"total_in\":\"10\",\"slice_in\":\"1\",\"input_is_base\":\"1\",\"min_total_out\":\"1\",\"start_slot\":\"0\",\"interval_slots\":\"1\"}")
    );
    test::assert(TwammActiveOrderCount == 64);
    test::assert(!TwammOrderOwner.contains(Name::parse("overflow")));
  }

  #[test(fixture = "hook_actors")]
  fn malformed_twamm_schedule_rejects_before_escrow() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "exit_withdrawal_only",
      arguments: Json::parse("{}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "schedule_twamm",
      arguments: Json::parse("{\"order_id\":\"badshape\",\"total_in\":\"10\",\"slice_in\":\"11\",\"input_is_base\":\"2\",\"min_total_out\":\"1\",\"start_slot\":\"0\",\"interval_slots\":\"0\"}")
    );
    test::assert(TwammActiveOrderCount == 0);
  }

  #[test(fixture = "hook_actors")]
  fn non_owner_cannot_cancel_active_order() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    let order_id = Name::parse("owned");
    TwammOrderOwner[order_id] = test::actor_account("owner");
    TwammOrderStatus[order_id] = 1;
    test::expect_reject_as(
      actor: "guardian",
      kotoage: "cancel_twamm",
      arguments: Json::parse("{\"order_id\":\"owned\"}")
    );
    test::assert(TwammOrderStatus.get(order_id).unwrap_or(0) == 1);
  }

  #[test(fixture = "hook_actors")]
  fn trigger_configuration_enforces_runtime_bound() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"custody_account\":\"sorauﾛ1Nｽヰpeｳc1xR8kTﾐVyDNpﾅPTｽﾙｽ8EﾓｶwPjxﾙﾈｱQｼﾔAWBE5V\",\"router_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PqｶU37vXｾﾏﾈﾚKﾔczｽPmzﾑhﾘpaﾛeﾛ2ﾏASﾄMYrｼYWPXJYVP\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "configure_trigger_twamm",
      arguments: Json::parse("{\"cadence_slots\":\"1\",\"max_orders_per_tick\":\"65\",\"enabled\":\"1\"}")
    );
    test::assert(TwammTriggerEnabled == 0);
    test::assert(TwammMaxOrdersPerTick == 1);
  }
}
