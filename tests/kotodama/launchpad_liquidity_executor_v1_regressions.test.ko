module LaunchpadLiquidityExecutorV1Regressions {
  koto_test { target: "../../contracts/launchpad/liquidity_executor.ko" }

  fixture executor_actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    actor(
      "factory",
      AccountId::parse("sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV")
    );
    actor(
      "guardian",
      AccountId::parse("sorauﾛ1Nﾓf6sfﾈPLMRED1Vr5zｸCﾘｳgｹ7ﾉrMxﾀ2ﾂL9YAｾHUDD6F42")
    );
    grant_permission("owner", "Admin");
    grant_permission("owner", "AssetOps");
    grant_permission("factory", "AssetOps");
    grant_permission("guardian", "Admin");
  }

  fn hajimari_arguments() -> Json {
    return Json::parse("{\"pool_contract\":\"0x01\",\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"sale_factory_account\":\"sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV\",\"guardian\":\"sorauﾛ1Nﾓf6sfﾈPLMRED1Vr5zｸCﾘｳgｹ7ﾉrMxﾀ2ﾂL9YAｾHUDD6F42\"}");
  }

  #[test(fixture = "executor_actors")]
  fn lifecycle_derives_custody_and_starts_paused_with_zero_aggregates() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: hajimari_arguments()
    );
    test::assert(ExecutorInitialized == 1);
    test::assert(ExecutorPaused == 1);
    test::assert(ExecutorContractAccount != ExecutorOwner);
    test::assert(ExecutorContractAccount != test::actor_account("factory"));
    test::assert(ExecutorContractAccount != test::actor_account("guardian"));
    test::assert(SeedCount == 0);
    test::assert(TotalBaseAmount == zero_quantity());
    test::assert(TotalQuoteAmount == zero_quantity());
    test::assert(TotalShares == zero_quantity());
    test::assert(LastSeedSlot == 0);
  }

  #[test(fixture = "executor_actors")]
  fn owner_cannot_also_be_the_sale_factory() {
    test::expect_reject_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"pool_contract\":\"0x01\",\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"sale_factory_account\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"guardian\":\"sorauﾛ1Nﾓf6sfﾈPLMRED1Vr5zｸCﾘｳgｹ7ﾉrMxﾀ2ﾂL9YAｾHUDD6F42\"}")
    );
  }

  #[test(fixture = "executor_actors")]
  fn paused_executor_rejects_factory_before_asset_staging() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: hajimari_arguments()
    );
    test::expect_reject_as(
      actor: "factory",
      kotoage: "seed_liquidity",
      arguments: Json::parse("{\"amount_in\":\"1\",\"min_out\":\"1\"}")
    );
    test::assert(SeedCount == 0);
  }

  #[test(fixture = "executor_actors")]
  fn non_factory_caller_is_rejected_before_asset_staging() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "seed_liquidity",
      arguments: Json::parse("{\"amount_in\":\"1\",\"min_out\":\"1\"}")
    );
    test::assert(SeedCount == 0);
  }

  #[test(fixture = "executor_actors")]
  fn both_quantity2_legs_must_be_positive() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "factory",
      kotoage: "seed_liquidity",
      arguments: Json::parse("{\"amount_in\":\"0\",\"min_out\":\"1\"}")
    );
    test::expect_reject_as(
      actor: "factory",
      kotoage: "seed_liquidity",
      arguments: Json::parse("{\"amount_in\":\"1\",\"min_out\":\"0\"}")
    );
    test::assert(SeedCount == 0);
    test::assert(TotalShares == zero_quantity());
  }

  #[test(fixture = "executor_actors")]
  fn guardian_can_pause_but_cannot_resume() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::invoke_kotoage_as(
      actor: "guardian",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"1\"}")
    );
    test::expect_reject_as(
      actor: "guardian",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::assert(ExecutorPaused == 1);
  }
}
