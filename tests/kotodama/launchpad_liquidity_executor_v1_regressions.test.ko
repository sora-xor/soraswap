module LaunchpadLiquidityExecutorV1Regressions {
  koto_test { target: "../../contracts/launchpad/liquidity_executor.ko" }

  fixture executor_actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    actor(
      "factory",
      AccountId::parse("sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6")
    );
    actor(
      "guardian",
      AccountId::parse("sorauﾛ1NfｷgﾉﾓﾉBｦKﾌﾘﾒoﾇﾂﾛrG81ﾋjWﾎﾕVncwﾌSｱ3pﾘﾋﾉhUS9Q76")
    );
    grant_permission("owner", "Admin");
    grant_permission("owner", "AssetOps");
    grant_permission("factory", "AssetOps");
    grant_permission("guardian", "Admin");
  }

  fn initialize_executor() {
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "hajimari",
      arguments: Json::parse("{\"pool_contract\":\"0x01\",\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"executor_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"sale_factory_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"guardian\":\"sorauﾛ1NfｷgﾉﾓﾉBｦKﾌﾘﾒoﾇﾂﾛrG81ﾋjWﾎﾕVncwﾌSｱ3pﾘﾋﾉhUS9Q76\"}")
    );
  }

  #[test(fixture = "executor_actors")]
  fn lifecycle_starts_paused_and_has_no_seed_records() {
    initialize_executor();
    test::assert(ExecutorInitialized == 1);
    test::assert(ExecutorPaused == 1);
    test::assert(SeedCount == 0);
    test::assert(ExecutorOwner == test::actor_account("owner"));
  }

  #[test(fixture = "executor_actors")]
  fn owner_account_cannot_be_configured_as_executor_custody() {
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "hajimari",
      arguments: Json::parse("{\"pool_contract\":\"0x01\",\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"executor_account\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"sale_factory_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"guardian\":\"sorauﾛ1NfｷgﾉﾓﾉBｦKﾌﾘﾒoﾇﾂﾛrG81ﾋjWﾎﾕVncwﾌSｱ3pﾘﾋﾉhUS9Q76\"}")
    );
  }

  #[test(fixture = "executor_actors")]
  fn paused_executor_rejects_factory_before_asset_staging() {
    initialize_executor();
    test::expect_reject_as(
      actor: "factory",
      entrypoint: "seed_liquidity",
      arguments: Json::parse("{\"position_id\":\"sale1\",\"funding_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"bin_id\":\"0\",\"base_amount\":\"1\",\"quote_amount\":\"1\"}")
    );
    test::assert(SeedCount == 0);
  }

  #[test(fixture = "executor_actors")]
  fn non_factory_caller_is_rejected_before_asset_staging() {
    initialize_executor();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "seed_liquidity",
      arguments: Json::parse("{\"position_id\":\"sale1\",\"funding_account\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"bin_id\":\"0\",\"base_amount\":\"1\",\"quote_amount\":\"1\"}")
    );
    test::assert(SeedCount == 0);
  }

  #[test(fixture = "executor_actors")]
  fn zero_liquidity_is_rejected_before_nested_call() {
    initialize_executor();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "factory",
      entrypoint: "seed_liquidity",
      arguments: Json::parse("{\"position_id\":\"sale1\",\"funding_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"bin_id\":\"0\",\"base_amount\":\"0\",\"quote_amount\":\"0\"}")
    );
    test::assert(!SeedCompleted.contains(Name::parse("sale1")));
  }

  #[test(fixture = "executor_actors")]
  fn duplicate_position_is_rejected_before_nested_call() {
    initialize_executor();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    SeedCompleted[Name::parse("sale1")] = 1;
    test::expect_reject_as(
      actor: "factory",
      entrypoint: "seed_liquidity",
      arguments: Json::parse("{\"position_id\":\"sale1\",\"funding_account\":\"sorauﾛ1NcMBm2dﾌBokヱDﾑﾅekAbｶﾍﾜﾇﾐMFｽヱﾋZﾘ2u4WGUMMS63EY6\",\"bin_id\":\"0\",\"base_amount\":\"1\",\"quote_amount\":\"1\"}")
    );
    test::assert(SeedCount == 0);
  }

  #[test(fixture = "executor_actors")]
  fn guardian_can_pause_but_cannot_resume() {
    initialize_executor();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::invoke_entrypoint_as(
      actor: "guardian",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"1\"}")
    );
    test::expect_reject_as(
      actor: "guardian",
      entrypoint: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::assert(ExecutorPaused == 1);
  }
}
