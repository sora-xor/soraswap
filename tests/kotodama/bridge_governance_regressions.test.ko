module BridgeGovernanceRegressions {
  koto_test { target: "../../contracts/bridge/sccp_bridge.ko" }

  fixture bridge_actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX")
    );
    grant_permission("owner", "AssetOps");
  }

  fn seed_bridge(AccountId owner) {
    let asset_key = Name::parse("asset");
    BridgeInitialized = 1;
    BridgeOwner = owner;
    BridgeProofAuthority = owner;
    RegistryEnabled = 1;
    ListingFeeAsset = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
    TreasuryAccount = owner;
    ListingFeeAmount = 0;
    RegisteredAsset[asset_key] = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
    AssetRegistrant[asset_key] = owner;
    AssetHomeDomain[asset_key] = 0;
    AssetDecimals[asset_key] = 18;
    AssetVaultAccount[asset_key] = owner;
  }

  #[test(fixture = "bridge_actors")]
  fn governed_route_cannot_rewrite_governance_message() {
    let owner = test::actor_account("owner");
    let route = Name::parse("route");
    seed_bridge(owner: owner);

    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "activate_route_governed",
      arguments: Json::parse("{\"message_id\":\"msgone\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":\"1\"}")
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "activate_route_governed",
      arguments: Json::parse("{\"message_id\":\"msgone\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":\"1\"}")
    );

    test::assert(RouteGoverned.get(route).unwrap_or(0) == 1);
    test::assert(
      RouteGovernanceMessage.get(route).unwrap_or(Name::parse("missing")) == Name::parse("msgone")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "activate_route_governed",
      arguments: Json::parse("{\"message_id\":\"msgtwo\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":\"1\"}")
    );
  }
}
