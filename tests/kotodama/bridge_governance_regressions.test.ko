koto_test { target: "../../contracts/bridge/sccp_bridge.ko" }

fixture bridge_actors {
  actor("owner", AccountId::parse("ed0120AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"));
}

fn seed_bridge(AccountId owner) {
  let asset_key = Name::parse("asset");
  BridgeInitialized = 1;
  BridgeOwner = owner;
  BridgeProofAuthority = owner;
  RegistryEnabled = 1;
  RegisteredAsset[asset_key] = asset_definition("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
  AssetHomeDomain[asset_key] = 0;
  AssetDecimals[asset_key] = 18;
  AssetVaultAccount[asset_key] = owner;
}

#[test(fixture="bridge_actors")]
fn governed_route_cannot_rewrite_governance_message() {
  let owner = actor_account("owner");
  let route = Name::parse("route");
  seed_bridge(owner);

  invoke_entrypoint_as("owner", "activate_route_governed", json("{\"message_id\":\"msgone\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":1}"));
  invoke_entrypoint_as("owner", "activate_route_governed", json("{\"message_id\":\"msgone\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":1}"));

  assert(RouteGoverned[route] == 1, "route governed");
  assert(RouteGovernanceMessage[route] == Name::parse("msgone"), "governance message");
  expect_reject_as("owner", "activate_route_governed", json("{\"message_id\":\"msgtwo\",\"route\":\"route\",\"asset_key\":\"asset\",\"remote_domain\":1}"));
}
