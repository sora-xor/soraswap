module OptionsVaultV1Regressions {
  koto_test { target: "../../contracts/options/vault.ko" }

  fixture vault_owner {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    grant_permission("owner", "Admin");
    grant_permission("owner", "Entry");
  }

  fn initialize_vault() {
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "hajimari",
      arguments: Json::parse("{\"settlement_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"risk_vault_contract\":\"0x01\"}")
    );
  }

  fn leave_withdrawal_mode_for_test() {
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "exit_withdrawal_only",
      arguments: Json::parse("{}")
    );
  }

  fn record_standard_position() {
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "record_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"series_id\":\"2\",\"owner\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"collateral_locked\":\"1000\",\"premium_paid\":\"100\"}")
    );
  }

  #[test(fixture = "vault_owner")]
  fn lifecycle_starts_in_withdrawal_only_mode() {
    initialize_vault();
    test::assert(OptVaultInitialized == 1);
    test::assert(OptVaultWithdrawalOnly == 1);
    test::assert(OptVaultOwner == test::actor_account("owner"));
    test::assert(OptVaultController == test::actor_account("owner"));
  }

  #[test(fixture = "vault_owner")]
  fn withdrawal_only_rejects_new_position_accounting() {
    initialize_vault();
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "record_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"series_id\":\"2\",\"owner\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"collateral_locked\":\"1000\",\"premium_paid\":\"100\"}")
    );
    test::assert(!OptVaultPositionOwner.contains(7));
  }

  #[test(fixture = "vault_owner")]
  fn missing_position_cannot_be_materialized_by_zero_settlement() {
    initialize_vault();
    leave_withdrawal_mode_for_test();
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"404\",\"payout\":\"0\",\"premium_burn\":\"0\"}")
    );
    test::assert(!OptVaultPositionStatus.contains(404));
  }

  #[test(fixture = "vault_owner")]
  fn settlement_updates_position_and_series_once() {
    initialize_vault();
    leave_withdrawal_mode_for_test();
    record_standard_position();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"payout\":\"250\",\"premium_burn\":\"100\"}")
    );
    test::assert(position_collateral_value(7) == 750);
    test::assert(position_premium_value(7) == zero_quantity());
    test::assert(position_payout_value(7) == 250);
    test::assert(position_status_value(7) == 2);
    test::assert(series_collateral_value(2) == 750);
    test::assert(series_premium_value(2) == zero_quantity());
    test::assert(series_payout_value(2) == 250);
  }

  #[test(fixture = "vault_owner")]
  fn duplicate_settlement_rejects_and_rolls_back() {
    initialize_vault();
    leave_withdrawal_mode_for_test();
    record_standard_position();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"payout\":\"250\",\"premium_burn\":\"100\"}")
    );
    let collateral_before = position_collateral_value(7);
    let payout_before = position_payout_value(7);
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"payout\":\"1\",\"premium_burn\":\"0\"}")
    );
    test::assert(position_collateral_value(7) == collateral_before);
    test::assert(position_payout_value(7) == payout_before);
  }

  #[test(fixture = "vault_owner")]
  fn aggregate_corruption_is_rejected_before_position_mutation() {
    initialize_vault();
    leave_withdrawal_mode_for_test();
    record_standard_position();
    OptVaultSeriesCollateralLocked[2] = 10;
    let position_before = position_collateral_value(7);
    test::expect_reject_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"payout\":\"20\",\"premium_burn\":\"0\"}")
    );
    test::assert(position_collateral_value(7) == position_before);
    test::assert(series_collateral_value(2) == 10);
  }

  #[test(fixture = "vault_owner")]
  fn residual_collateral_can_be_released_after_settlement() {
    initialize_vault();
    leave_withdrawal_mode_for_test();
    record_standard_position();
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "settle_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"payout\":\"250\",\"premium_burn\":\"100\"}")
    );
    test::invoke_entrypoint_as(
      actor: "owner",
      entrypoint: "release_position",
      arguments: Json::parse("{\"position_id\":\"7\",\"collateral_release\":\"750\"}")
    );
    test::assert(position_collateral_value(7) == zero_quantity());
    test::assert(series_collateral_value(2) == zero_quantity());
  }
}
