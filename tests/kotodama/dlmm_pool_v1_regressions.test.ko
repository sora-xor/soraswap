  #[test(fixture = "pool_actor")]
  fn corrupted_link_is_rejected_before_unbounded_traversal() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    ensure_bin_indexed(0);
    ensure_bin_indexed(1);
    BinReserveQuote[1] = 1000;
    NextIndexedBin[0] = 0;
    test::expect_reject_as(
      actor: "owner",
      kotoage: "swap_exact_in_base",
      arguments: Json::parse("{\"amount_in\":\"10\",\"min_out\":\"1\"}")
    );
  }

  #[test(fixture = "pool_actor")]
  fn no_quote_liquidity_rejects_without_moving_active_bin() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    ensure_bin_indexed(-200_000);
    ensure_bin_indexed(200_000);
    BinReserveBase[-200_000] = 1000;
    BinReserveBase[200_000] = 1000;
    let active_before = ActiveBin;
    test::expect_reject_as(
      actor: "owner",
      kotoage: "swap_exact_in_base",
      arguments: Json::parse("{\"amount_in\":\"10\",\"min_out\":\"1\"}")
    );
    test::assert(ActiveBin == active_before);
  }
}
