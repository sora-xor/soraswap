  #[test(fixture = "pool_actor")]
  fn launchpad_quantity2_call_is_pinned_to_executor_and_initialization_bin() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    ActiveBin = 9;
    let minted = test::invoke_kotoage_as(
      actor: "public_trader",
      kotoage: "seed_launchpad_liquidity",
      arguments: Json::parse("{\"amount_in\":\"3\",\"min_out\":\"4\"}")
    );
    let position = launchpad_position_id();
    test::assert(minted == 7);
    test::assert(position_owner_value(position) == launchpad_executor_account());
    test::assert(position_bin_value(position) == 0);
    test::assert(InitializationBin == 0);
    test::assert(ActiveBin == 9);
  }

