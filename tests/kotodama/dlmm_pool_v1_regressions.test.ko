  #[test(fixture = "pool_actor")]
  fn base_swap_accrues_collectable_fee_growth() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"lp\",\"bin_id\":\"0\",\"base_amount\":\"10000\",\"quote_amount\":\"10000\"}")
    );
    let output = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "swap_exact_in_base",
      arguments: Json::parse("{\"amount_in\":\"1000\",\"min_out\":\"990\"}")
    );
    test::assert(output == 997);
    let pending = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "quote_position_fees",
      arguments: Json::parse("{\"position_id\":\"lp\"}")
    );
    test::assert(pending.0 > zero_quantity());
    test::assert(pending.1 == zero_quantity());
  }

  #[test(fixture = "pool_actor")]
  fn exact_quote_swap_is_caller_funded_and_requires_full_fill() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"public-liquidity\",\"bin_id\":\"0\",\"base_amount\":\"10000\",\"quote_amount\":\"10000\"}")
    );
    let public_trader = AccountId::parse(
      "sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV"
    );
    let quote_before = ledger::asset::balance(public_trader, quote_asset());
    let base_before = ledger::asset::balance(public_trader, base_asset());
    let vault_quote_before = ledger::asset::balance(owner_account(), quote_asset());
    let vault_base_before = ledger::asset::balance(owner_account(), base_asset());
    let output = test::invoke_kotoage_as(
      actor: "public_trader",
      kotoage: "swap_exact_in_quote",
      arguments: Json::parse("{\"amount_in\":\"1000\",\"min_out\":\"990\"}")
    );
    test::assert(output == 997);
    test::assert(
      ledger::asset::balance(public_trader, quote_asset()) + 1000 == quote_before
    );
    test::assert(
      ledger::asset::balance(public_trader, base_asset()) == base_before + output
    );
    test::assert(
      ledger::asset::balance(owner_account(), quote_asset()) == vault_quote_before + 1000
    );
    test::assert(
      ledger::asset::balance(owner_account(), base_asset()) + output == vault_base_before
    );
  }

  #[test(fixture = "pool_actor")]
  fn exact_quote_swap_rejects_a_partial_fill_atomically() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"public-small\",\"bin_id\":\"0\",\"base_amount\":\"10\",\"quote_amount\":\"1\"}")
    );
    let base_before = bin_reserve_base_value(0);
    let quote_before = bin_reserve_quote_value(0);
    let public_trader = AccountId::parse(
      "sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV"
    );
    let trader_quote_before = ledger::asset::balance(public_trader, quote_asset());
    let trader_base_before = ledger::asset::balance(public_trader, base_asset());
    let vault_quote_before = ledger::asset::balance(owner_account(), quote_asset());
    let vault_base_before = ledger::asset::balance(owner_account(), base_asset());
    test::expect_reject_as(
      actor: "public_trader",
      kotoage: "swap_exact_in_quote",
      arguments: Json::parse("{\"amount_in\":\"1000\",\"min_out\":\"1\"}")
    );
    test::assert(bin_reserve_base_value(0) == base_before);
    test::assert(bin_reserve_quote_value(0) == quote_before);
    test::assert(
      ledger::asset::balance(public_trader, quote_asset()) == trader_quote_before
    );
    test::assert(
      ledger::asset::balance(public_trader, base_asset()) == trader_base_before
    );
    test::assert(
      ledger::asset::balance(owner_account(), quote_asset()) == vault_quote_before
    );
    test::assert(
      ledger::asset::balance(owner_account(), base_asset()) == vault_base_before
    );
  }

  #[test(fixture = "pool_actor")]
  fn admin_renunciation_is_irreversible_and_disables_governor() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    arm_range_governor_for_renounce_test();
    renounce_admin_impl();
    test::assert_eq(actual: AdminRenounced, expected: 1);
    test::assert_eq(actual: RangeGovernorEnabled, expected: 0);
    test::assert_eq(actual: RangeGovernorNextSlot, expected: 0);
    test::expect_reject_as(
      actor: "owner",
      kotoage: "configure_range_governor",
      arguments: Json::parse("{\"cadence_slots\":\"1\",\"max_fee_pips\":\"3000\",\"target_active_bin\":\"0\",\"max_active_bin_drift\":\"0\",\"enabled\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "renounce_admin",
      arguments: Json::parse("{}")
    );
  }

  #[test(fixture = "pool_actor")]
  fn slippage_rejection_rolls_back_reserves_and_fee_growth() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"rollback\",\"bin_id\":\"0\",\"base_amount\":\"10000\",\"quote_amount\":\"10000\"}")
    );
    let base_before = bin_reserve_base_value(0);
    let quote_before = bin_reserve_quote_value(0);
    let growth_before = bin_fee_growth_base_value(0);
    test::expect_reject_as(
      actor: "owner",
      kotoage: "swap_exact_in_base",
      arguments: Json::parse("{\"amount_in\":\"1000\",\"min_out\":\"998\"}")
    );
    test::assert(bin_reserve_base_value(0) == base_before);
    test::assert(bin_reserve_quote_value(0) == quote_before);
    test::assert(bin_fee_growth_base_value(0) == growth_before);
  }

  #[test(fixture = "pool_actor")]
  fn full_fill_rejection_rolls_back_partial_multi_bin_execution() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    test::invoke_kotoage_as(
