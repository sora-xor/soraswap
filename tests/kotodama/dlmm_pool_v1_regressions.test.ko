      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"vault_account\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\",\"launchpad_executor\":\"sorauﾛ1PﾉｳﾇmEｴWｵebHﾑ6ﾔﾙｲヰiwuCWErJ7uｽoPGｱﾔnjﾑKﾋTCW2PV\",\"fee_pips\":\"3000\",\"bin_step\":\"1\",\"active_bin\":\"0\",\"impact_cap_bps\":\"10000\",\"min_reserve_base\":\"0\",\"min_reserve_quote\":\"0\",\"max_bins_per_swap\":\"32\",\"bin_liquidity_cap\":\"0\"}")
    );
  }

