  #[test(fixture = "pool_actor")]
  fn out_of_order_bins_form_a_strict_sorted_index() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    ensure_bin_indexed(100_000);
    ensure_bin_indexed(-100_000);
    ensure_bin_indexed(7);
    ensure_bin_indexed(0);

    test::assert(IndexedBinCount == 4);
    test::assert(FirstIndexedBin == -100_000);
    test::assert(LastIndexedBin == 100_000);
    test::assert(NextIndexedBin.get(-100_000).unwrap_or(-100_000) == 0);
    test::assert(NextIndexedBin.get(0).unwrap_or(0) == 7);
    test::assert(NextIndexedBin.get(7).unwrap_or(7) == 100_000);
    test::assert(PreviousIndexedBin.get(100_000).unwrap_or(100_000) == 7);
  }

  #[test(fixture = "pool_actor")]
  fn bin_index_hard_cap_rejects_sixty_fifth_bin() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    // The cap guard precedes all index traversal and writes. Seeding the
    // authoritative count exercises that boundary without exhausting the
    // standalone test VM on 64 full StateMap insertions.
    IndexedBinCount = 64;
    test::assert(IndexedBinCount == 64);
    test::expect_reject_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"overflow\",\"bin_id\":\"64\",\"base_amount\":\"1\",\"quote_amount\":\"1\"}")
    );
  }

  #[test(fixture = "pool_actor")]
  fn seeding_creates_owned_redeemable_shares() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: standard_hajimari_arguments()
    );
    let minted = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "seed_bin",
      arguments: Json::parse("{\"position_id\":\"bootstrap\",\"bin_id\":\"0\",\"base_amount\":\"1000\",\"quote_amount\":\"1000\"}")
    );
    let position = Name::parse("bootstrap");
    test::assert(minted == 2000);
    test::assert(position_owner_value(position) == owner_account());
    test::assert(position_shares_value(position) == minted);
    test::assert(bin_share_supply_value(0) == minted);
  }

