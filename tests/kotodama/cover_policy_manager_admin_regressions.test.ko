module CoverPolicyManagerAdminRegressions {
koto_test { target: "../../contracts/cover/policy_manager.ko" }

fixture cover_manager_actors {
  actor(
    "owner",
    AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX")
  );
}

fn seed_cover_manager(AccountId owner) {
  CoverInitialized = 1;
  CoverOwner = owner;
  CoverOracleStaleSlots = 4;
  CoverAutomationBacklogCap = 3;
  CoverNextPolicyId = 2;
}

#[test(fixture="cover_manager_actors")]
fn cover_oracle_stale_slots_are_owner_configured() {
  let owner = test::actor_account("owner");
  seed_cover_manager(owner);

  test::invoke_kotoage_as(actor: "owner", kotoage: "configure_oracle_stale_slots", arguments: Json::parse("{\"stale_slots\":\"120\"}"));

  test::assert(CoverOracleStaleSlots == 120);
  test::expect_reject_as(actor: "owner", kotoage: "configure_oracle_stale_slots", arguments: Json::parse("{\"stale_slots\":\"-1\"}"));
}

#[test(fixture="cover_manager_actors")]
fn cover_heartbeat_updates_local_safety_state() {
  let owner = test::actor_account("owner");
  seed_cover_manager(owner);

  test::invoke_kotoage_as(actor: "owner", kotoage: "heartbeat", arguments: Json::parse("{\"current_backlog\":\"2\",\"safe_mode\":\"1\"}"));

  test::assert(CoverAutomationBacklog == 2);
  test::assert(CoverAutomationSafeMode == 1);
  test::expect_reject_as(actor: "owner", kotoage: "heartbeat", arguments: Json::parse("{\"current_backlog\":\"4\",\"safe_mode\":\"0\"}"));
}
}
