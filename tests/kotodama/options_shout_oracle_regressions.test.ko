koto_test { target: "../../contracts/options/shout_option.ko" }

fixture shout_actors {
  actor("owner", AccountId::parse("ed0120AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"));
}

fn seed_shout_product(AccountId owner) {
  ShoutInitialized = 1;
  ShoutOwner = owner;
  ShoutController = owner;
  ShoutWithdrawalOnly = 0;
  ShoutOracleStaleSlots = 4;
  ShoutPositionOwner[1] = owner;
  ShoutPositionSeriesId[1] = 1;
  ShoutPositionNotional[1] = 100;
  ShoutPositionStrikeBps[1] = 10_000;
  ShoutPositionShoutFloor[1] = 0;
  ShoutPositionLastOracleMark[1] = 0;
  ShoutPositionLastOracleSlot[1] = 0;
  ShoutPositionLastAttestationHash[1] = 0;
  ShoutPositionPayout[1] = 0;
  ShoutPositionStatus[1] = 1;
}

#[test(fixture="shout_actors")]
fn shout_oracle_stale_slots_are_owner_configured() {
  let owner = actor_account("owner");
  seed_shout_product(owner);

  invoke_entrypoint_as("owner", "configure_oracle_stale_slots", json("{\"oracle_stale_slots\":8}"));

  assert(ShoutOracleStaleSlots == 8, "shout stale slots");
  expect_reject_as("owner", "configure_oracle_stale_slots", json("{\"oracle_stale_slots\":-1}"));
}

#[test(fixture="shout_actors")]
fn shout_c2c_oracle_values_reject_negative_slots() {
  let owner = actor_account("owner");
  seed_shout_product(owner);

  expect_reject_as("owner", "record_shout_c2c", json("{\"position_id\":1,\"mark_price_bps\":10000,\"oracle_slot\":-1,\"attestation_hash\":1}"));
  invoke_entrypoint_as("owner", "record_shout_c2c", json("{\"position_id\":1,\"mark_price_bps\":10100,\"oracle_slot\":0,\"attestation_hash\":1}"));

  assert(ShoutPositionLastOracleMark[1] == 10_100, "recorded mark");
}
