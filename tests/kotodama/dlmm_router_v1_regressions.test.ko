module DlmmRouterV1Regressions {
  koto_test { target: "../../contracts/dlmm/dlmm_router.ko" }

  fixture router_actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    actor(
      "guardian",
      AccountId::parse("sorauﾛ1PﾈﾈｲPｹﾙﾄﾒﾜｻヱﾉBﾅQUﾅｹcDﾂPbﾂｵsyZﾘｻﾉcﾂYDｼﾇヱRW66MF")
    );
    grant_permission("owner", "Admin");
    grant_permission("owner", "AssetOps");
    grant_permission("guardian", "Admin");
    grant_permission("guardian", "AssetOps");
  }

  fn router_hajimari_arguments() -> Json {
    return Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"6pEP9RjNoZ7beWkT3pLfKoM1dyfi\",\"default_fee_pips\":\"3000\",\"pool_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PﾈﾈｲPｹﾙﾄﾒﾜｻヱﾉBﾅQUﾅｹcDﾂPbﾂｵsyZﾘｻﾉcﾂYDｼﾇヱRW66MF\"}");
  }

  #[test(fixture = "router_actors")]
  fn lifecycle_is_immutable_and_starts_paused() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    test::assert(RouterInitialized == 1);
    test::assert(RouterPaused == 1);
    test::assert(RouterOwner == test::actor_account("owner"));
    test::assert(RouterContractAccount != test::actor_account("owner"));
    test::assert(SwapHistoryHead == 0);
  }

  #[test(fixture = "router_actors")]
  fn identical_assets_are_rejected_before_state_initialization() {
    test::expect_reject_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: Json::parse("{\"base_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"quote_asset\":\"62Fk4FPcMuLvW5QjDGNF2a4jAmjM\",\"default_fee_pips\":\"3000\",\"pool_contract\":\"0x01\",\"guardian\":\"sorauﾛ1PﾈﾈｲPｹﾙﾄﾒﾜｻヱﾉBﾅQUﾅｹcDﾂPbﾂｵsyZﾘｻﾉcﾂYDｼﾇヱRW66MF\"}")
    );
  }

  #[test(fixture = "router_actors")]
  fn guardian_can_pause_but_cannot_resume() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::invoke_kotoage_as(
      actor: "guardian",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"1\"}")
    );
    test::expect_reject_as(
      actor: "guardian",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::assert(RouterPaused == 1);
  }

  #[test(fixture = "router_actors")]
  fn paused_swap_rejects_before_staging_or_history() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "route_swap",
      arguments: Json::parse("{\"amount_in\":\"1\",\"input_is_base\":\"1\",\"min_out\":\"0\"}")
    );
    test::assert(SwapHistoryHead == 0);
  }

  #[test(fixture = "router_actors")]
  fn invalid_direction_rejects_before_staging_or_nested_call() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "set_paused",
      arguments: Json::parse("{\"paused\":\"0\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "route_swap",
      arguments: Json::parse("{\"amount_in\":\"1\",\"input_is_base\":\"2\",\"min_out\":\"0\"}")
    );
    test::assert(SwapHistoryHead == 0);
  }

  #[test(fixture = "router_actors")]
  fn direct_quote_uses_quantity_ratio_without_integer_product_overflow() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    let output = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "quote_direct",
      arguments: Json::parse("{\"reserve_in\":\"10000\",\"reserve_out\":\"10000\",\"amount_in\":\"1000\",\"fee_pips\":\"3000\"}")
    );
    test::assert(output > 900);
    test::assert(output < 1000);
  }

  #[test(fixture = "router_actors")]
  fn bin_quote_caps_output_at_available_reserve() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    let output = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "quote_bin",
      arguments: Json::parse("{\"reserve_base\":\"100\",\"reserve_quote\":\"100\",\"amount_in\":\"1000\",\"fee_pips\":\"0\",\"bin_id\":\"0\",\"bin_step\":\"1\",\"input_is_base\":\"1\",\"min_reserve_base\":\"10\",\"min_reserve_quote\":\"25\"}")
    );
    test::assert(output == 75);
  }

  #[test(fixture = "router_actors")]
  fn invalid_reserve_floor_is_rejected() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "hajimari",
      arguments: router_hajimari_arguments()
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "quote_bin",
      arguments: Json::parse("{\"reserve_base\":\"100\",\"reserve_quote\":\"10\",\"amount_in\":\"1\",\"fee_pips\":\"0\",\"bin_id\":\"0\",\"bin_step\":\"1\",\"input_is_base\":\"1\",\"min_reserve_base\":\"0\",\"min_reserve_quote\":\"11\"}")
    );
  }
}
