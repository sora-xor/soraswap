seiyaku PreludeSmoke {
  error enum PreludeSmokeError {
    AuthorityMismatch = 1,
    Underflow = 2,
    InvalidBasisPoints = 3,
  }

  fixture actors {
    actor(
      "owner",
      AccountId::parse("sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX"),
      "0x0909090909090909090909090909090909090909090909090909090909090909"
    );
    actor(
      "attacker",
      AccountId::parse("sorauﾛ1PﾈﾈｲPｹﾙﾄﾒﾜｻヱﾉBﾅQUﾅｹcDﾂPbﾂｵsyZﾘｻﾉcﾂYDｼﾇヱRW66MF")
    );
    grant_permission("owner", "Entry");
    grant_permission("attacker", "Entry");
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn basis_point_fee(quantity amount, int basis_points) -> quantity {
    require(basis_points >= 0, PreludeSmokeError::InvalidBasisPoints);
    require(basis_points <= 10_000, PreludeSmokeError::InvalidBasisPoints);
    let decimal scale = 10_000;
    let rate = decimal::from_int(value: basis_points) / scale;
    return amount * rate;
  }

  fn checked_sub(quantity left, quantity right) -> quantity {
    require(left >= right, PreludeSmokeError::Underflow);
    return left - right;
  }

  kotoage fn require_authority_payload(
    AccountId expected
  ) -> int authorize("Entry") {
    require(context::authority() == expected, PreludeSmokeError::AuthorityMismatch);
    return 1;
  }

  kotoage fn checked_sub_probe(
    quantity left,
    quantity right
  ) -> quantity authorize("Entry") {
    return checked_sub(left: left, right: right);
  }

  kotoage fn basis_point_fee_probe(
    quantity amount,
    int basis_points
  ) -> quantity authorize("Entry") {
    return basis_point_fee(amount: amount, basis_points: basis_points);
  }

  view fn current_block_height() -> int {
    return context::block_height();
  }

  #[test]
  fn first_release_quantity_and_decimal_helpers_are_exact() {
    let quantity principal = 10_000;
    let quantity adjustment = 10;
    let fee = basis_point_fee(amount: principal, basis_points: 25);
    test::assert(fee == 25);
    test::assert(checked_sub(left: fee + adjustment, right: 5) == 30);
    test::assert(zero_quantity() == 0);
  }

  #[test(fixture = "actors")]
  fn first_release_quantity_underflow_rejects() {
    test::expect_reject_as(
      actor: "owner",
      kotoage: "checked_sub_probe",
      arguments: Json::parse("{\"left\":\"1\",\"right\":\"2\"}")
    );
  }

  #[test(fixture = "actors")]
  fn first_release_basis_points_are_bounded() {
    test::expect_reject_as(
      actor: "owner",
      kotoage: "basis_point_fee_probe",
      arguments: Json::parse("{\"amount\":\"100\",\"basis_points\":\"-1\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "basis_point_fee_probe",
      arguments: Json::parse("{\"amount\":\"100\",\"basis_points\":\"10001\"}")
    );
  }

  #[test(fixture = "actors")]
  fn first_release_authority_checks_use_actor_context() {
    test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "require_authority_payload",
      arguments: Json::parse("{\"expected\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\"}")
    );
    test::expect_reject_as(
      actor: "attacker",
      kotoage: "require_authority_payload",
      arguments: Json::parse("{\"expected\":\"sorauﾛ1QEnRヰ7Dﾑzmg1ﾊｻ4ﾈAcckｻsafiｳヱufｴｻｻPﾆｴﾖﾁﾉDR1Y5PX\"}")
    );
    test::expect_reject_as(
      actor: "owner",
      kotoage: "require_authority_payload",
      arguments: Json::parse("{\"expected\":\"sorauﾛ1PﾈﾈｲPｹﾙﾄﾒﾜｻヱﾉBﾅQUﾅｹcDﾂPbﾂｵsyZﾘｻﾉcﾂYDｼﾇヱRW66MF\"}")
    );
  }

  #[test(fixture = "actors")]
  fn first_release_context_view_uses_test_runtime() {
    let height = test::invoke_kotoage_as(
      actor: "owner",
      kotoage: "current_block_height",
      arguments: Json::parse("{}")
    );
    test::assert(height == 0);
  }
}
