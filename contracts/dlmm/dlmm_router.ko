// Production router for one xor#universal-anchored DLMM pool.
//
// The router is initialized once with its immutable pool address and contract
// subject account. It stages user input in that subject account and performs a
// schema-bound nested call; a rejected pool call rolls the entire transaction
// back, including the staging transfer and history write.

seiyaku DlmmRouter {
  error enum DlmmRouterError {
    IdenticalAssets = 1,
    InvalidFeePips = 2,
    InvalidAmount = 3,
    InvalidMinOut = 4,
    InvalidDirection = 5,
    InvalidBinStep = 6,
    InvalidBinId = 7,
    InvalidReserve = 8,
    RouterAccountIsOwner = 9,
    RouterOwnerMismatch = 10,
    RouterGuardianMismatch = 11,
    RouterPaused = 12,
    InvalidPaused = 13,
    SwapHistoryMissing = 14,
    UnexpectedDefaultFee = 15,
  }

  state int RouterInitialized;
  state AccountId RouterOwner;
  state AccountId RouterGuardian;
  state int RouterPaused;
  state AssetDefinitionId BaseAsset;
  state AssetDefinitionId QuoteAsset;
  state int DefaultFeePips;
  state AccountId RouterContractAccount;
  state bytes PoolContract;

  state int SwapHistoryHead;
  state StateMap<int, AccountId> SwapHistoryTrader;
  state StateMap<int, int> SwapHistoryInputIsBase;
  state StateMap<int, quantity> SwapHistoryAmountIn;
  state StateMap<int, quantity> SwapHistoryAmountOut;
  state StateMap<int, quantity> SwapHistoryMinOut;
  state StateMap<int, int> SwapHistorySlot;

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn assert_owner() {
    require(RouterOwner == context::authority(), DlmmRouterError::RouterOwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if RouterOwner == context::authority() {
      return;
    }
    require(
      RouterGuardian == context::authority(),
      DlmmRouterError::RouterGuardianMismatch
    );
  }

  fn assert_not_paused() {
    require(RouterPaused == 0, DlmmRouterError::RouterPaused);
  }

  fn assert_valid_fee(int fee_pips) {
    require(fee_pips >= 0, DlmmRouterError::InvalidFeePips);
    require(fee_pips < 1_000_000, DlmmRouterError::InvalidFeePips);
  }

  fn assert_valid_bin(int bin_id, int bin_step) {
    require(bin_step > 0, DlmmRouterError::InvalidBinStep);
    require(bin_step <= 100_000, DlmmRouterError::InvalidBinStep);
    require(bin_id >= -200_000, DlmmRouterError::InvalidBinId);
    require(bin_id <= 200_000, DlmmRouterError::InvalidBinId);
  }

  fn abs_int(int value) -> int {
    if value < 0 {
      return 0 - value;
    }
    return value;
  }

  fn fee_multiplier(int fee_pips) -> decimal {
    assert_valid_fee(fee_pips);
    let decimal scale = 1_000_000;
    return (scale - decimal::from_int(value: fee_pips)) / scale;
  }

  fn bin_price(int bin_id, int bin_step) -> decimal {
    assert_valid_bin(bin_id: bin_id, bin_step: bin_step);
    let decimal scale = 1_000_000;
    let offset = decimal::from_int(value: abs_int(bin_id) * bin_step);
    if bin_id >= 0 {
      return (scale + offset) / scale;
    }
    return scale.div_round(
      divisor: scale + offset,
      scale: 28,
      mode: Rounding::floor
    );
  }

  fn record_swap_history(
    AccountId trader,
    int input_is_base,
    quantity amount_in,
    quantity amount_out,
    quantity min_out
  ) {
    let record_id = SwapHistoryHead + 1;
    SwapHistoryHead = record_id;
    SwapHistoryTrader[record_id] = trader;
    SwapHistoryInputIsBase[record_id] = input_is_base;
    SwapHistoryAmountIn[record_id] = amount_in;
    SwapHistoryAmountOut[record_id] = amount_out;
    SwapHistoryMinOut[record_id] = min_out;
    SwapHistorySlot[record_id] = context::block_height();
  }

  hajimari(
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    int default_fee_pips,
    bytes pool_contract,
    AccountId guardian
  ) {
    require(base_asset != quote_asset, DlmmRouterError::IdenticalAssets);
    assert_valid_fee(default_fee_pips);

    RouterInitialized = 1;
    RouterOwner = context::authority();
    RouterGuardian = guardian;
    RouterPaused = 1;
    BaseAsset = base_asset;
    QuoteAsset = quote_asset;
    DefaultFeePips = default_fee_pips;
    RouterContractAccount = context::seiyaku_subject();
    PoolContract = pool_contract;
    SwapHistoryHead = 0;
  }

  view fn main() -> int {
    return RouterInitialized;
  }

  kotoage fn set_paused(int paused) authorize("Admin") {
    require(paused == 0 || paused == 1, DlmmRouterError::InvalidPaused);
    if paused == 1 {
      assert_owner_or_guardian();
    } else {
      assert_owner();
    }
    RouterPaused = paused;
  }

  view fn assert_router_config(int default_fee_pips) -> int {
    require(DefaultFeePips == default_fee_pips, DlmmRouterError::UnexpectedDefaultFee);
    return DefaultFeePips;
  }

  view fn router_config() -> (AssetDefinitionId, AssetDefinitionId, int, AccountId, bytes, int) {
    return (
      BaseAsset,
      QuoteAsset,
      DefaultFeePips,
      RouterContractAccount,
      PoolContract,
      RouterPaused
    );
  }

  view fn router_assets() -> (AssetDefinitionId, AssetDefinitionId) {
    return (BaseAsset, QuoteAsset);
  }

  view fn mirror_state() -> (int, int, int) {
    return (RouterInitialized, DefaultFeePips, RouterPaused);
  }

  view fn execution_binding() -> int {
    return 1;
  }

  view fn contract_binding() -> int {
    return 1;
  }

  view fn swap_history_head() -> int {
    return SwapHistoryHead;
  }

  view fn mirror_swap_history(
    int record_id
  ) -> (AccountId, int, quantity, quantity, quantity, int) {
    require(SwapHistoryTrader.contains(record_id), DlmmRouterError::SwapHistoryMissing);
    return (
      SwapHistoryTrader.get(record_id).unwrap_or(RouterOwner),
      SwapHistoryInputIsBase.get(record_id).unwrap_or(0),
      SwapHistoryAmountIn.get(record_id).unwrap_or(zero_quantity()),
      SwapHistoryAmountOut.get(record_id).unwrap_or(zero_quantity()),
      SwapHistoryMinOut.get(record_id).unwrap_or(zero_quantity()),
      SwapHistorySlot.get(record_id).unwrap_or(0)
    );
  }

  view fn quote_direct(
    quantity reserve_in,
    quantity reserve_out,
    quantity amount_in,
    int fee_pips
  ) -> quantity {
    require(reserve_in > zero_quantity(), DlmmRouterError::InvalidReserve);
    require(reserve_out > zero_quantity(), DlmmRouterError::InvalidReserve);
    require(amount_in > zero_quantity(), DlmmRouterError::InvalidAmount);
    let effective = amount_in * fee_multiplier(fee_pips);
    if effective == zero_quantity() {
      return zero_quantity();
    }
    let ratio = effective.ratio_round(
      divisor: reserve_in + effective,
      scale: 28,
      mode: Rounding::floor
    );
    return reserve_out * ratio;
  }

  view fn quote_bin(
    quantity reserve_base,
    quantity reserve_quote,
    quantity amount_in,
    int fee_pips,
    int bin_id,
    int bin_step,
    int input_is_base,
    quantity min_reserve_base,
    quantity min_reserve_quote
  ) -> quantity {
    require(reserve_base >= min_reserve_base, DlmmRouterError::InvalidReserve);
    require(reserve_quote >= min_reserve_quote, DlmmRouterError::InvalidReserve);
    require(amount_in > zero_quantity(), DlmmRouterError::InvalidAmount);
    let effective = amount_in * fee_multiplier(fee_pips);
    let price = bin_price(bin_id: bin_id, bin_step: bin_step);
    if input_is_base == 1 {
      let available_quote = reserve_quote - min_reserve_quote;
      let candidate = effective * price;
      if candidate <= available_quote {
        return candidate;
      }
      return available_quote;
    }
    require(input_is_base == 0, DlmmRouterError::InvalidDirection);
    let available_base = reserve_base - min_reserve_base;
    let candidate = effective.div_round(
      divisor: price,
      scale: 28,
      mode: Rounding::floor
    );
    if candidate <= available_base {
      return candidate;
    }
    return available_base;
  }

  view fn select_best_quote(quantity direct_out, quantity via_base_out) -> quantity {
    if direct_out >= via_base_out {
      return direct_out;
    }
    return via_base_out;
  }

  fn route_swap_impl(
    quantity amount_in,
    int input_is_base,
    quantity min_out
  ) -> quantity {
    assert_not_paused();
    require(amount_in > zero_quantity(), DlmmRouterError::InvalidAmount);
    let trader = context::authority();

    if input_is_base == 1 {
      ledger::asset::transfer(
        source: trader,
        destination: RouterContractAccount,
        asset_definition: BaseAsset,
        amount: amount_in,
        dataspace: universal_dataspace()
      );
      let amount_out = contract::invoke(
        contract: PoolContract,
        entrypoint: "swap_exact_in_base",
        returns: "quantity",
        amount_in: amount_in,
        min_out: min_out
      );
      ledger::asset::transfer(
        source: RouterContractAccount,
        destination: trader,
        asset_definition: QuoteAsset,
        amount: amount_out,
        dataspace: universal_dataspace()
      );
      record_swap_history(
        trader: trader,
        input_is_base: input_is_base,
        amount_in: amount_in,
        amount_out: amount_out,
        min_out: min_out
      );
      return amount_out;
    }

    require(input_is_base == 0, DlmmRouterError::InvalidDirection);
    ledger::asset::transfer(
      source: trader,
      destination: RouterContractAccount,
      asset_definition: QuoteAsset,
      amount: amount_in,
      dataspace: universal_dataspace()
    );
    let amount_out = contract::invoke(
      contract: PoolContract,
      entrypoint: "swap_exact_in_quote",
      returns: "quantity",
      amount_in: amount_in,
      min_out: min_out
    );
    ledger::asset::transfer(
      source: RouterContractAccount,
      destination: trader,
      asset_definition: BaseAsset,
      amount: amount_out,
      dataspace: universal_dataspace()
    );
    record_swap_history(
      trader: trader,
      input_is_base: input_is_base,
      amount_in: amount_in,
      amount_out: amount_out,
      min_out: min_out
    );
    return amount_out;
  }

  // Unified direct-user surface. Contract callers use the two exact typed
  // entrypoints below so every nested call is bound to Iroha's Quantity2 ABI.
  kotoage fn route_swap(
    quantity amount_in,
    int input_is_base,
    quantity min_out
  ) -> quantity authorize("AssetOps") {
    return route_swap_impl(
      amount_in: amount_in,
      input_is_base: input_is_base,
      min_out: min_out
    );
  }

  kotoage fn route_exact_in_base(
    quantity amount_in,
    quantity min_out
  ) -> quantity authorize("AssetOps") {
    return route_swap_impl(amount_in: amount_in, input_is_base: 1, min_out: min_out);
  }

  kotoage fn route_exact_in_quote(
    quantity amount_in,
    quantity min_out
  ) -> quantity authorize("AssetOps") {
    return route_swap_impl(amount_in: amount_in, input_is_base: 0, min_out: min_out);
  }
}
