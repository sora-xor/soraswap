// Router quote helpers for xor#universal anchored paths.

seiyaku DlmmRouter {
  state int RouterInitialized;
  state AccountId RouterOwner;
  state AssetDefinitionId BaseAsset;
  state AssetDefinitionId QuoteAsset;
  state int DefaultFeePips;
  state AccountId RouterContractId;
  state int RouterContractBound;
  state bytes BoundPoolContract;
  state int PoolBound;
  state int SwapHistoryHead;
  state SwapHistoryTrader: Map<int, AccountId>;
  state SwapHistoryInputIsBase: Map<int, int>;
  state SwapHistoryAmountIn: Map<int, int>;
  state SwapHistoryAmountOut: Map<int, int>;
  state SwapHistoryMinOut: Map<int, int>;

  fn ppm_scale() -> int {
    return 1_000_000;
  }

  fn assert_valid_fee(fee_pips: int) {
    assert(fee_pips >= 0, "negative fee_pips");
    assert(fee_pips < ppm_scale(), "fee_pips too large");
  }

  fn assert_valid_bin_step(bin_step: int) {
    assert(bin_step > 0, "invalid bin_step");
    assert(bin_step <= 100_000, "bin_step too large");
  }

  fn abs_int(value: int) -> int {
    if value < 0 {
      return 0 - value;
    }
    return value;
  }

  fn assert_owner() {
    assert(RouterOwner == authority(), "router owner mismatch");
  }

  fn assert_pool_bound() {
    assert(PoolBound == 1, "pool not bound");
  }

  fn assert_contract_bound() {
    assert(RouterContractBound == 1, "router contract unbound");
  }

  fn record_swap_history(trader: AccountId,
                         input_is_base: int,
                         amount_in: int,
                         amount_out: int,
                         min_out: int) {
    let record_id = SwapHistoryHead + 1;
    SwapHistoryHead = record_id;
    SwapHistoryTrader[record_id] = trader;
    SwapHistoryInputIsBase[record_id] = input_is_base;
    SwapHistoryAmountIn[record_id] = amount_in;
    SwapHistoryAmountOut[record_id] = amount_out;
    SwapHistoryMinOut[record_id] = min_out;
  }

  #[access(read="*", write="*")]
  kotoage fn main() -> int {
    if RouterInitialized == 1 {
      return DefaultFeePips;
    }
    return 0;
  }

  #[access(read="*", write="*")]
  kotoage fn init_router(base_asset: AssetDefinitionId, default_fee_pips: int) {
    assert(RouterInitialized == 0, "router initialized");
    assert_valid_fee(default_fee_pips);
    RouterInitialized = 1;
    RouterOwner = authority();
    BaseAsset = base_asset;
    QuoteAsset = base_asset;
    DefaultFeePips = default_fee_pips;
    RouterContractId = authority();
    RouterContractBound = 0;
    BoundPoolContract = blob("");
    PoolBound = 0;
    SwapHistoryHead = 0;
    info("dlmm_router_initialized");
  }

  #[access(read="*", write="*")]
  kotoage fn bind_contract(contract_id: AccountId) {
    assert(RouterInitialized == 1, "router not initialized");
    assert_owner();
    RouterContractId = contract_id;
    RouterContractBound = 1;
  }

  #[access(read="*", write="*")]
  kotoage fn bind_pool(pool_contract: bytes, quote_asset: AssetDefinitionId) {
    assert(RouterInitialized == 1, "router not initialized");
    assert_owner();
    BoundPoolContract = pool_contract;
    QuoteAsset = quote_asset;
    PoolBound = 1;
  }

  view fn assert_router_config(default_fee_pips: int) -> int {
    assert(RouterInitialized == 1, "router not initialized");
    assert(DefaultFeePips == default_fee_pips, "unexpected default fee");
    return DefaultFeePips;
  }

  view fn router_config() -> (AssetDefinitionId, int) {
    assert(RouterInitialized == 1, "router not initialized");
    return (BaseAsset, DefaultFeePips);
  }

  view fn router_assets() -> (AssetDefinitionId, AssetDefinitionId) {
    assert(RouterInitialized == 1, "router not initialized");
    return (BaseAsset, QuoteAsset);
  }

  view fn mirror_state() -> (int, int) {
    assert(RouterInitialized == 1, "router not initialized");
    return (RouterInitialized, DefaultFeePips);
  }

  view fn swap_history_head() -> int {
    assert(RouterInitialized == 1, "router not initialized");
    return SwapHistoryHead;
  }

  view fn mirror_swap_history(record_id: int) -> (AccountId, int, int, int, int) {
    assert(RouterInitialized == 1, "router not initialized");
    assert(SwapHistoryTrader.contains(record_id), "swap history missing");
    return (
      SwapHistoryTrader[record_id],
      SwapHistoryInputIsBase.get_or(record_id, 0),
      SwapHistoryAmountIn.get_or(record_id, 0),
      SwapHistoryAmountOut.get_or(record_id, 0),
      SwapHistoryMinOut.get_or(record_id, 0)
    );
  }

  view fn execution_binding() -> int {
    assert(RouterInitialized == 1, "router not initialized");
    return PoolBound;
  }

  view fn contract_binding() -> int {
    assert(RouterInitialized == 1, "router not initialized");
    return RouterContractBound;
  }

  view fn quote_direct(reserve_in: int,
                       reserve_out: int,
                       amount_in: int,
                       fee_pips: int) -> int {
    return quote_direct_impl(reserve_in, reserve_out, amount_in, fee_pips);
  }

  fn quote_direct_impl(reserve_in: int,
                       reserve_out: int,
                       amount_in: int,
                       fee_pips: int) -> int {
    let effective = (amount_in * (ppm_scale() - fee_pips)) / ppm_scale();
    if effective <= 0 {
      return 0;
    }
    return (reserve_out * effective) / (reserve_in + effective);
  }

  fn bin_price_ppm(bin_id: int, bin_step: int) -> int {
    let scale = ppm_scale();
    assert_valid_bin_step(bin_step);

    if bin_id >= 0 {
      return scale + (bin_id * bin_step);
    }

    let denominator = scale + (abs_int(bin_id) * bin_step);
    let price = (scale * scale) / denominator;
    assert(price > 0, "bin price underflow");
    return price;
  }

  view fn quote_bin(reserve_base: int,
                    reserve_quote: int,
                    amount_in: int,
                    fee_pips: int,
                    bin_id: int,
                    bin_step: int,
                    input_is_base: int,
                    min_reserve_base: int,
                    min_reserve_quote: int) -> int {
    return quote_bin_impl(
      reserve_base,
      reserve_quote,
      amount_in,
      fee_pips,
      bin_id,
      bin_step,
      input_is_base,
      min_reserve_base,
      min_reserve_quote
    );
  }

  fn quote_bin_impl(reserve_base: int,
                    reserve_quote: int,
                    amount_in: int,
                    fee_pips: int,
                    bin_id: int,
                    bin_step: int,
                    input_is_base: int,
                    min_reserve_base: int,
                    min_reserve_quote: int) -> int {
    let scale = ppm_scale();
    let effective = (amount_in * (scale - fee_pips)) / scale;
    let price = bin_price_ppm(bin_id, bin_step);
    if effective <= 0 {
      return 0;
    }

    if input_is_base == 1 {
      let available_quote = reserve_quote - min_reserve_quote;
      if available_quote <= 0 {
        return 0;
      }
      let out = (effective * price) / scale;
      if out > available_quote {
        return available_quote;
      }
      return out;
    }

    assert(input_is_base == 0, "invalid direction");
    let available_base = reserve_base - min_reserve_base;
    if available_base <= 0 {
      return 0;
    }
    let out = (effective * scale) / price;
    if out > available_base {
      return available_base;
    }
    return out;
  }

  view fn select_best_quote(direct_out: int, via_base_out: int) -> int {
    return select_best_quote_impl(direct_out, via_base_out);
  }

  fn select_best_quote_impl(direct_out: int, via_base_out: int) -> int {
    if direct_out >= via_base_out {
      return direct_out;
    }
    return via_base_out;
  }

  #[access(read="*", write="*")]
  kotoage fn route_swap(amount_in: int,
                        input_is_base: int,
                        min_out: int) -> int permission(AssetOps) {
    let trader = authority();
    let payload = json_object();
    let payload = json_set_int(payload, name("amount_in"), amount_in);
    let payload = json_set_int(payload, name("min_out"), min_out);
    let payload = json_set_account_id(payload, name("recipient"), trader);
    assert(RouterInitialized == 1, "router not initialized");
    assert_contract_bound();
    assert_pool_bound();
    assert(amount_in > 0, "invalid amount");
    assert(min_out >= 0, "invalid min_out");

    if input_is_base == 1 {
      transfer_asset(trader, RouterContractId, BaseAsset, amount_in);
      let amount_out = decode_int(call_contract(BoundPoolContract, "swap_exact_in_base_for", payload));
      record_swap_history(trader, input_is_base, amount_in, amount_out, min_out);
      return amount_out;
    }

    assert(input_is_base == 0, "invalid direction");
    transfer_asset(trader, RouterContractId, QuoteAsset, amount_in);
    let amount_out = decode_int(call_contract(BoundPoolContract, "swap_exact_in_quote_for", payload));
    record_swap_history(trader, input_is_base, amount_in, amount_out, min_out);
    return amount_out;
  }
}
