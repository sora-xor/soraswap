// Renamed basket hub derived from the earlier T3 design.
// This contract is not the DEX base asset. The deployable DEX base remains
// xor#universal.

seiyaku N3xHub {
  error enum N3xHubError {
    EmptyHub = 1141175724,
    HubInitialized = 2935749696,
    HubNotInitialized = 621750500,
    HubOwnerMismatch = 1277682305,
    InsufficientSupply = 161969588,
    InvalidFee = 2782992421,
    InvalidKusdTarget = 3388377488,
    InvalidN3xAmount = 293191821,
    InvalidTargetSum = 3148869386,
    InvalidUsdcTarget = 1027685671,
    InvalidUsdtTarget = 765996556,
    NegativeKusdIn = 2227533790,
    NegativeUsdcIn = 377637138,
    NegativeUsdtIn = 1700176276,
    NoFees = 1414078325,
    ZeroMint = 2904226724,
    ZeroRedemption = 151701980,
  }

  state int HubInitialized;
  state AccountId HubOwner;
  state AssetDefinitionId UsdtAsset;
  state AssetDefinitionId UsdcAsset;
  state AssetDefinitionId KusdAsset;
  state AssetDefinitionId N3xAsset;
  state AccountId VaultAccount;
  state quantity BasketUsdt;
  state quantity BasketUsdc;
  state quantity BasketKusd;
  state quantity TotalN3x;
  state int MintFeeBps;
  state int RedeemFeeBps;
  state quantity MintFeesAccrued;
  state quantity RedeemFeesAccrued;
  state quantity FeeReserveUsdt;
  state quantity FeeReserveUsdc;
  state quantity FeeReserveKusd;
  state int TargetUsdtBps;
  state int TargetUsdcBps;
  state int TargetKusdBps;

  fn universal_dataspace() -> DataSpaceId {
    let dsid = DataSpaceId::parse("0");
    return dsid;
  }

  fn validate_fee_bps(int fee_bps) {
    require(fee_bps >= 0, N3xHubError::InvalidFee);
    require(fee_bps < 10_000, N3xHubError::InvalidFee);
  }

  fn validate_targets(int usdt_bps, int usdc_bps, int kusd_bps) {
    require(usdt_bps >= 0, N3xHubError::InvalidUsdtTarget);
    require(usdc_bps >= 0, N3xHubError::InvalidUsdcTarget);
    require(kusd_bps >= 0, N3xHubError::InvalidKusdTarget);
    require(usdt_bps + usdc_bps + kusd_bps == 10_000, N3xHubError::InvalidTargetSum);
  }

  fn fee_amount(quantity amount, int fee_bps) -> quantity {
    let rate = decimal::from_int(value: fee_bps);
    return (amount * rate) / 10_000;
  }

  fn assert_initialized_impl() {
    require(HubInitialized == 1, N3xHubError::HubNotInitialized);
  }

  fn assert_owner() {
    require(HubOwner == context::authority(), N3xHubError::HubOwnerMismatch);
  }

  fn init_owner() -> AccountId {
    return context::authority();
  }

  fn quote_mint_impl(quantity usdt_in, quantity usdc_in, quantity kusd_in) -> quantity {
    require(usdt_in >= 0, N3xHubError::NegativeUsdtIn);
    require(usdc_in >= 0, N3xHubError::NegativeUsdcIn);
    require(kusd_in >= 0, N3xHubError::NegativeKusdIn);
    let gross = usdt_in + usdc_in + kusd_in;
    let usdt_fee = fee_amount(amount: usdt_in, fee_bps: MintFeeBps);
    let usdc_fee = fee_amount(amount: usdc_in, fee_bps: MintFeeBps);
    let kusd_fee = fee_amount(amount: kusd_in, fee_bps: MintFeeBps);
    return gross - usdt_fee - usdc_fee - kusd_fee;
  }

  fn quote_redeem_impl(quantity n3x_amount) -> quantity {
    assert_initialized_impl();
    let total = TotalN3x;
    require(total > 0, N3xHubError::EmptyHub);
    require(n3x_amount > 0, N3xHubError::InvalidN3xAmount);
    require(n3x_amount <= total, N3xHubError::InsufficientSupply);
    let share = n3x_amount.ratio_round(
      divisor: total,
      scale: 28,
      mode: Rounding::floor,
    );
    let gross_usdt = BasketUsdt * share;
    let gross_usdc = BasketUsdc * share;
    let gross_kusd = BasketKusd * share;
    let usdt_out = gross_usdt - fee_amount(amount: gross_usdt, fee_bps: RedeemFeeBps);
    let usdc_out = gross_usdc - fee_amount(amount: gross_usdc, fee_bps: RedeemFeeBps);
    let kusd_out = gross_kusd - fee_amount(amount: gross_kusd, fee_bps: RedeemFeeBps);
    return usdt_out + usdc_out + kusd_out;
  }

  view fn main() -> quantity {
    if HubInitialized == 1 {
      return TotalN3x;
    }
    return 0;
  }

  hajimari(AssetDefinitionId usdt_asset,
           AssetDefinitionId usdc_asset,
           AssetDefinitionId kusd_asset,
           AssetDefinitionId n3x_asset,
           AccountId vault_account,
           int target_usdt_bps,
           int target_usdc_bps,
           int target_kusd_bps,
           int mint_fee_bps,
           int redeem_fee_bps) {
    validate_targets(
      usdt_bps: target_usdt_bps,
      usdc_bps: target_usdc_bps,
      kusd_bps: target_kusd_bps,
    );
    validate_fee_bps(mint_fee_bps);
    validate_fee_bps(redeem_fee_bps);

    HubOwner = init_owner();
    UsdtAsset = usdt_asset;
    UsdcAsset = usdc_asset;
    KusdAsset = kusd_asset;
    N3xAsset = n3x_asset;
    VaultAccount = vault_account;
    BasketUsdt = 0;
    BasketUsdc = 0;
    BasketKusd = 0;
    TotalN3x = 0;
    MintFeeBps = mint_fee_bps;
    RedeemFeeBps = redeem_fee_bps;
    MintFeesAccrued = 0;
    RedeemFeesAccrued = 0;
    FeeReserveUsdt = 0;
    FeeReserveUsdc = 0;
    FeeReserveKusd = 0;
    TargetUsdtBps = target_usdt_bps;
    TargetUsdcBps = target_usdc_bps;
    TargetKusdBps = target_kusd_bps;
    HubInitialized = 1;
  }

  view fn quote_mint(quantity usdt_in, quantity usdc_in, quantity kusd_in) -> quantity {
    return quote_mint_impl(usdt_in: usdt_in, usdc_in: usdc_in, kusd_in: kusd_in);
  }

  view fn quote_redeem(quantity n3x_amount) -> quantity {
    return quote_redeem_impl(n3x_amount);
  }

  view fn assert_initialized() -> quantity {
    assert_initialized_impl();
    return TotalN3x;
  }

  view fn hub_config() -> (AssetDefinitionId, AssetDefinitionId, AssetDefinitionId, AssetDefinitionId, AccountId, int, int, int, int, int) {
    assert_initialized_impl();
    return (
      UsdtAsset,
      UsdcAsset,
      KusdAsset,
      N3xAsset,
      VaultAccount,
      MintFeeBps,
      RedeemFeeBps,
      TargetUsdtBps,
      TargetUsdcBps,
      TargetKusdBps
    );
  }

  kotoage fn bind_vault_account(AccountId vault_account) authorize("Admin") {
    assert_initialized_impl();
    assert_owner();
    VaultAccount = vault_account;
  }

  view fn mirror_state() -> (int, quantity, quantity, quantity, quantity, int, int, quantity, quantity, int, int, int) {
    assert_initialized_impl();
    return (
      HubInitialized,
      BasketUsdt,
      BasketUsdc,
      BasketKusd,
      TotalN3x,
      MintFeeBps,
      RedeemFeeBps,
      MintFeesAccrued,
      RedeemFeesAccrued,
      TargetUsdtBps,
      TargetUsdcBps,
      TargetKusdBps
    );
  }

  view fn fee_reserve_state() -> (quantity, quantity, quantity, quantity, quantity) {
    assert_initialized_impl();
    return (
      FeeReserveUsdt,
      FeeReserveUsdc,
      FeeReserveKusd,
      MintFeesAccrued,
      RedeemFeesAccrued
    );
  }

  kotoage fn deposit_and_mint(quantity usdt_in,
                              quantity usdc_in,
                              quantity kusd_in) -> quantity authorize("AssetOps") {
    assert_initialized_impl();
    let user = context::authority();
    let gross = usdt_in + usdc_in + kusd_in;
    let minted = quote_mint_impl(usdt_in: usdt_in, usdc_in: usdc_in, kusd_in: kusd_in);
    let usdt_fee = fee_amount(amount: usdt_in, fee_bps: MintFeeBps);
    let usdc_fee = fee_amount(amount: usdc_in, fee_bps: MintFeeBps);
    let kusd_fee = fee_amount(amount: kusd_in, fee_bps: MintFeeBps);
    let fee = usdt_fee + usdc_fee + kusd_fee;
    let net_usdt = usdt_in - usdt_fee;
    let net_usdc = usdc_in - usdc_fee;
    let net_kusd = kusd_in - kusd_fee;
    require(minted > 0, N3xHubError::ZeroMint);

    if usdt_in > 0 {
      if user != VaultAccount {
        ledger::asset::transfer(source: user, destination: VaultAccount, asset_definition: UsdtAsset, amount: usdt_in, dataspace: universal_dataspace());
      }
    }
    if usdc_in > 0 {
      if user != VaultAccount {
        ledger::asset::transfer(source: user, destination: VaultAccount, asset_definition: UsdcAsset, amount: usdc_in, dataspace: universal_dataspace());
      }
    }
    if kusd_in > 0 {
      if user != VaultAccount {
        ledger::asset::transfer(source: user, destination: VaultAccount, asset_definition: KusdAsset, amount: kusd_in, dataspace: universal_dataspace());
      }
    }
    ledger::asset::mint(account: user, asset_definition: N3xAsset, amount: minted);

    BasketUsdt = BasketUsdt + net_usdt;
    BasketUsdc = BasketUsdc + net_usdc;
    BasketKusd = BasketKusd + net_kusd;
    FeeReserveUsdt = FeeReserveUsdt + usdt_fee;
    FeeReserveUsdc = FeeReserveUsdc + usdc_fee;
    FeeReserveKusd = FeeReserveKusd + kusd_fee;
    TotalN3x = TotalN3x + minted;
    MintFeesAccrued = MintFeesAccrued + fee;
    return minted;
  }

  kotoage fn burn_and_redeem(quantity n3x_amount) -> quantity authorize("AssetOps") {
    assert_initialized_impl();
    let user = context::authority();
    let total = TotalN3x;
    require(total > 0, N3xHubError::EmptyHub);
    require(n3x_amount > 0, N3xHubError::InvalidN3xAmount);
    require(n3x_amount <= total, N3xHubError::InsufficientSupply);

    let share = n3x_amount.ratio_round(
      divisor: total,
      scale: 28,
      mode: Rounding::floor,
    );
    let gross_usdt = BasketUsdt * share;
    let gross_usdc = BasketUsdc * share;
    let gross_kusd = BasketKusd * share;
    let usdt_fee = fee_amount(amount: gross_usdt, fee_bps: RedeemFeeBps);
    let usdc_fee = fee_amount(amount: gross_usdc, fee_bps: RedeemFeeBps);
    let kusd_fee = fee_amount(amount: gross_kusd, fee_bps: RedeemFeeBps);
    let usdt_out = gross_usdt - usdt_fee;
    let usdc_out = gross_usdc - usdc_fee;
    let kusd_out = gross_kusd - kusd_fee;
    let redeemed = usdt_out + usdc_out + kusd_out;
    require(redeemed > 0, N3xHubError::ZeroRedemption);

    ledger::asset::burn(account: user, asset_definition: N3xAsset, amount: n3x_amount);
    if usdt_out > 0 {
      if VaultAccount != user {
        ledger::asset::transfer(source: VaultAccount, destination: user, asset_definition: UsdtAsset, amount: usdt_out, dataspace: universal_dataspace());
      }
    }
    if usdc_out > 0 {
      if VaultAccount != user {
        ledger::asset::transfer(source: VaultAccount, destination: user, asset_definition: UsdcAsset, amount: usdc_out, dataspace: universal_dataspace());
      }
    }
    if kusd_out > 0 {
      if VaultAccount != user {
        ledger::asset::transfer(source: VaultAccount, destination: user, asset_definition: KusdAsset, amount: kusd_out, dataspace: universal_dataspace());
      }
    }

    BasketUsdt = BasketUsdt - gross_usdt;
    BasketUsdc = BasketUsdc - gross_usdc;
    BasketKusd = BasketKusd - gross_kusd;
    FeeReserveUsdt = FeeReserveUsdt + usdt_fee;
    FeeReserveUsdc = FeeReserveUsdc + usdc_fee;
    FeeReserveKusd = FeeReserveKusd + kusd_fee;
    RedeemFeesAccrued = RedeemFeesAccrued + usdt_fee + usdc_fee + kusd_fee;
    TotalN3x = total - n3x_amount;
    return redeemed;
  }

  kotoage fn claim_fees(AccountId recipient) -> quantity authorize("AssetOps") {
    assert_initialized_impl();
    assert_owner();
    let usdt_amount = FeeReserveUsdt;
    let usdc_amount = FeeReserveUsdc;
    let kusd_amount = FeeReserveKusd;
    let total_claimed = usdt_amount + usdc_amount + kusd_amount;
    require(total_claimed > 0, N3xHubError::NoFees);

    FeeReserveUsdt = 0;
    FeeReserveUsdc = 0;
    FeeReserveKusd = 0;
    if usdt_amount > 0 {
      if VaultAccount != recipient {
        ledger::asset::transfer(source: VaultAccount, destination: recipient, asset_definition: UsdtAsset, amount: usdt_amount, dataspace: universal_dataspace());
      }
    }
    if usdc_amount > 0 {
      if VaultAccount != recipient {
        ledger::asset::transfer(source: VaultAccount, destination: recipient, asset_definition: UsdcAsset, amount: usdc_amount, dataspace: universal_dataspace());
      }
    }
    if kusd_amount > 0 {
      if VaultAccount != recipient {
        ledger::asset::transfer(source: VaultAccount, destination: recipient, asset_definition: KusdAsset, amount: kusd_amount, dataspace: universal_dataspace());
      }
    }
    return total_claimed;
  }
}
