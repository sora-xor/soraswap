// Self-contained parametric cover manager.
//
// The current Kotodama ABI does not provide arbitrary cross-contract calls or
// source-level decoding of signed JSON. Cover therefore keeps its own fully
// backed reserve and accepts typed observations only from the configured oracle
// account. The oracle transaction signature binds every typed argument.

seiyaku PolicyManager {
  error enum PolicyManagerError {
    OwnerMismatch = 1,
    GuardianMismatch = 2,
    WithdrawalOnly = 3,
    AutomationUnsafe = 4,
    InvalidBounds = 5,
    InvalidPayout = 6,
    InvalidNotional = 7,
    InvalidPremium = 8,
    InvalidMonitoringWindow = 9,
    InvalidRequiredObservations = 10,
    OracleAuthorityMismatch = 11,
    InvalidOracleStaleSlots = 12,
    InvalidOracleSlot = 13,
    InvalidObservedPrice = 14,
    InvalidStatusFlags = 15,
    MissingAttestation = 16,
    OracleSlotReplay = 17,
    PolicyExists = 18,
    PolicyMissing = 19,
    PolicyOwnerMismatch = 20,
    PolicyNotActive = 21,
    PolicyNotClaimable = 22,
    PolicyAlreadyClaimed = 23,
    PolicyLive = 24,
    PolicyLimit = 25,
    InvalidJobId = 26,
    InvalidCadence = 27,
    InvalidBacklogCap = 28,
    InvalidBacklog = 29,
    InvalidSafeMode = 30,
    InvalidMaxItems = 31,
    InvalidEnabled = 32,
    InsufficientReserve = 33,
    IndexCorrupt = 34,
    InvalidAuthoritySeparation = 35,
    OracleStale = 36,
    ReserveInvariant = 37,
  }

  state int CoverInitialized;
  state AccountId CoverOwner;
  state AccountId CoverGuardian;
  state AccountId CoverAccount;
  state AssetDefinitionId CoverSettlementAsset;
  state int CoverWithdrawalOnly;
  state AccountId CoverOracleAuthority;
  state int CoverDefaultRequiredObservations;
  state int CoverOracleStaleSlots;
  state quantity CoverReservedPayout;
  state quantity CoverPremiumCollected;
  state quantity CoverSettledPayouts;

  state AccountId CoverAutomationExecutor;
  state int CoverObservationJobId;
  state int CoverAutomationCadence;
  state int CoverAutomationBacklogCap;
  state int CoverAutomationBacklog;
  state int CoverAutomationSafeMode;

  state int CoverLifecycleCadenceSlots;
  state int CoverLifecycleMaxItems;
  state int CoverLifecycleEnabled;
  state int CoverLifecycleNextSlot;
  state int CoverLifecycleCursor;
  state int CoverLifecycleLastSlot;
  state int CoverLifecycleLastProcessed;
  state int CoverNextPolicyId;

  state StateMap<int, AccountId> CoverPolicyOwner;
  state StateMap<int, decimal> CoverPolicyLowerBound;
  state StateMap<int, decimal> CoverPolicyUpperBound;
  state StateMap<int, quantity> CoverPolicyPayoutAmount;
  state StateMap<int, int> CoverPolicyMonitoringWindowSlots;
  state StateMap<int, int> CoverPolicyRequiredObservations;
  state StateMap<int, quantity> CoverPolicyCoveredNotional;
  state StateMap<int, quantity> CoverPolicyPremiumPaid;
  state StateMap<int, int> CoverPolicyStatus;
  state StateMap<int, int> CoverPolicyRegistrationSlot;
  state StateMap<int, int> CoverPolicyBreachStartSlot;
  state StateMap<int, int> CoverPolicyBreachElapsedSlots;
  state StateMap<int, int> CoverPolicyObservationCount;
  state StateMap<int, int> CoverPolicyLastOracleSlot;
  state StateMap<int, decimal> CoverPolicyLastObservedPrice;
  state StateMap<int, int> CoverPolicyLastAttestationHash;
  state StateMap<int, quantity> CoverPolicyClaimPayout;

  trigger soraswap_cover_lifecycle_tick -> native_lifecycle_tick {
    on time schedule(0, 120000);
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "cover.policy_manager"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn zero_decimal() -> decimal {
    let decimal zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn assert_owner() {
    require(CoverOwner == context::authority(), PolicyManagerError::OwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if CoverOwner == context::authority() {
      return;
    }
    require(CoverGuardian == context::authority(), PolicyManagerError::GuardianMismatch);
  }

  fn assert_oracle_authority() {
    require(
      CoverOracleAuthority == context::authority(),
      PolicyManagerError::OracleAuthorityMismatch
    );
  }

  fn assert_risk_on() {
    require(CoverWithdrawalOnly == 0, PolicyManagerError::WithdrawalOnly);
    require(CoverAutomationSafeMode == 0, PolicyManagerError::AutomationUnsafe);
    require(
      CoverAutomationBacklog <= CoverAutomationBacklogCap,
      PolicyManagerError::AutomationUnsafe
    );
  }

  fn assert_policy_exists(int policy_id) {
    require(CoverPolicyOwner.contains(policy_id), PolicyManagerError::PolicyMissing);
  }

  fn assert_policy_owner(int policy_id) {
    assert_policy_exists(policy_id: policy_id);
    require(
      CoverPolicyOwner.get(policy_id).unwrap_or(CoverOwner) == context::authority(),
      PolicyManagerError::PolicyOwnerMismatch
    );
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: CoverSettlementAsset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn cover_balance() -> quantity {
    return ledger::asset::balance(
      account: CoverAccount,
      asset_definition: CoverSettlementAsset
    );
  }

  fn reserve_after_premium(quantity premium) -> quantity {
    let current_balance = cover_balance();
    if context::authority() == CoverAccount {
      return current_balance;
    }
    return current_balance + premium;
  }

  fn release_policy_reserve(int policy_id) {
    let payout = CoverPolicyPayoutAmount.get(policy_id).unwrap_or(zero_quantity());
    require(
      CoverReservedPayout >= payout,
      PolicyManagerError::ReserveInvariant
    );
    CoverReservedPayout = CoverReservedPayout - payout;
  }

  fn assert_reserve_backed() {
    require(
      cover_balance() >= CoverReservedPayout,
      PolicyManagerError::InsufficientReserve
    );
  }

  fn reset_breach(int policy_id) {
    CoverPolicyStatus[policy_id] = 1;
    CoverPolicyBreachStartSlot[policy_id] = 0;
    CoverPolicyBreachElapsedSlots[policy_id] = 0;
    CoverPolicyObservationCount[policy_id] = 0;
  }

  fn apply_oracle_observation(
    int policy_id,
    decimal observed_price,
    int oracle_slot,
    int status_flags,
    int attestation_hash
  ) {
    assert_oracle_authority();
    assert_policy_exists(policy_id: policy_id);
    require(CoverPolicyStatus.get(policy_id).unwrap_or(0) == 1, PolicyManagerError::PolicyNotActive);
    require(CoverAutomationSafeMode == 0, PolicyManagerError::AutomationUnsafe);
    require(observed_price >= zero_decimal(), PolicyManagerError::InvalidObservedPrice);
    require(status_flags == 0, PolicyManagerError::InvalidStatusFlags);
    require(attestation_hash > 0, PolicyManagerError::MissingAttestation);
    let current_slot = context::block_height();
    require(oracle_slot >= 0 && current_slot >= oracle_slot, PolicyManagerError::InvalidOracleSlot);
    require(current_slot - oracle_slot <= CoverOracleStaleSlots, PolicyManagerError::OracleStale);
    let prior_slot = CoverPolicyLastOracleSlot.get(policy_id).unwrap_or(-1);
    require(oracle_slot > prior_slot, PolicyManagerError::OracleSlotReplay);
    let breached = observed_price < CoverPolicyLowerBound.get(policy_id).unwrap_or(zero_decimal()) ||
      observed_price > CoverPolicyUpperBound.get(policy_id).unwrap_or(zero_decimal());
    if breached {
      if prior_slot < 0 || oracle_slot - prior_slot > CoverOracleStaleSlots ||
        CoverPolicyObservationCount.get(policy_id).unwrap_or(0) == 0 {
        CoverPolicyBreachStartSlot[policy_id] = oracle_slot;
        CoverPolicyBreachElapsedSlots[policy_id] = 0;
        CoverPolicyObservationCount[policy_id] = 1;
      } else {
        CoverPolicyBreachElapsedSlots[policy_id] =
          CoverPolicyBreachElapsedSlots.get(policy_id).unwrap_or(0) + (oracle_slot - prior_slot);
        CoverPolicyObservationCount[policy_id] =
          CoverPolicyObservationCount.get(policy_id).unwrap_or(0) + 1;
      }
      if CoverPolicyBreachElapsedSlots.get(policy_id).unwrap_or(0) >=
          CoverPolicyMonitoringWindowSlots.get(policy_id).unwrap_or(0) &&
        CoverPolicyObservationCount.get(policy_id).unwrap_or(0) >=
          CoverPolicyRequiredObservations.get(policy_id).unwrap_or(0) {
        CoverPolicyStatus[policy_id] = 2;
      }
    } else {
      reset_breach(policy_id: policy_id);
    }
    CoverPolicyLastOracleSlot[policy_id] = oracle_slot;
    CoverPolicyLastObservedPrice[policy_id] = observed_price;
    CoverPolicyLastAttestationHash[policy_id] = attestation_hash;
  }

  fn expire_policy_impl(int policy_id) {
    assert_policy_exists(policy_id: policy_id);
    require(CoverPolicyStatus.get(policy_id).unwrap_or(0) == 1, PolicyManagerError::PolicyNotActive);
    let expiry = CoverPolicyRegistrationSlot.get(policy_id).unwrap_or(0) +
      CoverPolicyMonitoringWindowSlots.get(policy_id).unwrap_or(0);
    require(context::block_height() >= expiry, PolicyManagerError::PolicyLive);
    release_policy_reserve(policy_id: policy_id);
    CoverPolicyStatus[policy_id] = 4;
  }

  hajimari(
    AssetDefinitionId settlement_asset,
    AccountId cover_account,
    AccountId guardian,
    AccountId oracle_authority,
    int default_required_observations,
    int oracle_stale_slots
  ) {
    require(cover_account != context::authority(), PolicyManagerError::InvalidAuthoritySeparation);
    require(guardian != context::authority() && guardian != cover_account, PolicyManagerError::InvalidAuthoritySeparation);
    require(
      oracle_authority != context::authority() &&
      oracle_authority != guardian &&
      oracle_authority != cover_account,
      PolicyManagerError::InvalidAuthoritySeparation
    );
    require(default_required_observations > 0, PolicyManagerError::InvalidRequiredObservations);
    require(oracle_stale_slots >= 0, PolicyManagerError::InvalidOracleStaleSlots);
    CoverInitialized = 1;
    CoverOwner = context::authority();
    CoverGuardian = guardian;
    CoverAccount = cover_account;
    CoverSettlementAsset = settlement_asset;
    CoverWithdrawalOnly = 1;
    CoverOracleAuthority = oracle_authority;
    CoverDefaultRequiredObservations = default_required_observations;
    CoverOracleStaleSlots = oracle_stale_slots;
    CoverReservedPayout = zero_quantity();
    CoverPremiumCollected = zero_quantity();
    CoverSettledPayouts = zero_quantity();
    CoverAutomationExecutor = context::authority();
    CoverObservationJobId = 0;
    CoverAutomationCadence = 0;
    CoverAutomationBacklogCap = 0;
    CoverAutomationBacklog = 0;
    CoverAutomationSafeMode = 0;
    CoverLifecycleCadenceSlots = 1;
    CoverLifecycleMaxItems = 1;
    CoverLifecycleEnabled = 0;
    CoverLifecycleNextSlot = 0;
    CoverLifecycleCursor = 1;
    CoverLifecycleLastSlot = 0;
    CoverLifecycleLastProcessed = 0;
    CoverNextPolicyId = 1;
  }

  view fn main() -> int {
    return CoverInitialized;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    CoverWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    CoverWithdrawalOnly = 0;
  }

  kotoage fn configure_oracle_authority(AccountId oracle_authority) authorize("Admin") {
    assert_owner();
    require(
      oracle_authority != CoverOwner &&
      oracle_authority != CoverGuardian &&
      oracle_authority != CoverAccount,
      PolicyManagerError::InvalidAuthoritySeparation
    );
    CoverOracleAuthority = oracle_authority;
  }

  kotoage fn configure_oracle_stale_slots(int stale_slots) authorize("Admin") {
    assert_owner();
    require(stale_slots >= 0, PolicyManagerError::InvalidOracleStaleSlots);
    CoverOracleStaleSlots = stale_slots;
  }

  kotoage fn sync_automation(
    AccountId executor,
    int job_id,
    int cadence_slots,
    int backlog_cap,
    int safe_mode
  ) authorize("Admin") {
    assert_owner();
    require(job_id >= 0, PolicyManagerError::InvalidJobId);
    require(cadence_slots >= 0, PolicyManagerError::InvalidCadence);
    require(backlog_cap >= 0, PolicyManagerError::InvalidBacklogCap);
    require(safe_mode == 0 || safe_mode == 1, PolicyManagerError::InvalidSafeMode);
    require(CoverAutomationBacklog <= backlog_cap, PolicyManagerError::InvalidBacklog);
    CoverAutomationExecutor = executor;
    CoverObservationJobId = job_id;
    CoverAutomationCadence = cadence_slots;
    CoverAutomationBacklogCap = backlog_cap;
    CoverAutomationSafeMode = safe_mode;
  }

  kotoage fn heartbeat(int current_backlog, int safe_mode) authorize("Entry") {
    require(
      context::authority() == CoverOwner || context::authority() == CoverAutomationExecutor,
      PolicyManagerError::OwnerMismatch
    );
    require(current_backlog >= 0 && current_backlog <= CoverAutomationBacklogCap, PolicyManagerError::InvalidBacklog);
    require(safe_mode == 0 || safe_mode == 1, PolicyManagerError::InvalidSafeMode);
    CoverAutomationBacklog = current_backlog;
    CoverAutomationSafeMode = safe_mode;
  }

  kotoage fn configure_trigger_lifecycle(
    int cadence_slots,
    int max_items_per_tick,
    int enabled
  ) authorize("AssetOps") {
    assert_owner();
    require(cadence_slots > 0, PolicyManagerError::InvalidCadence);
    require(max_items_per_tick > 0 && max_items_per_tick <= 64, PolicyManagerError::InvalidMaxItems);
    require(enabled == 0 || enabled == 1, PolicyManagerError::InvalidEnabled);
    CoverLifecycleCadenceSlots = cadence_slots;
    CoverLifecycleMaxItems = max_items_per_tick;
    CoverLifecycleEnabled = enabled;
    CoverLifecycleNextSlot = context::block_height() + cadence_slots;
    ledger::trigger::set_enabled(Name::parse("soraswap_cover_lifecycle_tick"), enabled);
  }

  kotoage fn fund_reserve(quantity amount) authorize("AssetOps") {
    require(amount > zero_quantity(), PolicyManagerError::InvalidPayout);
    move_asset_if_needed(
      source: context::authority(),
      destination: CoverAccount,
      amount: amount
    );
  }

  kotoage fn withdraw_surplus(
    AccountId recipient,
    quantity amount
  ) authorize("AssetOps") {
    assert_owner();
    require(amount > zero_quantity(), PolicyManagerError::InvalidPayout);
    require(
      cover_balance() >= CoverReservedPayout + amount,
      PolicyManagerError::InsufficientReserve
    );
    move_asset_if_needed(
      source: CoverAccount,
      destination: recipient,
      amount: amount
    );
  }

  kotoage fn register_policy(
    decimal lower_bound,
    decimal upper_bound,
    quantity payout_amount,
    int monitoring_window_slots,
    int required_observations,
    quantity covered_notional,
    quantity premium_paid
  ) -> int authorize("AssetOps") {
    assert_risk_on();
    require(lower_bound >= zero_decimal() && upper_bound > lower_bound, PolicyManagerError::InvalidBounds);
    require(payout_amount > zero_quantity(), PolicyManagerError::InvalidPayout);
    require(covered_notional > zero_quantity(), PolicyManagerError::InvalidNotional);
    require(premium_paid > zero_quantity(), PolicyManagerError::InvalidPremium);
    require(monitoring_window_slots > 0, PolicyManagerError::InvalidMonitoringWindow);
    require(required_observations > 0 && required_observations <= 64, PolicyManagerError::InvalidRequiredObservations);
    require(CoverNextPolicyId >= 1 && CoverNextPolicyId <= 64, PolicyManagerError::PolicyLimit);
    assert_reserve_backed();
    let next_reserved = CoverReservedPayout + payout_amount;
    require(
      reserve_after_premium(premium: premium_paid) >= next_reserved,
      PolicyManagerError::InsufficientReserve
    );
    let policy_id = CoverNextPolicyId;
    CoverNextPolicyId = policy_id + 1;
    move_asset_if_needed(
      source: context::authority(),
      destination: CoverAccount,
      amount: premium_paid
    );
    CoverReservedPayout = next_reserved;
    CoverPremiumCollected = CoverPremiumCollected + premium_paid;
    CoverPolicyOwner[policy_id] = context::authority();
    CoverPolicyLowerBound[policy_id] = lower_bound;
    CoverPolicyUpperBound[policy_id] = upper_bound;
    CoverPolicyPayoutAmount[policy_id] = payout_amount;
    CoverPolicyMonitoringWindowSlots[policy_id] = monitoring_window_slots;
    CoverPolicyRequiredObservations[policy_id] = required_observations;
    CoverPolicyCoveredNotional[policy_id] = covered_notional;
    CoverPolicyPremiumPaid[policy_id] = premium_paid;
    CoverPolicyStatus[policy_id] = 1;
    CoverPolicyRegistrationSlot[policy_id] = context::block_height();
    CoverPolicyBreachStartSlot[policy_id] = 0;
    CoverPolicyBreachElapsedSlots[policy_id] = 0;
    CoverPolicyObservationCount[policy_id] = 0;
    CoverPolicyLastOracleSlot[policy_id] = -1;
    CoverPolicyLastObservedPrice[policy_id] = zero_decimal();
    CoverPolicyLastAttestationHash[policy_id] = 0;
    CoverPolicyClaimPayout[policy_id] = zero_quantity();
    return policy_id;
  }

  kotoage fn record_observation(
    int policy_id,
    decimal observed_price,
    int oracle_slot,
    int status_flags,
    int attestation_hash
  ) authorize("Entry") {
    apply_oracle_observation(
      policy_id: policy_id,
      observed_price: observed_price,
      oracle_slot: oracle_slot,
      status_flags: status_flags,
      attestation_hash: attestation_hash
    );
  }

  kotoage fn route_claim(int policy_id) -> quantity authorize("AssetOps") {
    assert_policy_owner(policy_id: policy_id);
    require(CoverPolicyStatus.get(policy_id).unwrap_or(0) == 2, PolicyManagerError::PolicyNotClaimable);
    require(CoverPolicyClaimPayout.get(policy_id).unwrap_or(zero_quantity()) == zero_quantity(), PolicyManagerError::PolicyAlreadyClaimed);
    let payout = CoverPolicyPayoutAmount.get(policy_id).unwrap_or(zero_quantity());
    require(payout > zero_quantity(), PolicyManagerError::InvalidPayout);
    require(CoverReservedPayout >= payout, PolicyManagerError::ReserveInvariant);
    require(cover_balance() >= payout, PolicyManagerError::InsufficientReserve);
    move_asset_if_needed(
      source: CoverAccount,
      destination: context::authority(),
      amount: payout
    );
    release_policy_reserve(policy_id: policy_id);
    CoverSettledPayouts = CoverSettledPayouts + payout;
    CoverPolicyClaimPayout[policy_id] = payout;
    CoverPolicyStatus[policy_id] = 3;
    return payout;
  }

  kotoage fn expire_policy(int policy_id) authorize("Entry") {
    expire_policy_impl(policy_id: policy_id);
  }

  kotoage fn native_lifecycle_tick() authorize("AssetOps") {
    if CoverInitialized == 0 || CoverLifecycleEnabled == 0 {
      return;
    }
    let current_slot = context::block_height();
    if CoverLifecycleNextSlot > 0 && current_slot < CoverLifecycleNextSlot {
      return;
    }
    var processed = 0;
    var cursor = CoverLifecycleCursor;
    for _step in range(64) {
      if processed < CoverLifecycleMaxItems && CoverNextPolicyId > 1 {
        if cursor < 1 || cursor >= CoverNextPolicyId {
          cursor = 1;
        }
        require(CoverPolicyOwner.contains(cursor), PolicyManagerError::IndexCorrupt);
        if CoverPolicyStatus.get(cursor).unwrap_or(0) == 1 &&
          current_slot >= CoverPolicyRegistrationSlot.get(cursor).unwrap_or(0) +
            CoverPolicyMonitoringWindowSlots.get(cursor).unwrap_or(0) {
          release_policy_reserve(policy_id: cursor);
          CoverPolicyStatus[cursor] = 4;
        }
        cursor = cursor + 1;
        processed = processed + 1;
      }
    }
    if cursor >= CoverNextPolicyId {
      cursor = 1;
    }
    CoverLifecycleCursor = cursor;
    CoverLifecycleLastSlot = current_slot;
    CoverLifecycleLastProcessed = processed;
    CoverLifecycleNextSlot = current_slot + CoverLifecycleCadenceSlots;
  }

  view fn manager_config() -> (
    AssetDefinitionId,
    AccountId,
    AccountId,
    int,
    int,
    int,
    int,
    int,
    int
  ) {
    return (
      CoverSettlementAsset,
      CoverAccount,
      CoverOracleAuthority,
      CoverWithdrawalOnly,
      CoverDefaultRequiredObservations,
      CoverObservationJobId,
      CoverAutomationCadence,
      CoverAutomationBacklogCap,
      CoverOracleStaleSlots
    );
  }

  view fn reserve_state() -> (quantity, quantity, quantity, quantity, quantity) {
    let balance = cover_balance();
    var surplus = zero_quantity();
    if balance > CoverReservedPayout {
      surplus = balance - CoverReservedPayout;
    }
    return (
      balance,
      CoverReservedPayout,
      surplus,
      CoverPremiumCollected,
      CoverSettledPayouts
    );
  }

  view fn policy_state(int policy_id) -> (
    int,
    decimal,
    decimal,
    quantity,
    int,
    int,
    quantity,
    quantity,
    int,
    int,
    int,
    quantity
  ) {
    let exists = CoverPolicyOwner.contains(policy_id) ? 1 : 0;
    return (
      exists,
      CoverPolicyLowerBound.get(policy_id).unwrap_or(zero_decimal()),
      CoverPolicyUpperBound.get(policy_id).unwrap_or(zero_decimal()),
      CoverPolicyPayoutAmount.get(policy_id).unwrap_or(zero_quantity()),
      CoverPolicyMonitoringWindowSlots.get(policy_id).unwrap_or(0),
      CoverPolicyRequiredObservations.get(policy_id).unwrap_or(0),
      CoverPolicyCoveredNotional.get(policy_id).unwrap_or(zero_quantity()),
      CoverPolicyPremiumPaid.get(policy_id).unwrap_or(zero_quantity()),
      CoverPolicyStatus.get(policy_id).unwrap_or(0),
      CoverPolicyBreachElapsedSlots.get(policy_id).unwrap_or(0),
      CoverPolicyObservationCount.get(policy_id).unwrap_or(0),
      CoverPolicyClaimPayout.get(policy_id).unwrap_or(zero_quantity())
    );
  }

  view fn policy_observation(int policy_id) -> (decimal, int, int, int) {
    assert_policy_exists(policy_id: policy_id);
    return (
      CoverPolicyLastObservedPrice.get(policy_id).unwrap_or(zero_decimal()),
      CoverPolicyLastOracleSlot.get(policy_id).unwrap_or(-1),
      CoverPolicyLastAttestationHash.get(policy_id).unwrap_or(0),
      CoverPolicyBreachStartSlot.get(policy_id).unwrap_or(0)
    );
  }

  view fn next_policy_id() -> int {
    return CoverNextPolicyId;
  }

  view fn automation_state() -> (int, int, int, int, int, int, int) {
    return (
      CoverInitialized,
      CoverObservationJobId,
      CoverAutomationCadence,
      CoverAutomationBacklogCap,
      CoverAutomationBacklog,
      CoverAutomationSafeMode,
      CoverWithdrawalOnly
    );
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      CoverLifecycleEnabled,
      CoverLifecycleCadenceSlots,
      CoverLifecycleMaxItems,
      CoverLifecycleNextSlot,
      CoverLifecycleCursor,
      CoverLifecycleLastSlot,
      CoverLifecycleLastProcessed
    );
  }
}
