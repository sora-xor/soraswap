seiyaku PolicyManager {
  state int CoverInitialized;
  state AccountId CoverOwner;
  state AssetDefinitionId CoverSettlementAsset;
  state bytes CoverRiskVaultContract;
  state int CoverContractBound;
  state AccountId CoverContractId;
  state int CoverWithdrawalOnly;
  state bytes CoverOraclePublicKey;
  state int CoverOracleScheme;
  state int CoverDefaultRequiredObservations;
  state int CoverOracleStaleSlots;

  state AccountId CoverAutomationExecutor;
  state int CoverObservationJobId;
  state int CoverAutomationCadence;
  state int CoverAutomationBacklogCap;
  state int CoverAutomationBacklog;
  state int CoverAutomationSafeMode;

  state int CoverLifecycleCadenceSlots;
  state int CoverLifecycleMaxItems;
  state int CoverLifecycleEnabled;
  state int CoverLifecycleNextSlot;
  state int CoverLifecycleCursor;
  state int CoverLifecycleLastSlot;
  state int CoverLifecycleLastProcessed;

  state int CoverNextPolicyId;

  state CoverPolicyOwner: Map<int, AccountId>;
  state CoverPolicyLowerBound: Map<int, int>;
  state CoverPolicyUpperBound: Map<int, int>;
  state CoverPolicyPayoutAmount: Map<int, int>;
  state CoverPolicyMonitoringWindowSlots: Map<int, int>;
  state CoverPolicyRequiredObservations: Map<int, int>;
  state CoverPolicyCoveredNotional: Map<int, int>;
  state CoverPolicyPremiumPaid: Map<int, int>;
  state CoverPolicyStatus: Map<int, int>;
  state CoverPolicyRegistrationSlot: Map<int, int>;
  state CoverPolicyBreachStartSlot: Map<int, int>;
  state CoverPolicyBreachElapsedSlots: Map<int, int>;
  state CoverPolicyObservationCount: Map<int, int>;
  state CoverPolicyLastObservationSlot: Map<int, int>;
  state CoverPolicyLastOracleSlot: Map<int, int>;
  state CoverPolicyLastObservedPrice: Map<int, int>;
  state CoverPolicyClaimPayout: Map<int, int>;
  state CoverPolicyClaimCount: Map<int, int>;

  register_trigger soraswap_cover_lifecycle_tick {
    call native_lifecycle_tick;
    on time pre_commit;
    repeats indefinitely;
    metadata { tag: "soraswap"; module: "cover.policy_manager"; __enabled: false; }
  }

  fn assert_initialized() {
    assert(CoverInitialized == 1, "cover manager not initialized");
  }

  fn assert_owner() {
    assert_initialized();
    assert(CoverOwner == authority(), "cover manager owner mismatch");
  }

  fn assert_contract_bound() {
    assert(CoverContractBound == 1, "cover contract unbound");
  }

  fn assert_policy_exists(policy_id: int) {
    assert(CoverPolicyOwner.contains(policy_id), "policy missing");
  }

  fn assert_policy_owner(policy_id: int) {
    assert_policy_exists(policy_id);
    assert(CoverPolicyOwner[policy_id] == authority(), "policy owner mismatch");
  }

  fn reset_breach(policy_id: int) {
    CoverPolicyStatus[policy_id] = 1;
    CoverPolicyBreachStartSlot[policy_id] = 0;
    CoverPolicyBreachElapsedSlots[policy_id] = 0;
    CoverPolicyObservationCount[policy_id] = 0;
  }

  fn cover_oracle_domain() -> int {
    return 4;
  }

  fn assert_verified_observation(policy_id: int,
                                 oracle_payload: bytes,
                                 oracle_signature: bytes) -> (int, int, int, int, int) {
    assert_policy_exists(policy_id);
    assert(CoverOracleScheme > 0, "oracle scheme missing");
    assert(verify_signature(oracle_payload, oracle_signature, CoverOraclePublicKey, CoverOracleScheme), "oracle signature");
    let payload = decode_json(oracle_payload);
    assert(payload.get_int(name("domain")) == cover_oracle_domain(), "oracle domain mismatch");
    assert(payload.get_int(name("policy_id")) == policy_id, "oracle policy mismatch");
    let observed_price = payload.get_int(name("observed_price"));
    let oracle_slot = payload.get_int(name("oracle_slot"));
    let status_flags = payload.get_int(name("status_flags"));
    let attestation_hash = payload.get_int(name("attestation_hash"));
    let current_slot = block_height();
    assert(observed_price >= 0, "invalid observed price");
    assert(attestation_hash > 0, "missing attestation");
    assert(current_slot >= oracle_slot, "invalid oracle slot");
    let prior_oracle_slot = CoverPolicyLastOracleSlot.get_or(policy_id, 0);
    if prior_oracle_slot > 0 {
      assert(oracle_slot > prior_oracle_slot, "oracle slot replay");
    }
    return (observed_price, oracle_slot, current_slot, status_flags, attestation_hash);
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  fn risk_vault_lock_liability(policy_id: int,
                               covered_notional: int,
                               payout_amount: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 3);
    let payload = json_set_int(payload, name("exposure_id"), policy_id);
    let payload = json_set_int(payload, name("notional"), covered_notional);
    let payload = json_set_int(payload, name("collateral_locked"), payout_amount);
    let payload = json_set_int(payload, name("backlog"), CoverAutomationBacklog);
    let result = call_contract(CoverRiskVaultContract, "lock_liability", payload);
    return decode_int(result);
  }

  fn risk_vault_deposit(amount: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 3);
    let payload = json_set_int(payload, name("amount"), amount);
    let result = call_contract(CoverRiskVaultContract, "deposit", payload);
    return decode_int(result);
  }

  fn risk_vault_release_liability(policy_id: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 3);
    let payload = json_set_int(payload, name("exposure_id"), policy_id);
    let payload = json_set_int(payload, name("backlog"), CoverAutomationBacklog);
    let result = call_contract(CoverRiskVaultContract, "release_liability", payload);
    return decode_int(result);
  }

  fn risk_vault_settle_payout(policy_id: int, recipient: AccountId, amount: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 3);
    let payload = json_set_int(payload, name("exposure_id"), policy_id);
    let payload = json_set_account_id(payload, name("recipient"), recipient);
    let payload = json_set_int(payload, name("amount"), amount);
    let result = call_contract(CoverRiskVaultContract, "settle_payout", payload);
    return decode_int(result);
  }

  fn risk_vault_report_bucket() {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 3);
    let payload = json_set_int(payload, name("backlog"), CoverAutomationBacklog);
    let payload = json_set_int(payload, name("safe_mode"), CoverAutomationSafeMode);
    let result = call_contract(CoverRiskVaultContract, "report_bucket_c2c", payload);
    assert(decode_int(result) == 1, "risk bucket report failed");
  }

  kotoage fn main() -> int {
    return CoverInitialized;
  }

  kotoage fn init_manager(settlement_asset: AssetDefinitionId,
                          risk_vault_contract: bytes,
                          required_observations: int,
                          oracle_stale_slots: int,
                          oracle_public_key: bytes,
                          oracle_scheme: int) {
    assert(CoverInitialized == 0, "cover manager initialized");
    assert(required_observations > 0, "invalid required observations");
    assert(oracle_stale_slots >= 0, "invalid stale slots");
    assert(oracle_scheme > 0, "invalid oracle scheme");
    CoverInitialized = 1;
    CoverOwner = authority();
    CoverSettlementAsset = settlement_asset;
    CoverRiskVaultContract = risk_vault_contract;
    CoverContractBound = 0;
    CoverContractId = authority();
    CoverWithdrawalOnly = 1;
    CoverOraclePublicKey = oracle_public_key;
    CoverOracleScheme = oracle_scheme;
    CoverDefaultRequiredObservations = required_observations;
    CoverOracleStaleSlots = oracle_stale_slots;
    CoverObservationJobId = 0;
    CoverAutomationCadence = 0;
    CoverAutomationBacklogCap = 0;
    CoverAutomationBacklog = 0;
    CoverAutomationSafeMode = 0;
    CoverLifecycleCadenceSlots = 0;
    CoverLifecycleMaxItems = 1;
    CoverLifecycleEnabled = 0;
    CoverLifecycleNextSlot = 0;
    CoverLifecycleCursor = 1;
    CoverLifecycleLastSlot = 0;
    CoverLifecycleLastProcessed = 0;
    CoverNextPolicyId = 1;
  }

  kotoage fn sync_automation(executor: AccountId,
                             job_id: int,
                             cadence_slots: int,
                             backlog_cap: int,
                             safe_mode: int) permission(Admin) {
    assert_owner();
    assert(job_id >= 0, "invalid job id");
    assert(cadence_slots >= 0, "invalid cadence");
    assert(backlog_cap >= 0, "invalid backlog cap");
    CoverAutomationExecutor = executor;
    CoverObservationJobId = job_id;
    CoverAutomationCadence = cadence_slots;
    CoverAutomationBacklogCap = backlog_cap;
    CoverAutomationSafeMode = safe_mode;
  }

  kotoage fn heartbeat(current_backlog: int,
                       safe_mode: int) permission(Admin) {
    assert_owner();
    assert(current_backlog >= 0, "invalid backlog");
    CoverAutomationBacklog = current_backlog;
    CoverAutomationSafeMode = safe_mode;
    risk_vault_report_bucket();
  }

  kotoage fn configure_trigger_lifecycle(cadence_slots: int,
                                         max_items_per_tick: int,
                                         enabled: int) permission(Admin) {
    assert_owner();
    assert(cadence_slots >= 0, "invalid cadence");
    assert(max_items_per_tick > 0, "invalid max items");
    assert(max_items_per_tick <= 16, "max items too high");
    assert(enabled == 0 || enabled == 1, "invalid enabled");
    CoverLifecycleCadenceSlots = cadence_slots;
    CoverLifecycleMaxItems = max_items_per_tick;
    CoverLifecycleEnabled = enabled;
    CoverLifecycleNextSlot = block_height() + cadence_slots;
    if CoverLifecycleCursor <= 0 {
      CoverLifecycleCursor = 1;
    }
    set_trigger_enabled(name("soraswap_cover_lifecycle_tick"), enabled);
  }

  kotoage fn native_lifecycle_tick() permission(AssetOps) {
    if CoverInitialized == 0 {
      return;
    }
    if CoverLifecycleEnabled == 0 {
      return;
    }
    let current_slot = block_height();
    if CoverLifecycleNextSlot > 0 && current_slot < CoverLifecycleNextSlot {
      return;
    }
    let processed = 0;
    let policy_id = CoverLifecycleCursor;
    if policy_id <= 0 || policy_id >= CoverNextPolicyId {
      policy_id = 1;
    }
    while processed < CoverLifecycleMaxItems && policy_id < CoverNextPolicyId {
      if CoverPolicyStatus.get_or(policy_id, 0) == 1 {
        let expiry_slot = CoverPolicyRegistrationSlot.get_or(policy_id, 0) +
          CoverPolicyMonitoringWindowSlots.get_or(policy_id, 0);
        if current_slot >= expiry_slot {
          risk_vault_release_liability(policy_id);
          CoverPolicyStatus[policy_id] = 5;
        }
      }
      processed = processed + 1;
      policy_id = policy_id + 1;
    }
    if policy_id >= CoverNextPolicyId {
      policy_id = 1;
    }
    CoverLifecycleCursor = policy_id;
    CoverLifecycleLastSlot = current_slot;
    CoverLifecycleLastProcessed = processed;
    CoverLifecycleNextSlot = current_slot + CoverLifecycleCadenceSlots;
  }

  kotoage fn bind_contract(contract_id: AccountId) {
    assert_owner();
    CoverContractId = contract_id;
    CoverContractBound = 1;
  }

  kotoage fn bind_risk_vault(risk_vault_contract: bytes) {
    assert_owner();
    CoverRiskVaultContract = risk_vault_contract;
  }

  kotoage fn enter_withdrawal_only() {
    assert_owner();
    CoverWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() {
    assert_owner();
    CoverWithdrawalOnly = 0;
  }

  kotoage fn register_policy(lower_bound: int,
                             upper_bound: int,
                             payout_amount: int,
                             monitoring_window_slots: int,
                             required_observations: int,
                             covered_notional: int,
                             premium_paid: int) -> int permission(AssetOps) {
    assert_initialized();
    assert(CoverWithdrawalOnly == 0, "withdrawal only");
    assert(CoverAutomationSafeMode == 0, "automation safe mode");
    assert(lower_bound < upper_bound, "invalid bounds");
    assert(payout_amount > 0, "invalid payout");
    assert(monitoring_window_slots > 0, "invalid monitoring window");
    assert(covered_notional > 0, "invalid covered notional");
    let registration_slot = block_height();
    let policy_id = CoverNextPolicyId;
    CoverNextPolicyId = policy_id + 1;
    if premium_paid > 0 {
      assert_contract_bound();
      move_asset_if_needed(authority(), CoverContractId, CoverSettlementAsset, premium_paid);
      risk_vault_deposit(premium_paid);
    }
    risk_vault_lock_liability(policy_id, covered_notional, payout_amount);
    CoverPolicyOwner[policy_id] = authority();
    CoverPolicyLowerBound[policy_id] = lower_bound;
    CoverPolicyUpperBound[policy_id] = upper_bound;
    CoverPolicyPayoutAmount[policy_id] = payout_amount;
    CoverPolicyMonitoringWindowSlots[policy_id] = monitoring_window_slots;
    if required_observations > 0 {
      CoverPolicyRequiredObservations[policy_id] = required_observations;
    } else {
      CoverPolicyRequiredObservations[policy_id] = CoverDefaultRequiredObservations;
    }
    CoverPolicyCoveredNotional[policy_id] = covered_notional;
    CoverPolicyPremiumPaid[policy_id] = premium_paid;
    CoverPolicyStatus[policy_id] = 1;
    CoverPolicyRegistrationSlot[policy_id] = registration_slot;
    CoverPolicyBreachStartSlot[policy_id] = 0;
    CoverPolicyBreachElapsedSlots[policy_id] = 0;
    CoverPolicyObservationCount[policy_id] = 0;
    CoverPolicyLastObservationSlot[policy_id] = 0;
    CoverPolicyLastOracleSlot[policy_id] = 0;
    CoverPolicyLastObservedPrice[policy_id] = 0;
    CoverPolicyClaimPayout[policy_id] = 0;
    CoverPolicyClaimCount[policy_id] = 0;
    return policy_id;
  }

  kotoage fn record_observation(policy_id: int,
                                oracle_payload: bytes,
                                oracle_signature: bytes) {
    assert_initialized();
    assert_policy_exists(policy_id);
    assert(CoverPolicyStatus.get_or(policy_id, 0) != 4, "policy already claimed");
    assert(CoverPolicyStatus.get_or(policy_id, 0) != 5, "policy expired");
    let oracle = assert_verified_observation(policy_id, oracle_payload, oracle_signature);
    let observed_price = oracle.0;
    let oracle_slot = oracle.1;
    let current_slot = oracle.2;
    let status_flags = oracle.3;

    let prior_slot = CoverPolicyLastObservationSlot.get_or(policy_id, 0);
    CoverPolicyLastObservationSlot[policy_id] = current_slot;
    CoverPolicyLastOracleSlot[policy_id] = oracle_slot;
    CoverPolicyLastObservedPrice[policy_id] = observed_price;

    if status_flags != 0 || CoverAutomationSafeMode != 0 || current_slot - oracle_slot > CoverOracleStaleSlots {
      reset_breach(policy_id);
      return;
    }

    let lower_bound = CoverPolicyLowerBound[policy_id];
    let upper_bound = CoverPolicyUpperBound[policy_id];
    if observed_price < lower_bound || observed_price > upper_bound {
      let delta_slots = 1;
      if prior_slot > 0 && current_slot > prior_slot {
        delta_slots = current_slot - prior_slot;
      }
      if CoverPolicyStatus.get_or(policy_id, 0) != 2 && CoverPolicyStatus.get_or(policy_id, 0) != 3 {
        CoverPolicyStatus[policy_id] = 2;
        CoverPolicyBreachStartSlot[policy_id] = current_slot;
        CoverPolicyBreachElapsedSlots[policy_id] = 0;
        CoverPolicyObservationCount[policy_id] = 1;
      } else {
        CoverPolicyObservationCount[policy_id] = CoverPolicyObservationCount.get_or(policy_id, 0) + 1;
        CoverPolicyBreachElapsedSlots[policy_id] = CoverPolicyBreachElapsedSlots.get_or(policy_id, 0) + delta_slots;
      }
      if CoverPolicyBreachElapsedSlots.get_or(policy_id, 0) >= CoverPolicyMonitoringWindowSlots.get_or(policy_id, 0) &&
        CoverPolicyObservationCount.get_or(policy_id, 0) >= CoverPolicyRequiredObservations.get_or(policy_id, 0) {
        CoverPolicyStatus[policy_id] = 3;
      }
      return;
    }

    reset_breach(policy_id);
  }

  kotoage fn route_claim(policy_id: int) -> int permission(AssetOps) {
    assert_initialized();
    assert_policy_owner(policy_id);
    assert(CoverPolicyStatus.get_or(policy_id, 0) == 3, "policy not claimable");
    let payout = CoverPolicyPayoutAmount.get_or(policy_id, 0);
    let settled_payout = risk_vault_settle_payout(policy_id, authority(), payout);
    risk_vault_release_liability(policy_id);
    CoverPolicyStatus[policy_id] = 4;
    CoverPolicyClaimPayout[policy_id] = settled_payout;
    CoverPolicyClaimCount[policy_id] = CoverPolicyClaimCount.get_or(policy_id, 0) + 1;
    return settled_payout;
  }

  kotoage fn expire_policy(policy_id: int) permission(AssetOps) {
    assert_policy_exists(policy_id);
    assert(CoverPolicyStatus.get_or(policy_id, 0) == 1, "policy not active");
    let expiry_slot = CoverPolicyRegistrationSlot.get_or(policy_id, 0) +
      CoverPolicyMonitoringWindowSlots.get_or(policy_id, 0);
    let current_slot = block_height();
    assert(current_slot >= expiry_slot, "policy live");
    risk_vault_release_liability(policy_id);
    CoverPolicyStatus[policy_id] = 5;
  }

  view fn manager_config() -> (AssetDefinitionId, bytes, int, int, int, int, int, int, int) {
    assert_initialized();
    return (
      CoverSettlementAsset,
      CoverRiskVaultContract,
      CoverWithdrawalOnly,
      CoverDefaultRequiredObservations,
      CoverOracleStaleSlots,
      CoverObservationJobId,
      CoverAutomationCadence,
      CoverAutomationBacklogCap,
      CoverAutomationSafeMode
    );
  }

  view fn policy_state(policy_id: int) -> (int, int, int, int, int, int, int, int, int, int, int, int) {
    let registered = 0;
    if CoverPolicyOwner.contains(policy_id) {
      registered = 1;
    }
    return (
      registered,
      CoverPolicyStatus.get_or(policy_id, 0),
      CoverPolicyLowerBound.get_or(policy_id, 0),
      CoverPolicyUpperBound.get_or(policy_id, 0),
      CoverPolicyPayoutAmount.get_or(policy_id, 0),
      CoverPolicyMonitoringWindowSlots.get_or(policy_id, 0),
      CoverPolicyRequiredObservations.get_or(policy_id, 0),
      CoverPolicyCoveredNotional.get_or(policy_id, 0),
      CoverPolicyBreachElapsedSlots.get_or(policy_id, 0),
      CoverPolicyObservationCount.get_or(policy_id, 0),
      CoverPolicyLastObservedPrice.get_or(policy_id, 0),
      CoverPolicyClaimPayout.get_or(policy_id, 0)
    );
  }

  view fn automation_state() -> (int, int, int, int, int, int, int) {
    let executor_bound = 0;
    if CoverObservationJobId > 0 {
      executor_bound = 1;
    }
    return (
      executor_bound,
      CoverObservationJobId,
      CoverAutomationCadence,
      CoverAutomationBacklogCap,
      CoverAutomationBacklog,
      CoverAutomationSafeMode,
      CoverWithdrawalOnly
    );
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      CoverLifecycleEnabled,
      CoverLifecycleCadenceSlots,
      CoverLifecycleMaxItems,
      CoverLifecycleNextSlot,
      CoverLifecycleCursor,
      CoverLifecycleLastSlot,
      CoverLifecycleLastProcessed
    );
  }
}
