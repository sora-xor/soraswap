// Trigger-resident conditional escrow primitive.
seiyaku ConditionalEscrow {
    error enum EscrowError {
        EscrowMissing = 1, EscrowIncomplete = 2, EscrowAlreadyExists = 3, InvalidAmount = 4, InvalidExpiry = 5, InvalidCondition = 6, EscrowNotOpen = 7, ConditionMismatch = 8, EscrowExpired = 9, TakerMismatch = 10, MakerMismatch = 11, NoExpiry = 12, EscrowStillLive = 13, InvalidTriggerPayload = 14,
    }

    state AccountId EscrowContractId;
    state StateMap<Name, AccountId> EscrowMaker;
    state StateMap<Name, AccountId> EscrowTaker;
    state StateMap<Name, AssetDefinitionId> EscrowAsset;
    state StateMap<Name, quantity> EscrowAmount;
    state StateMap<Name, int> EscrowExpirySlot;
    state StateMap<Name, int> EscrowConditionCode;
    state StateMap<Name, int> EscrowStatus;
    state StateMap<Name, int> EscrowAcceptedSlot;
    state StateMap<Name, int> EscrowRefundedSlot;
    fn assert_escrow_exists(Name escrow_id) {
        require(EscrowMaker.contains(key: escrow_id), EscrowError::EscrowMissing);
    }

    fn assert_complete_escrow(Name escrow_id) {
        assert_escrow_exists(escrow_id: escrow_id);
        require(
            EscrowTaker.contains(key: escrow_id) && EscrowAsset.contains(key: escrow_id) && EscrowAmount.contains(
                key: escrow_id,
            ) && EscrowExpirySlot.contains(key: escrow_id) && EscrowConditionCode.contains(
                key: escrow_id,
            ) && EscrowStatus.contains(key: escrow_id),
            EscrowError::EscrowIncomplete,
        );
    }

    fn move_asset_if_needed(
        AccountId source,
        AccountId destination,
        AssetDefinitionId asset,
        quantity amount,
    ) {
        if amount > 0 && source != destination {
            ledger::asset::transfer(
                source: source,
                destination: destination,
                asset_definition: asset,
                amount: amount,
                dataspace: DataSpaceId::parse("0"),
            );
        }
    }

    fn accept_impl(Name escrow_id, int condition_code, bool triggered) -> quantity {
        assert_complete_escrow(escrow_id: escrow_id);
        require(EscrowStatus.get_or(key: escrow_id, default: 0) == 1, EscrowError::EscrowNotOpen, );
        require(
            EscrowConditionCode.get_or(key: escrow_id, default: 0) == condition_code,
            EscrowError::ConditionMismatch,
        );
        let current_slot = context::block_height();
        let expiry_slot = EscrowExpirySlot.get_or(key: escrow_id, default: 0);
        if expiry_slot > 0 {
            require(current_slot <= expiry_slot, EscrowError::EscrowExpired);
        }
        let taker = EscrowTaker.get(key: escrow_id).unwrap_or(default: context::authority());
        if ! triggered {
            require(taker == context::authority(), EscrowError::TakerMismatch);
        }
        let amount = EscrowAmount.get_or(key: escrow_id, default: 0);
        EscrowStatus[escrow_id] = 2;
        EscrowAcceptedSlot[escrow_id] = current_slot;
        if let Option::some(asset) = EscrowAsset.get(key: escrow_id) {
            move_asset_if_needed(
                source: EscrowContractId,
                destination: taker,
                asset: asset,
                amount: amount,
            );
        } else {
            require(false, EscrowError::EscrowIncomplete);
        }
        return amount;
    }

    hajimari(AccountId escrow_account) {
        EscrowContractId = escrow_account;
    }

    trigger soraswap_escrow_settle -> native_by_call_settle {
        on execute trigger soraswap_escrow_settle;
        repeats indefinitely;
        metadata {
            tag: "soraswap";
            "module": "escrow.conditional_escrow";
        }
    }

    view fn main() -> int {
        return 1;
    }

    kotoage fn open_escrow(
        Name escrow_id,
        AccountId taker,
        AssetDefinitionId asset,
        quantity amount,
        int expiry_slot,
        int condition_code,
    ) authorize("AssetOps") {
        require(!EscrowMaker.contains(key: escrow_id), EscrowError::EscrowAlreadyExists);
        require(amount > 0, EscrowError::InvalidAmount);
        require(
            expiry_slot == 0 || expiry_slot >= context::block_height(),
            EscrowError::InvalidExpiry,
        );
        require(condition_code > 0, EscrowError::InvalidCondition);
        move_asset_if_needed(
            source: context::authority(),
            destination: EscrowContractId,
            asset: asset,
            amount: amount,
        );
        EscrowMaker[escrow_id] = context::authority();
        EscrowTaker[escrow_id] = taker;
        EscrowAsset[escrow_id] = asset;
        EscrowAmount[escrow_id] = amount;
        EscrowExpirySlot[escrow_id] = expiry_slot;
        EscrowConditionCode[escrow_id] = condition_code;
        EscrowStatus[escrow_id] = 1;
        EscrowAcceptedSlot[escrow_id] = 0;
        EscrowRefundedSlot[escrow_id] = 0;
    }

    kotoage fn accept_escrow(Name escrow_id, int condition_code, ) -> quantity authorize("AssetOps") {
        return accept_impl(escrow_id: escrow_id, condition_code: condition_code, triggered: false, );
    }

    kotoage fn native_by_call_settle() -> quantity authorize("AssetOps") {
        let event = context::trigger_event();
        if let Option::some(escrow_id) = event.get_name(Name::parse("escrow_id")) {
            if let Option::some(condition_code) = event.get_int(Name::parse("condition_code")) {
                return accept_impl(
                    escrow_id: escrow_id,
                    condition_code: condition_code,
                    triggered: true,
                );
            }
        }
        require(false, EscrowError::InvalidTriggerPayload);
        return 0;
    }

    kotoage fn cancel_escrow(Name escrow_id) -> quantity authorize("AssetOps") {
        assert_complete_escrow(escrow_id: escrow_id);
        let maker = EscrowMaker.get(key: escrow_id).unwrap_or(default: context::authority());
        require(maker == context::authority(), EscrowError::MakerMismatch);
        require(EscrowStatus.get_or(key: escrow_id, default: 0) == 1, EscrowError::EscrowNotOpen, );
        let amount = EscrowAmount.get_or(key: escrow_id, default: 0);
        EscrowStatus[escrow_id] = 3;
        EscrowRefundedSlot[escrow_id] = context::block_height();
        if let Option::some(asset) = EscrowAsset.get(key: escrow_id) {
            move_asset_if_needed(
                source: EscrowContractId,
                destination: maker,
                asset: asset,
                amount: amount,
            );
        } else {
            require(false, EscrowError::EscrowIncomplete);
        }
        return amount;
    }

    kotoage fn refund_expired(Name escrow_id) -> quantity authorize("AssetOps") {
        assert_complete_escrow(escrow_id: escrow_id);
        require(EscrowStatus.get_or(key: escrow_id, default: 0) == 1, EscrowError::EscrowNotOpen, );
        let current_slot = context::block_height();
        let expiry_slot = EscrowExpirySlot.get_or(key: escrow_id, default: 0);
        require(expiry_slot > 0, EscrowError::NoExpiry);
        require(current_slot > expiry_slot, EscrowError::EscrowStillLive);
        let amount = EscrowAmount.get_or(key: escrow_id, default: 0);
        let maker = EscrowMaker.get(key: escrow_id).unwrap_or(default: context::authority());
        EscrowStatus[escrow_id] = 4;
        EscrowRefundedSlot[escrow_id] = current_slot;
        if let Option::some(asset) = EscrowAsset.get(key: escrow_id) {
            move_asset_if_needed(
                source: EscrowContractId,
                destination: maker,
                asset: asset,
                amount: amount,
            );
        } else {
            require(false, EscrowError::EscrowIncomplete);
        }
        return amount;
    }

    view fn escrow_state(Name escrow_id) -> (int, quantity, int, int, int, int) {
        var int registered = 0;
        if EscrowMaker.contains(key: escrow_id) {
            registered = 1;
        }
        return (registered, EscrowAmount.get_or(key: escrow_id, default: 0), EscrowExpirySlot.get_or(
            key: escrow_id,
            default: 0,
        ), EscrowConditionCode.get_or(key: escrow_id, default: 0), EscrowStatus.get_or(
            key: escrow_id,
            default: 0,
        ), EscrowAcceptedSlot.get_or(key: escrow_id, default: 0) + EscrowRefundedSlot.get_or(
            key: escrow_id,
            default: 0,
        ));
    }

    view fn escrow_config() -> AccountId {
        return EscrowContractId;
    }
}
