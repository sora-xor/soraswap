seiyaku SeriesManager {
  state UnderlyingAsset: Map<Name, AssetDefinitionId>;
  state SettlementAsset: Map<Name, AssetDefinitionId>;
  state Treasury: Map<Name, AccountId>;
  state StrikePrice: Map<Name, int>;
  state Premium: Map<Name, int>;
  state SeriesExpirySlot: Map<Name, int>;
  state SeriesActive: Map<Name, int>;
  state TicketsIssued: Map<Name, int>;
  state TicketsExercised: Map<Name, int>;
  state TicketsVoided: Map<Name, int>;
  state SeriesCollateralInventory: Map<Name, int>;
  state SeriesCollateralReserved: Map<Name, int>;
  state SeriesCollateralPaid: Map<Name, int>;
  state TicketSeries: Map<Name, Name>;
  state TicketOwner: Map<Name, AccountId>;
  state TicketActive: Map<Name, int>;
  state TicketPremiumPaid: Map<Name, int>;
  state TicketContracts: Map<Name, int>;
  state TicketCollateralReserved: Map<Name, int>;
  state TicketPayoutPaid: Map<Name, int>;

  fn assert_series_exists(series: Name) {
    assert(contains(UnderlyingAsset, series), "series missing");
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  fn series_name() -> Name {
    let series = name!("series");
    return series;
  }

  fn settlement_asset_name() -> Name {
    let settlement_asset = name!("settlement_asset");
    return settlement_asset;
  }

  fn treasury_name() -> Name {
    let treasury = name!("treasury");
    return treasury;
  }

  fn strike_price_name() -> Name {
    let strike_price = name!("strike_price");
    return strike_price;
  }

  fn premium_name() -> Name {
    let premium = name!("premium");
    return premium;
  }

  fn buyer_name() -> Name {
    let buyer = name!("buyer");
    return buyer;
  }

  fn ticket_name() -> Name {
    let ticket = name!("ticket");
    return ticket;
  }

  fn payout_name() -> Name {
    let payout = name!("payout");
    return payout;
  }

  fn owner_name() -> Name {
    let owner = name!("owner");
    return owner;
  }

  fn amount_name() -> Name {
    let amount = name!("amount");
    return amount;
  }

  fn contracts_name() -> Name {
    let contracts = name!("contracts");
    return contracts;
  }

  fn reserve_collateral_for_contracts(series: Name, contracts: int) -> int {
    let required = StrikePrice[series] * contracts;
    assert(required > 0, "invalid collateral reserve");
    assert(get_or_insert_default(SeriesCollateralInventory, series, 0) >= required, "insufficient collateral inventory");
    SeriesCollateralInventory[series] = get_or_insert_default(SeriesCollateralInventory, series, 0) - required;
    SeriesCollateralReserved[series] = get_or_insert_default(SeriesCollateralReserved, series, 0) + required;
    return required;
  }

  fn release_ticket_collateral(series: Name, ticket: Name, payout: int) {
    let reserved = get_or_insert_default(TicketCollateralReserved, ticket, 0);
    assert(reserved >= payout, "payout exceeds reserved collateral");
    SeriesCollateralReserved[series] = get_or_insert_default(SeriesCollateralReserved, series, 0) - reserved;
    SeriesCollateralInventory[series] = get_or_insert_default(SeriesCollateralInventory, series, 0) + (reserved - payout);
    SeriesCollateralPaid[series] = get_or_insert_default(SeriesCollateralPaid, series, 0) + payout;
    TicketCollateralReserved[ticket] = 0;
    TicketPayoutPaid[ticket] = get_or_insert_default(TicketPayoutPaid, ticket, 0) + payout;
  }

  #[access(read="*", write="*")]
  kotoage fn main() -> int {
    return 1;
  }

  #[access(read="*", write="*")]
  kotoage fn init_series(series: Name,
                         underlying_asset: AssetDefinitionId,
                         settlement_asset: AssetDefinitionId,
                         treasury: AccountId,
                         strike_price: int,
                         premium: int) permission(Admin) {
    init_series_impl(
      series,
      underlying_asset,
      settlement_asset,
      treasury,
      strike_price,
      premium
    );
  }

  fn init_series_impl(series: Name,
                      underlying_asset: AssetDefinitionId,
                      settlement_asset: AssetDefinitionId,
                      treasury: AccountId,
                      strike_price: int,
                      premium: int) {
    UnderlyingAsset[series] = underlying_asset;
    SettlementAsset[series] = settlement_asset;
    Treasury[series] = treasury;
    StrikePrice[series] = strike_price;
    Premium[series] = premium;
    SeriesExpirySlot[series] = 0;
    SeriesActive[series] = 1;
    TicketsIssued[series] = 0;
    TicketsExercised[series] = 0;
    TicketsVoided[series] = 0;
    SeriesCollateralInventory[series] = 0;
    SeriesCollateralReserved[series] = 0;
    SeriesCollateralPaid[series] = 0;
  }

  #[access(read="*", write="*")]
  kotoage fn configure_series(series: Name,
                              strike_price: int,
                              premium: int,
                              expiry_slot: int,
                              active: int) permission(Admin) {
    configure_series_impl(
      series,
      strike_price,
      premium,
      expiry_slot,
      active
    );
  }

  fn configure_series_impl(series: Name,
                           strike_price: int,
                           premium: int,
                           expiry_slot: int,
                           active: int) {
    assert_series_exists(series);
    assert(strike_price > 0, "invalid strike price");
    assert(premium > 0, "invalid premium");
    assert(expiry_slot >= 0, "invalid expiry");
    assert(active == 0 || active == 1, "invalid active flag");
    StrikePrice[series] = strike_price;
    Premium[series] = premium;
    SeriesExpirySlot[series] = expiry_slot;
    SeriesActive[series] = active;
  }

  #[access(read="*", write="*")]
  kotoage fn deposit_collateral(owner: AccountId,
                                series: Name,
                                amount: int) -> int permission(Admin) {
    assert_series_exists(series);
    return deposit_collateral_with_assets_impl(
      owner,
      series,
      Treasury[series],
      SettlementAsset[series],
      amount
    );
  }

  #[access(read="*", write="*")]
  kotoage fn deposit_collateral_with_assets(owner: AccountId,
                                            series: Name,
                                            treasury: AccountId,
                                            settlement_asset: AssetDefinitionId,
                                            amount: int) -> int permission(Admin) {
    return deposit_collateral_with_assets_impl(
      owner,
      series,
      treasury,
      settlement_asset,
      amount
    );
  }

  fn deposit_collateral_with_assets_impl(owner: AccountId,
                                         series: Name,
                                         treasury: AccountId,
                                         settlement_asset: AssetDefinitionId,
                                         amount: int) -> int {
    assert_series_exists(series);
    assert(amount > 0, "invalid collateral amount");
    move_asset_if_needed(owner, treasury, settlement_asset, amount);
    SeriesCollateralInventory[series] = get_or_insert_default(SeriesCollateralInventory, series, 0) + amount;
    return amount;
  }

  #[access(read="*", write="*")]
  kotoage fn buy_option(buyer: AccountId,
                        series: Name,
                        ticket: Name) permission(Admin) {
    buy_option_impl(buyer, series, ticket);
  }

  fn buy_option_impl(buyer: AccountId, series: Name, ticket: Name) {
    assert_series_exists(series);
    buy_option_sized_with_assets_impl(
      buyer,
      series,
      ticket,
      Treasury[series],
      SettlementAsset[series],
      Premium[series],
      1
    );
  }

  #[access(read="*", write="*")]
  kotoage fn buy_option_with_assets(buyer: AccountId,
                                    series: Name,
                                    ticket: Name,
                                    treasury: AccountId,
                                    settlement_asset: AssetDefinitionId,
                                    premium: int) permission(Admin) {
    buy_option_sized_with_assets_impl(
      buyer,
      series,
      ticket,
      treasury,
      settlement_asset,
      premium,
      1
    );
  }

  #[access(read="*", write="*")]
  kotoage fn buy_option_sized(buyer: AccountId,
                              series: Name,
                              ticket: Name,
                              contracts: int) permission(Admin) {
    assert_series_exists(series);
    buy_option_sized_with_assets_impl(
      buyer,
      series,
      ticket,
      Treasury[series],
      SettlementAsset[series],
      Premium[series] * contracts,
      contracts
    );
  }

  #[access(read="*", write="*")]
  kotoage fn buy_option_sized_with_assets(buyer: AccountId,
                                          series: Name,
                                          ticket: Name,
                                          treasury: AccountId,
                                          settlement_asset: AssetDefinitionId,
                                          premium: int,
                                          contracts: int) permission(Admin) {
    buy_option_sized_with_assets_impl(
      buyer,
      series,
      ticket,
      treasury,
      settlement_asset,
      premium,
      contracts
    );
  }

  fn buy_option_sized_with_assets_impl(buyer: AccountId,
                                       series: Name,
                                       ticket: Name,
                                       treasury: AccountId,
                                       settlement_asset: AssetDefinitionId,
                                       premium: int,
                                       contracts: int) {
    assert_series_exists(series);
    assert(get_or_insert_default(SeriesActive, series, 0) == 1, "series inactive");
    assert(!contains(TicketSeries, ticket), "ticket exists");
    assert(contracts > 0, "invalid contracts");
    let required_premium = Premium[series] * contracts;
    assert(premium == required_premium, "premium mismatch");
    let reserved_collateral = reserve_collateral_for_contracts(series, contracts);
    move_asset_if_needed(buyer, treasury, settlement_asset, premium);
    TicketSeries[ticket] = series;
    TicketOwner[ticket] = buyer;
    TicketActive[ticket] = 1;
    TicketPremiumPaid[ticket] = premium;
    TicketContracts[ticket] = contracts;
    TicketCollateralReserved[ticket] = reserved_collateral;
    TicketPayoutPaid[ticket] = 0;
    TicketsIssued[series] = get_or_insert_default(TicketsIssued, series, 0) + 1;
  }

  #[access(read="*", write="*")]
  kotoage fn exercise(buyer: AccountId,
                      ticket: Name,
                      payout: int) permission(Admin) {
    exercise_impl(buyer, ticket, payout);
  }

  fn exercise_impl(buyer: AccountId, ticket: Name, payout: int) {
    assert(contains(TicketSeries, ticket), "ticket missing");
    let series = TicketSeries[ticket];
    exercise_with_assets_impl(
      buyer,
      ticket,
      Treasury[series],
      SettlementAsset[series],
      payout
    );
  }

  #[access(read="*", write="*")]
  kotoage fn exercise_with_assets(buyer: AccountId,
                                  ticket: Name,
                                  treasury: AccountId,
                                  settlement_asset: AssetDefinitionId,
                                  payout: int) permission(Admin) {
    exercise_with_assets_impl(
      buyer,
      ticket,
      treasury,
      settlement_asset,
      payout
    );
  }

  fn exercise_with_assets_impl(buyer: AccountId,
                               ticket: Name,
                               treasury: AccountId,
                               settlement_asset: AssetDefinitionId,
                               payout: int) {
    assert(get_or_insert_default(TicketActive, ticket, 0) == 1, "ticket inactive");
    assert(TicketOwner[ticket] == buyer, "buyer mismatch");
    let series = TicketSeries[ticket];
    assert(get_or_insert_default(SeriesActive, series, 0) == 1, "series inactive");
    assert(payout >= 0, "invalid payout");
    assert(payout <= get_or_insert_default(TicketCollateralReserved, ticket, 0), "payout exceeds collateral");
    move_asset_if_needed(treasury, buyer, settlement_asset, payout);
    release_ticket_collateral(series, ticket, payout);
    TicketActive[ticket] = 0;
    TicketsExercised[series] = get_or_insert_default(TicketsExercised, series, 0) + 1;
  }

  #[access(read="*", write="*")]
  kotoage fn expire_series(series: Name, current_slot: int) permission(Admin) {
    assert_series_exists(series);
    let expiry_slot = get_or_insert_default(SeriesExpirySlot, series, 0);
    assert(expiry_slot > 0, "expiry missing");
    assert(current_slot >= expiry_slot, "series live");
    SeriesActive[series] = 0;
  }

  #[access(read="*", write="*")]
  kotoage fn void_expired_ticket(ticket: Name) permission(Admin) {
    assert(get_or_insert_default(TicketActive, ticket, 0) == 1, "ticket inactive");
    let series = TicketSeries[ticket];
    assert(get_or_insert_default(SeriesActive, series, 0) == 0, "series active");
    release_ticket_collateral(series, ticket, 0);
    TicketActive[ticket] = 0;
    TicketsVoided[series] = get_or_insert_default(TicketsVoided, series, 0) + 1;
  }

  view fn series_config(series: Name) -> (AssetDefinitionId, AssetDefinitionId, AccountId, int, int, int, int) {
    assert_series_exists(series);
    return (
      UnderlyingAsset[series],
      SettlementAsset[series],
      Treasury[series],
      get_or(StrikePrice, series, 0),
      get_or(Premium, series, 0),
      get_or(SeriesExpirySlot, series, 0),
      get_or(SeriesActive, series, 0)
    );
  }

  view fn mirror_series(series: Name) -> (int, int, int, int, int, int, int, int, int, int) {
    assert_series_exists(series);
    return (
      get_or(StrikePrice, series, 0),
      get_or(Premium, series, 0),
      get_or(SeriesExpirySlot, series, 0),
      get_or(SeriesActive, series, 0),
      get_or(TicketsIssued, series, 0),
      get_or(TicketsExercised, series, 0),
      get_or(TicketsVoided, series, 0),
      get_or(SeriesCollateralInventory, series, 0),
      get_or(SeriesCollateralReserved, series, 0),
      get_or(SeriesCollateralPaid, series, 0)
    );
  }

  view fn mirror_ticket(ticket: Name) -> (int, int, int, int, int, int) {
    let ticket_registered = 0;
    if contains(TicketSeries, ticket) {
      ticket_registered = 1;
    }
    return (
      ticket_registered,
      get_or(TicketActive, ticket, 0),
      get_or(TicketPremiumPaid, ticket, 0),
      get_or(TicketContracts, ticket, 0),
      get_or(TicketCollateralReserved, ticket, 0),
      get_or(TicketPayoutPaid, ticket, 0)
    );
  }
}
