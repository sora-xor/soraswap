    let payload = json_object();
    let payload = json_set_int(payload, name("series_id"), series_id);
    let payload = json_set_int(payload, name("expiry_slot"), expiry_slot);
    let payload = json_set_int(payload, name("collateral_multiplier_bps"), collateral_multiplier_bps);
    let result = call_contract(OptFactoryOutperfContract, "sync_series_c2c", payload);
