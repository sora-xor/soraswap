  fn manager_settle_series(series_id: int,
                           final_mark: int,
                           final_quote_mark: int,
                           settlement_slot: int,
                           oracle_slot: int,
                           current_slot: int,
                           status_flags: int,
                           attestation_hash: int) {
    let payload = json_object();
    let payload = json_set_int(payload, name("series_id"), series_id);
    let payload = json_set_int(payload, name("final_mark"), final_mark);
    let payload = json_set_int(payload, name("final_quote_mark"), final_quote_mark);
    let payload = json_set_int(payload, name("settlement_slot"), settlement_slot);
    let payload = json_set_int(payload, name("oracle_slot"), oracle_slot);
    let payload = json_set_int(payload, name("current_slot"), current_slot);
    let payload = json_set_int(payload, name("status_flags"), status_flags);
    let payload = json_set_int(payload, name("attestation_hash"), attestation_hash);
    let result = call_contract(OptFactoryManagerContract, "settle_series_c2c", payload);
    assert(decode_int(result) == 1, "manager settle failed");
  }

