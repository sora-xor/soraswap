seiyaku OptionsFactory {
  state int OptFactoryInitialized;
  state AccountId OptFactoryOwner;
  state AccountId OptFactoryGuardian;
  state AssetDefinitionId OptFactorySettlementAsset;
  state bytes OptFactoryManagerContract;
  state bytes OptFactoryRiskVaultContract;
  state bytes OptFactoryVaultContract;
  state bytes OptFactoryShoutContract;
  state bytes OptFactoryOutperfContract;
  state int OptFactoryContractBound;
  state AccountId OptFactoryContractId;
  state int OptFactoryWithdrawalOnly;

  state AccountId OptFactoryAutomationExecutor;
  state int OptFactoryAutomationJobId;
  state int OptFactoryAutomationCadence;
  state int OptFactoryAutomationBacklogCap;
  state int OptFactoryAutomationBacklog;
  state int OptFactoryAutomationSafeMode;

  state int OptFactoryNextPositionId;

  state OptFactorySeriesKind: Map<int, int>;
  state OptFactorySeriesMaxNotional: Map<int, int>;
  state OptFactorySeriesPremiumBps: Map<int, int>;
  state OptFactorySeriesStrikeBps: Map<int, int>;
  state OptFactorySeriesCollateralMultiplierBps: Map<int, int>;
  state OptFactorySeriesExpirySlot: Map<int, int>;
  state OptFactorySeriesOpenNotional: Map<int, int>;
  state OptFactorySeriesUtilisationBps: Map<int, int>;
  state OptFactorySeriesBumpActivateBps: Map<int, int>;
  state OptFactorySeriesBumpDeactivateBps: Map<int, int>;
  state OptFactorySeriesPauseThresholdBps: Map<int, int>;
  state OptFactorySeriesBumpPercentBps: Map<int, int>;
  state OptFactorySeriesLastSettlementSlot: Map<int, int>;
  state OptFactorySeriesFinalMark: Map<int, int>;
  state OptFactorySeriesFinalQuoteMark: Map<int, int>;
  state OptFactorySeriesSettlementReady: Map<int, int>;

  state OptFactoryPositionOwner: Map<int, AccountId>;
  state OptFactoryPositionSeriesId: Map<int, int>;
  state OptFactoryPositionKind: Map<int, int>;
  state OptFactoryPositionNotional: Map<int, int>;
  state OptFactoryPositionPremiumPaid: Map<int, int>;
  state OptFactoryPositionCollateralLocked: Map<int, int>;
  state OptFactoryPositionStatus: Map<int, int>;
  state OptFactoryPositionRecordedPayout: Map<int, int>;
  state OptFactoryPositionSettlementReady: Map<int, int>;
  state OptFactoryPositionShoutFloor: Map<int, int>;
  state OptFactoryPositionLastOracleMark: Map<int, int>;

  fn assert_initialized() {
    assert(OptFactoryInitialized == 1, "factory not initialized");
  }

  fn assert_owner() {
    assert_initialized();
    assert(OptFactoryOwner == authority(), "factory owner mismatch");
  }

  fn assert_contract_bound() {
    assert(OptFactoryContractBound == 1, "factory contract unbound");
  }

  fn assert_series_exists(series_id: int) {
    assert(OptFactorySeriesKind.contains(series_id), "series missing");
  }

  fn assert_position_exists(position_id: int) {
    assert(OptFactoryPositionOwner.contains(position_id), "position missing");
  }

  fn assert_position_owner(position_id: int) {
    assert_position_exists(position_id);
    assert(OptFactoryPositionOwner[position_id] == authority(), "position owner mismatch");
  }

  fn abs_int(value: int) -> int {
    if value < 0 {
      return 0 - value;
    }
    return value;
  }

  fn max_int(a: int, b: int) -> int {
    if a >= b {
      return a;
    }
    return b;
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  fn position_registered(position_id: int) -> int {
    if OptFactoryPositionOwner.contains(position_id) {
      return 1;
    }
    return 0;
  }

  fn required_premium(series_id: int, notional: int) -> int {
    let base_premium = (notional * OptFactorySeriesPremiumBps.get_or(series_id, 0)) / 10_000;
    let utilisation = OptFactorySeriesUtilisationBps.get_or(series_id, 0);
    let activate = OptFactorySeriesBumpActivateBps.get_or(series_id, 0);
    let deactivate = OptFactorySeriesBumpDeactivateBps.get_or(series_id, 0);
    let bump = OptFactorySeriesBumpPercentBps.get_or(series_id, 0);
    if activate > 0 && utilisation >= activate {
      return (base_premium * (10_000 + bump)) / 10_000;
    }
    if deactivate > 0 && utilisation <= deactivate {
      return base_premium;
    }
    return base_premium;
  }

  fn next_utilisation_bps(series_id: int, next_open_notional: int) -> int {
    let max_notional = OptFactorySeriesMaxNotional.get_or(series_id, 0);
    if max_notional <= 0 {
      return 0;
    }
    return (next_open_notional * 10_000 + max_notional - 1) / max_notional;
  }

  fn risk_vault_lock_liability(position_id: int, notional: int, collateral_locked: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 2);
    let payload = json_set_int(payload, name("exposure_id"), position_id);
    let payload = json_set_int(payload, name("notional"), notional);
    let payload = json_set_int(payload, name("collateral_locked"), collateral_locked);
    let payload = json_set_int(payload, name("backlog"), OptFactoryAutomationBacklog);
    let result = call_contract(OptFactoryRiskVaultContract, "lock_liability", payload);
    return decode_int(result);
  }

  fn risk_vault_deposit(amount: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 2);
    let payload = json_set_int(payload, name("amount"), amount);
    let result = call_contract(OptFactoryRiskVaultContract, "deposit", payload);
    return decode_int(result);
  }

  fn risk_vault_release_liability(position_id: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 2);
    let payload = json_set_int(payload, name("exposure_id"), position_id);
    let payload = json_set_int(payload, name("backlog"), OptFactoryAutomationBacklog);
    let result = call_contract(OptFactoryRiskVaultContract, "release_liability", payload);
    return decode_int(result);
  }

  fn risk_vault_settle_payout(position_id: int, recipient: AccountId, amount: int) -> int {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 2);
    let payload = json_set_int(payload, name("exposure_id"), position_id);
    let payload = json_set_account_id(payload, name("recipient"), recipient);
    let payload = json_set_int(payload, name("amount"), amount);
    let result = call_contract(OptFactoryRiskVaultContract, "settle_payout", payload);
    return decode_int(result);
  }

  fn risk_vault_report_bucket() {
    let payload = json_object();
    let payload = json_set_int(payload, name("bucket_id"), 2);
    let payload = json_set_int(payload, name("backlog"), OptFactoryAutomationBacklog);
    let payload = json_set_int(payload, name("safe_mode"), OptFactoryAutomationSafeMode);
    let result = call_contract(OptFactoryRiskVaultContract, "report_bucket_c2c", payload);
    assert(decode_int(result) == 1, "risk bucket report failed");
  }

  fn vault_sync_series(series_id: int) {
    let payload = json_object();
    let payload = json_set_int(payload, name("series_id"), series_id);
    let result = call_contract(OptFactoryVaultContract, "sync_series_c2c", payload);
    assert(decode_int(result) == 1, "vault sync failed");
  }

  fn shout_sync_series(series_id: int, expiry_slot: int, strike_bps: int) {
