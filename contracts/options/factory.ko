    let payload = json_set_int(payload, name("position_id"), position_id);
    let payload = json_set_int(payload, name("series_id"), series_id);
    let payload = json_set_account_id(payload, name("owner"), owner);
    let payload = json_set_int(payload, name("notional"), notional);
    let payload = json_set_int(payload, name("strike_bps"), strike_bps);
    let result = call_contract(OptFactoryShoutContract, "register_position_c2c", payload);
    assert(decode_int(result) == 1, "shout register failed");
