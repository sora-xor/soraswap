// Options position factory with shared-vault collateralization.
//
// Buying is fully typed and atomic across the risk vault, accounting vault,
// and product modules. Oracle-derived mutations remain private until the
// compiler-owned schema-bound signed-attestation verifier is wired in.

seiyaku OptionsFactory {
  error enum OptionsFactoryError {
    OwnerMismatch = 1,
    GuardianMismatch = 2,
    WithdrawalOnly = 3,
    AutomationUnsafe = 4,
    InvalidKind = 5,
    InvalidNotional = 6,
    InvalidPremium = 7,
    InvalidCollateral = 8,
    InvalidExpiry = 9,
    InvalidStrike = 10,
    InvalidGuard = 11,
    InvalidCadence = 12,
    InvalidMaxItems = 13,
    InvalidEnabled = 14,
    InvalidJobId = 15,
    InvalidBacklogCap = 16,
    InvalidBacklog = 17,
    InvalidSafeMode = 18,
    InvalidOracleScheme = 19,
    InvalidOracleStaleSlots = 20,
    InvalidOracleSlot = 21,
    InvalidMark = 22,
    MissingAttestation = 23,
    OracleStale = 24,
    OracleSlotReplay = 25,
    SeriesExists = 26,
    SeriesMissing = 27,
    SeriesInactive = 28,
    SeriesExpired = 29,
    SeriesNotExpired = 30,
    SeriesCapacity = 31,
    SeriesPausedByGuard = 32,
    SeriesLimit = 33,
    PositionMissing = 34,
    PositionOwnerMismatch = 35,
    PositionInactive = 36,
    PositionKindMismatch = 37,
    PositionLimit = 38,
    ModuleCallFailed = 39,
    PayoutMismatch = 40,
    IndexCorrupt = 41,
    InvalidAuthoritySeparation = 42,
  }

  state int OptFactoryInitialized;
  state AccountId OptFactoryOwner;
  state AccountId OptFactoryGuardian;
  state AccountId OptFactoryAccount;
  state AssetDefinitionId OptFactorySettlementAsset;
  state int OptFactoryWithdrawalOnly;
  state bytes OptFactoryRiskVaultContract;
  state bytes OptFactoryManagerContract;
  state bytes OptFactoryVaultContract;
  state bytes OptFactoryShoutContract;
  state bytes OptFactoryOutperformanceContract;
  state bytes OptFactoryOraclePublicKey;
  state int OptFactoryOracleScheme;
  state int OptFactoryOracleStaleSlots;

  state AccountId OptFactoryAutomationExecutor;
  state int OptFactoryAutomationJobId;
  state int OptFactoryAutomationCadence;
  state int OptFactoryAutomationBacklogCap;
  state int OptFactoryAutomationBacklog;
  state int OptFactoryAutomationSafeMode;
  state int OptFactoryLifecycleCadenceSlots;
  state int OptFactoryLifecycleMaxItems;
  state int OptFactoryLifecycleEnabled;
  state int OptFactoryLifecycleNextSlot;
  state int OptFactoryLifecycleCursor;
  state int OptFactoryLifecycleLastSlot;
  state int OptFactoryLifecycleLastProcessed;

  state int OptFactorySeriesCount;
  state int OptFactoryNextPositionId;
  state StateMap<int, int> OptFactorySeriesKind;
  state StateMap<int, int> OptFactorySeriesStatus;
  state StateMap<int, quantity> OptFactorySeriesMaxNotional;
  state StateMap<int, int> OptFactorySeriesPremiumBps;
  state StateMap<int, int> OptFactorySeriesCollateralMultiplierBps;
  state StateMap<int, int> OptFactorySeriesExpirySlot;
  state StateMap<int, int> OptFactorySeriesStrikeBps;
  state StateMap<int, quantity> OptFactorySeriesOpenNotional;
  state StateMap<int, int> OptFactorySeriesUtilisationBps;
  state StateMap<int, int> OptFactorySeriesBumpActivateBps;
  state StateMap<int, int> OptFactorySeriesBumpDeactivateBps;
  state StateMap<int, int> OptFactorySeriesPauseThresholdBps;
  state StateMap<int, int> OptFactorySeriesBumpPercentBps;
  state StateMap<int, int> OptFactorySeriesLastSettlementSlot;
  state StateMap<int, int> OptFactorySeriesOracleSlot;
  state StateMap<int, int> OptFactorySeriesAttestationHash;
  state StateMap<int, decimal> OptFactorySeriesFinalMark;
  state StateMap<int, decimal> OptFactorySeriesFinalQuoteMark;
  state StateMap<int, int> OptFactorySeriesSettlementReady;

  state StateMap<int, AccountId> OptFactoryPositionOwner;
  state StateMap<int, int> OptFactoryPositionSeriesId;
  state StateMap<int, int> OptFactoryPositionKind;
  state StateMap<int, quantity> OptFactoryPositionNotional;
  state StateMap<int, quantity> OptFactoryPositionPremiumPaid;
  state StateMap<int, quantity> OptFactoryPositionCollateralLocked;
  state StateMap<int, int> OptFactoryPositionStatus;
  state StateMap<int, quantity> OptFactoryPositionRecordedPayout;
  state StateMap<int, int> OptFactoryPositionSettlementReady;
  state StateMap<int, int> OptFactoryPositionShoutFloorBps;
  state StateMap<int, int> OptFactoryPositionLastOracleMarkBps;
  state StateMap<int, int> OptFactoryPositionLastOracleSlot;
  state StateMap<int, int> OptFactoryPositionLastAttestationHash;

  trigger soraswap_options_factory_lifecycle_tick -> native_lifecycle_tick {
    on time schedule(40000, 120000);
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "options.factory"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn zero_decimal() -> decimal {
    let decimal zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn max_int(int left, int right) -> int {
    if left >= right {
      return left;
    }
    return right;
  }

  fn assert_owner() {
    require(OptFactoryOwner == context::authority(), OptionsFactoryError::OwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if OptFactoryOwner == context::authority() {
      return;
    }
    require(OptFactoryGuardian == context::authority(), OptionsFactoryError::GuardianMismatch);
  }

  fn assert_risk_on() {
    require(OptFactoryWithdrawalOnly == 0, OptionsFactoryError::WithdrawalOnly);
    require(OptFactoryAutomationSafeMode == 0, OptionsFactoryError::AutomationUnsafe);
    require(
      OptFactoryAutomationBacklog <= OptFactoryAutomationBacklogCap,
      OptionsFactoryError::AutomationUnsafe
    );
  }

  fn assert_series_exists(int series_id) {
    require(OptFactorySeriesKind.contains(series_id), OptionsFactoryError::SeriesMissing);
  }

  fn assert_position_exists(int position_id) {
    require(OptFactoryPositionOwner.contains(position_id), OptionsFactoryError::PositionMissing);
  }

  fn assert_position_owner(int position_id) {
    assert_position_exists(position_id: position_id);
    require(
      OptFactoryPositionOwner.get(position_id).unwrap_or(OptFactoryOwner) == context::authority(),
      OptionsFactoryError::PositionOwnerMismatch
    );
  }

  fn move_settlement_asset(
    AccountId source,
    AccountId destination,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: OptFactorySettlementAsset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn bps_amount(quantity amount, int bps) -> quantity {
    let decimal scale = 10_000;
    let rate = decimal::from_int(value: bps) / scale;
    return amount * rate;
  }

  fn utilisation_bps(int series_id, quantity next_open_notional) -> int {
    let maximum = OptFactorySeriesMaxNotional.get(series_id).unwrap_or(zero_quantity());
    require(maximum > zero_quantity(), OptionsFactoryError::InvalidNotional);
    let ratio = next_open_notional.ratio_round(
      divisor: maximum,
      scale: 12,
      mode: Rounding::ceil
    );
    return decimal::to_int_round(value: ratio * 10_000, mode: Rounding::ceil);
  }

  fn required_premium(int series_id, quantity notional) -> quantity {
    let base = bps_amount(
      amount: notional,
      bps: OptFactorySeriesPremiumBps.get(series_id).unwrap_or(0)
    );
    let utilisation = OptFactorySeriesUtilisationBps.get(series_id).unwrap_or(0);
    let activate = OptFactorySeriesBumpActivateBps.get(series_id).unwrap_or(0);
    if activate > 0 && utilisation >= activate {
      return base + bps_amount(
        amount: base,
        bps: OptFactorySeriesBumpPercentBps.get(series_id).unwrap_or(0)
      );
    }
    return base;
  }

  fn risk_vault_deposit(quantity amount) -> quantity {
    return contract::invoke(
      contract: OptFactoryRiskVaultContract,
      entrypoint: "deposit",
      returns: "quantity",
      bucket_id: 2,
      amount: amount
    );
  }

  fn risk_vault_lock(
    int position_id,
    quantity notional,
    quantity collateral
  ) -> int {
    return contract::invoke(
      contract: OptFactoryRiskVaultContract,
      entrypoint: "lock_liability",
      returns: "int",
      bucket_id: 2,
      exposure_id: position_id,
      notional: notional,
      collateral_locked: collateral,
      backlog: OptFactoryAutomationBacklog
    );
  }

  fn risk_vault_release(int position_id) -> int {
    return contract::invoke(
      contract: OptFactoryRiskVaultContract,
      entrypoint: "release_liability",
      returns: "int",
      bucket_id: 2,
      exposure_id: position_id,
      backlog: OptFactoryAutomationBacklog
    );
  }

  fn risk_vault_payout(
    int position_id,
    AccountId recipient,
    quantity amount
  ) -> quantity {
    return contract::invoke(
      contract: OptFactoryRiskVaultContract,
      entrypoint: "settle_payout",
      returns: "quantity",
      bucket_id: 2,
      exposure_id: position_id,
      recipient: recipient,
      amount: amount
    );
  }

  fn vault_sync_series(int series_id) {
    let accepted = contract::invoke(
      contract: OptFactoryVaultContract,
      entrypoint: "sync_series_c2c",
      returns: "int",
      series_id: series_id
    );
    require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
  }

  fn vault_record_position(
    int position_id,
    int series_id,
    AccountId owner,
    quantity collateral,
    quantity premium
  ) {
    let accepted = contract::invoke(
      contract: OptFactoryVaultContract,
      entrypoint: "record_position_c2c",
      returns: "int",
      position_id: position_id,
      series_id: series_id,
      owner: owner,
      collateral_locked: collateral,
      premium_paid: premium
    );
    require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
  }

  fn vault_settle_position(
    int position_id,
    quantity payout,
    quantity premium_burn
  ) {
    let accepted = contract::invoke(
      contract: OptFactoryVaultContract,
      entrypoint: "settle_position_c2c",
      returns: "int",
      position_id: position_id,
      payout: payout,
      premium_burn: premium_burn
    );
    require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
  }

  fn sync_product_series(
    int series_id,
    int option_kind,
    int expiry_slot,
    int strike_bps,
    int collateral_multiplier_bps
  ) {
    if option_kind == 1 {
      let accepted = contract::invoke(
        contract: OptFactoryShoutContract,
        entrypoint: "sync_series_c2c",
        returns: "int",
        series_id: series_id,
        expiry_slot: expiry_slot,
        strike_bps: strike_bps
      );
      require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    } else {
      let accepted = contract::invoke(
        contract: OptFactoryOutperformanceContract,
        entrypoint: "sync_series_c2c",
        returns: "int",
        series_id: series_id,
        expiry_slot: expiry_slot,
        collateral_multiplier_bps: collateral_multiplier_bps
      );
      require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    }
  }

  fn register_product_position(
    int position_id,
    int series_id,
    int option_kind,
    AccountId owner,
    quantity notional,
    int strike_bps,
    int collateral_multiplier_bps
  ) {
    if option_kind == 1 {
      let accepted = contract::invoke(
        contract: OptFactoryShoutContract,
        entrypoint: "register_position_c2c",
        returns: "int",
        position_id: position_id,
        series_id: series_id,
        owner: owner,
        notional: notional,
        strike_bps: strike_bps
      );
      require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    } else {
      let accepted = contract::invoke(
        contract: OptFactoryOutperformanceContract,
        entrypoint: "register_position_c2c",
        returns: "int",
        position_id: position_id,
        series_id: series_id,
        owner: owner,
        notional: notional,
        collateral_multiplier_bps: collateral_multiplier_bps
      );
      require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    }
  }

  fn buy_position(int series_id, int expected_kind, quantity notional) -> int {
    assert_risk_on();
    assert_series_exists(series_id: series_id);
    require(OptFactorySeriesKind.get(series_id).unwrap_or(0) == expected_kind, OptionsFactoryError::PositionKindMismatch);
    require(OptFactorySeriesStatus.get(series_id).unwrap_or(0) == 1, OptionsFactoryError::SeriesInactive);
    require(context::block_height() < OptFactorySeriesExpirySlot.get(series_id).unwrap_or(0), OptionsFactoryError::SeriesExpired);
    require(notional > zero_quantity(), OptionsFactoryError::InvalidNotional);
    let next_open = OptFactorySeriesOpenNotional.get(series_id).unwrap_or(zero_quantity()) + notional;
    require(next_open <= OptFactorySeriesMaxNotional.get(series_id).unwrap_or(zero_quantity()), OptionsFactoryError::SeriesCapacity);
    let next_utilisation = utilisation_bps(series_id: series_id, next_open_notional: next_open);
    let pause_threshold = OptFactorySeriesPauseThresholdBps.get(series_id).unwrap_or(10_000);
    require(next_utilisation <= pause_threshold, OptionsFactoryError::SeriesPausedByGuard);
    require(OptFactoryNextPositionId > 0 && OptFactoryNextPositionId < 1_000_000_000, OptionsFactoryError::PositionLimit);
    let position_id = OptFactoryNextPositionId;
    OptFactoryNextPositionId = position_id + 1;
    let premium = required_premium(series_id: series_id, notional: notional);
    let collateral = bps_amount(
      amount: notional,
      bps: OptFactorySeriesCollateralMultiplierBps.get(series_id).unwrap_or(0)
    );
    require(premium > zero_quantity(), OptionsFactoryError::InvalidPremium);
    require(collateral >= notional, OptionsFactoryError::InvalidCollateral);
    move_settlement_asset(
      source: context::authority(),
      destination: OptFactoryAccount,
      amount: premium + collateral
    );
    require(
      risk_vault_deposit(amount: premium + collateral) >= premium + collateral,
      OptionsFactoryError::ModuleCallFailed
    );
    risk_vault_lock(
      position_id: position_id,
      notional: notional,
      collateral: collateral
    );
    vault_record_position(
      position_id: position_id,
      series_id: series_id,
      owner: context::authority(),
      collateral: collateral,
      premium: premium
    );
    register_product_position(
      position_id: position_id,
      series_id: series_id,
      option_kind: expected_kind,
      owner: context::authority(),
      notional: notional,
      strike_bps: OptFactorySeriesStrikeBps.get(series_id).unwrap_or(0),
      collateral_multiplier_bps: OptFactorySeriesCollateralMultiplierBps.get(series_id).unwrap_or(0)
    );
    OptFactorySeriesOpenNotional[series_id] = next_open;
    OptFactorySeriesUtilisationBps[series_id] = next_utilisation;
    OptFactoryPositionOwner[position_id] = context::authority();
    OptFactoryPositionSeriesId[position_id] = series_id;
    OptFactoryPositionKind[position_id] = expected_kind;
    OptFactoryPositionNotional[position_id] = notional;
    OptFactoryPositionPremiumPaid[position_id] = premium;
    OptFactoryPositionCollateralLocked[position_id] = collateral;
    OptFactoryPositionStatus[position_id] = 1;
    OptFactoryPositionRecordedPayout[position_id] = zero_quantity();
    OptFactoryPositionSettlementReady[position_id] = 0;
    OptFactoryPositionShoutFloorBps[position_id] = 0;
    OptFactoryPositionLastOracleMarkBps[position_id] = 0;
    OptFactoryPositionLastOracleSlot[position_id] = -1;
    OptFactoryPositionLastAttestationHash[position_id] = 0;
    return position_id;
  }

  fn apply_verified_series_settlement(
    int series_id,
    decimal final_mark,
    decimal final_quote_mark,
    int base_return_bps,
    int quote_return_bps,
    int oracle_slot,
    int attestation_hash
  ) {
    assert_series_exists(series_id: series_id);
    require(OptFactorySeriesStatus.get(series_id).unwrap_or(0) == 2, OptionsFactoryError::SeriesNotExpired);
    require(final_mark >= zero_decimal() && final_quote_mark >= zero_decimal(), OptionsFactoryError::InvalidMark);
    require(base_return_bps >= -1_000_000 && quote_return_bps >= -1_000_000, OptionsFactoryError::InvalidMark);
    require(attestation_hash > 0, OptionsFactoryError::MissingAttestation);
    let current_slot = context::block_height();
    require(oracle_slot >= 0 && current_slot >= oracle_slot, OptionsFactoryError::InvalidOracleSlot);
    require(current_slot - oracle_slot <= OptFactoryOracleStaleSlots, OptionsFactoryError::OracleStale);
    require(
      oracle_slot > OptFactorySeriesOracleSlot.get(series_id).unwrap_or(-1),
      OptionsFactoryError::OracleSlotReplay
    );
    require(OptFactorySeriesKind.get(series_id).unwrap_or(0) == 2, OptionsFactoryError::PositionKindMismatch);
    let accepted = contract::invoke(
      contract: OptFactoryOutperformanceContract,
      entrypoint: "settle_series_c2c",
      returns: "int",
      series_id: series_id,
      base_return_bps: base_return_bps,
      quote_return_bps: quote_return_bps,
      settlement_slot: current_slot
    );
    require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    OptFactorySeriesStatus[series_id] = 3;
    OptFactorySeriesLastSettlementSlot[series_id] = current_slot;
    OptFactorySeriesOracleSlot[series_id] = oracle_slot;
    OptFactorySeriesAttestationHash[series_id] = attestation_hash;
    OptFactorySeriesFinalMark[series_id] = final_mark;
    OptFactorySeriesFinalQuoteMark[series_id] = final_quote_mark;
    OptFactorySeriesSettlementReady[series_id] = 1;
  }

  fn apply_verified_shout_mark(
    int position_id,
    int mark_price_bps,
    int oracle_slot,
    int attestation_hash
  ) {
    assert_position_exists(position_id: position_id);
    require(OptFactoryPositionKind.get(position_id).unwrap_or(0) == 1, OptionsFactoryError::PositionKindMismatch);
    require(OptFactoryPositionStatus.get(position_id).unwrap_or(0) == 1, OptionsFactoryError::PositionInactive);
    require(mark_price_bps >= 0, OptionsFactoryError::InvalidMark);
    require(attestation_hash > 0, OptionsFactoryError::MissingAttestation);
    require(oracle_slot >= 0 && context::block_height() >= oracle_slot, OptionsFactoryError::InvalidOracleSlot);
    require(context::block_height() - oracle_slot <= OptFactoryOracleStaleSlots, OptionsFactoryError::OracleStale);
    require(
      oracle_slot > OptFactoryPositionLastOracleSlot.get(position_id).unwrap_or(-1),
      OptionsFactoryError::OracleSlotReplay
    );
    let accepted = contract::invoke(
      contract: OptFactoryShoutContract,
      entrypoint: "record_shout_c2c",
      returns: "int",
      position_id: position_id,
      mark_price_bps: mark_price_bps,
      oracle_slot: oracle_slot,
      attestation_hash: attestation_hash
    );
    require(accepted == 1, OptionsFactoryError::ModuleCallFailed);
    OptFactoryPositionShoutFloorBps[position_id] = max_int(
      left: OptFactoryPositionShoutFloorBps.get(position_id).unwrap_or(0),
      right: mark_price_bps
    );
    OptFactoryPositionLastOracleMarkBps[position_id] = mark_price_bps;
    OptFactoryPositionLastOracleSlot[position_id] = oracle_slot;
    OptFactoryPositionLastAttestationHash[position_id] = attestation_hash;
  }

  hajimari(
    AssetDefinitionId settlement_asset,
    AccountId factory_account,
    AccountId guardian,
    bytes risk_vault_contract,
    bytes manager_contract,
    bytes vault_contract,
    bytes shout_contract,
    bytes outperformance_contract,
    bytes oracle_public_key,
    int oracle_scheme,
    int oracle_stale_slots
  ) {
    require(factory_account != context::authority(), OptionsFactoryError::InvalidAuthoritySeparation);
    require(guardian != context::authority() && guardian != factory_account, OptionsFactoryError::InvalidAuthoritySeparation);
    require(oracle_scheme > 0, OptionsFactoryError::InvalidOracleScheme);
    require(oracle_stale_slots >= 0, OptionsFactoryError::InvalidOracleStaleSlots);
    OptFactoryInitialized = 1;
    OptFactoryOwner = context::authority();
    OptFactoryGuardian = guardian;
    OptFactoryAccount = factory_account;
    OptFactorySettlementAsset = settlement_asset;
    OptFactoryWithdrawalOnly = 1;
    OptFactoryRiskVaultContract = risk_vault_contract;
    OptFactoryManagerContract = manager_contract;
    OptFactoryVaultContract = vault_contract;
    OptFactoryShoutContract = shout_contract;
    OptFactoryOutperformanceContract = outperformance_contract;
    OptFactoryOraclePublicKey = oracle_public_key;
    OptFactoryOracleScheme = oracle_scheme;
    OptFactoryOracleStaleSlots = oracle_stale_slots;
    OptFactoryAutomationExecutor = context::authority();
    OptFactoryAutomationJobId = 0;
    OptFactoryAutomationCadence = 0;
    OptFactoryAutomationBacklogCap = 0;
    OptFactoryAutomationBacklog = 0;
    OptFactoryAutomationSafeMode = 0;
    OptFactoryLifecycleCadenceSlots = 1;
    OptFactoryLifecycleMaxItems = 1;
    OptFactoryLifecycleEnabled = 0;
    OptFactoryLifecycleNextSlot = 0;
    OptFactoryLifecycleCursor = 1;
    OptFactoryLifecycleLastSlot = 0;
    OptFactoryLifecycleLastProcessed = 0;
    OptFactorySeriesCount = 0;
    OptFactoryNextPositionId = 1;
  }

  view fn main() -> int {
    return OptFactoryInitialized;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    OptFactoryWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    OptFactoryWithdrawalOnly = 0;
  }

  kotoage fn sync_automation(
    AccountId executor,
    int job_id,
    int cadence_slots,
    int backlog_cap,
    int safe_mode
  ) authorize("Admin") {
    assert_owner();
    require(job_id >= 0, OptionsFactoryError::InvalidJobId);
    require(cadence_slots >= 0, OptionsFactoryError::InvalidCadence);
    require(backlog_cap >= 0, OptionsFactoryError::InvalidBacklogCap);
    require(safe_mode == 0 || safe_mode == 1, OptionsFactoryError::InvalidSafeMode);
    require(OptFactoryAutomationBacklog <= backlog_cap, OptionsFactoryError::InvalidBacklog);
    OptFactoryAutomationExecutor = executor;
    OptFactoryAutomationJobId = job_id;
    OptFactoryAutomationCadence = cadence_slots;
    OptFactoryAutomationBacklogCap = backlog_cap;
    OptFactoryAutomationSafeMode = safe_mode;
  }

  kotoage fn heartbeat(int current_backlog, int safe_mode) authorize("Entry") {
    require(
      context::authority() == OptFactoryOwner || context::authority() == OptFactoryAutomationExecutor,
      OptionsFactoryError::OwnerMismatch
    );
    require(current_backlog >= 0 && current_backlog <= OptFactoryAutomationBacklogCap, OptionsFactoryError::InvalidBacklog);
    require(safe_mode == 0 || safe_mode == 1, OptionsFactoryError::InvalidSafeMode);
    OptFactoryAutomationBacklog = current_backlog;
    OptFactoryAutomationSafeMode = safe_mode;
  }

  kotoage fn configure_trigger_lifecycle(
    int cadence_slots,
    int max_items_per_tick,
    int enabled
  ) authorize("AssetOps") {
    assert_owner();
    require(cadence_slots > 0, OptionsFactoryError::InvalidCadence);
    require(max_items_per_tick > 0 && max_items_per_tick <= 64, OptionsFactoryError::InvalidMaxItems);
    require(enabled == 0 || enabled == 1, OptionsFactoryError::InvalidEnabled);
    OptFactoryLifecycleCadenceSlots = cadence_slots;
    OptFactoryLifecycleMaxItems = max_items_per_tick;
    OptFactoryLifecycleEnabled = enabled;
    OptFactoryLifecycleNextSlot = context::block_height() + cadence_slots;
    ledger::trigger::set_enabled(Name::parse("soraswap_options_factory_lifecycle_tick"), enabled);
  }

  kotoage fn sync_series(
    int series_id,
    int option_kind,
    quantity max_notional,
    int premium_bps,
    int collateral_multiplier_bps,
    int expiry_slot,
    int strike_bps
  ) authorize("Admin") {
    assert_owner();
    require(option_kind == 1 || option_kind == 2, OptionsFactoryError::InvalidKind);
    require(max_notional > zero_quantity(), OptionsFactoryError::InvalidNotional);
    require(premium_bps > 0 && premium_bps <= 10_000, OptionsFactoryError::InvalidPremium);
    require(collateral_multiplier_bps >= 10_000, OptionsFactoryError::InvalidCollateral);
    require(expiry_slot > context::block_height(), OptionsFactoryError::InvalidExpiry);
    require(strike_bps > 0, OptionsFactoryError::InvalidStrike);
    if !OptFactorySeriesKind.contains(series_id) {
      require(OptFactorySeriesCount < 64, OptionsFactoryError::SeriesLimit);
      OptFactorySeriesCount = OptFactorySeriesCount + 1;
      OptFactorySeriesOpenNotional[series_id] = zero_quantity();
      OptFactorySeriesUtilisationBps[series_id] = 0;
      OptFactorySeriesBumpActivateBps[series_id] = 8_000;
      OptFactorySeriesBumpDeactivateBps[series_id] = 6_000;
      OptFactorySeriesPauseThresholdBps[series_id] = 9_500;
      OptFactorySeriesBumpPercentBps[series_id] = 1_500;
      OptFactorySeriesLastSettlementSlot[series_id] = 0;
      OptFactorySeriesOracleSlot[series_id] = -1;
      OptFactorySeriesAttestationHash[series_id] = 0;
      OptFactorySeriesFinalMark[series_id] = zero_decimal();
      OptFactorySeriesFinalQuoteMark[series_id] = zero_decimal();
      OptFactorySeriesSettlementReady[series_id] = 0;
    } else {
      require(
        OptFactorySeriesOpenNotional.get(series_id).unwrap_or(zero_quantity()) == zero_quantity(),
        OptionsFactoryError::SeriesCapacity
      );
    }
    OptFactorySeriesKind[series_id] = option_kind;
    OptFactorySeriesStatus[series_id] = 1;
    OptFactorySeriesMaxNotional[series_id] = max_notional;
    OptFactorySeriesPremiumBps[series_id] = premium_bps;
    OptFactorySeriesCollateralMultiplierBps[series_id] = collateral_multiplier_bps;
    OptFactorySeriesExpirySlot[series_id] = expiry_slot;
    OptFactorySeriesStrikeBps[series_id] = strike_bps;
    vault_sync_series(series_id: series_id);
    sync_product_series(
      series_id: series_id,
      option_kind: option_kind,
      expiry_slot: expiry_slot,
      strike_bps: strike_bps,
      collateral_multiplier_bps: collateral_multiplier_bps
    );
  }

  kotoage fn configure_utilisation_guard(
    int series_id,
    int bump_activate_bps,
    int bump_deactivate_bps,
    int pause_threshold_bps,
    int bump_percent_bps
  ) authorize("Admin") {
    assert_owner();
    assert_series_exists(series_id: series_id);
    require(
      bump_activate_bps >= 0 && bump_activate_bps <= 10_000 &&
      bump_deactivate_bps >= 0 && bump_deactivate_bps <= bump_activate_bps &&
      pause_threshold_bps >= bump_activate_bps && pause_threshold_bps <= 10_000 &&
      bump_percent_bps >= 0 && bump_percent_bps <= 10_000,
      OptionsFactoryError::InvalidGuard
    );
    OptFactorySeriesBumpActivateBps[series_id] = bump_activate_bps;
    OptFactorySeriesBumpDeactivateBps[series_id] = bump_deactivate_bps;
    OptFactorySeriesPauseThresholdBps[series_id] = pause_threshold_bps;
    OptFactorySeriesBumpPercentBps[series_id] = bump_percent_bps;
  }

  kotoage fn buy_shout(int series_id, quantity notional) -> int authorize("AssetOps") {
    return buy_position(series_id: series_id, expected_kind: 1, notional: notional);
  }

  kotoage fn buy_outperformance(int series_id, quantity notional) -> int authorize("AssetOps") {
    return buy_position(series_id: series_id, expected_kind: 2, notional: notional);
  }

  kotoage fn exercise_outperformance_position(int position_id) -> quantity authorize("AssetOps") {
    assert_position_owner(position_id: position_id);
    require(OptFactoryPositionKind.get(position_id).unwrap_or(0) == 2, OptionsFactoryError::PositionKindMismatch);
    require(OptFactoryPositionStatus.get(position_id).unwrap_or(0) == 1, OptionsFactoryError::PositionInactive);
    let series_id = OptFactoryPositionSeriesId.get(position_id).unwrap_or(0);
    require(OptFactorySeriesSettlementReady.get(series_id).unwrap_or(0) == 1, OptionsFactoryError::SeriesNotExpired);
    let quoted_payout = contract::invoke(
      contract: OptFactoryOutperformanceContract,
      entrypoint: "exercise_position",
      returns: "quantity",
      position_id: position_id
    );
    let paid = risk_vault_payout(
      position_id: position_id,
      recipient: context::authority(),
      amount: quoted_payout
    );
    require(paid == quoted_payout, OptionsFactoryError::PayoutMismatch);
    vault_settle_position(
      position_id: position_id,
      payout: paid,
      premium_burn: OptFactoryPositionPremiumPaid.get(position_id).unwrap_or(zero_quantity())
    );
    risk_vault_release(position_id: position_id);
    let notional = OptFactoryPositionNotional.get(position_id).unwrap_or(zero_quantity());
    let open_notional = OptFactorySeriesOpenNotional.get(series_id).unwrap_or(zero_quantity());
    require(open_notional >= notional, OptionsFactoryError::IndexCorrupt);
    OptFactorySeriesOpenNotional[series_id] = open_notional - notional;
    OptFactorySeriesUtilisationBps[series_id] = utilisation_bps(
      series_id: series_id,
      next_open_notional: open_notional - notional
    );
    OptFactoryPositionRecordedPayout[position_id] = paid;
    OptFactoryPositionSettlementReady[position_id] = 1;
    OptFactoryPositionStatus[position_id] = 3;
    return paid;
  }

  kotoage fn native_lifecycle_tick() authorize("AssetOps") {
    if OptFactoryInitialized == 0 || OptFactoryLifecycleEnabled == 0 {
      return;
    }
    let current_slot = context::block_height();
    if OptFactoryLifecycleNextSlot > 0 && current_slot < OptFactoryLifecycleNextSlot {
      return;
    }
    var processed = 0;
    var cursor = OptFactoryLifecycleCursor;
    for _step in range(64) {
      if processed < OptFactoryLifecycleMaxItems && OptFactorySeriesCount > 0 {
        if cursor < 1 {
          cursor = 1;
        }
        if OptFactorySeriesKind.contains(cursor) {
          if OptFactorySeriesStatus.get(cursor).unwrap_or(0) == 1 &&
            current_slot >= OptFactorySeriesExpirySlot.get(cursor).unwrap_or(0) {
            OptFactorySeriesStatus[cursor] = 2;
          }
          processed = processed + 1;
        }
        cursor = cursor + 1;
        if cursor >= 1_000_000 {
          cursor = 1;
        }
      }
    }
    OptFactoryLifecycleCursor = cursor;
    OptFactoryLifecycleLastSlot = current_slot;
    OptFactoryLifecycleLastProcessed = processed;
    OptFactoryLifecycleNextSlot = current_slot + OptFactoryLifecycleCadenceSlots;
  }

  view fn factory_config() -> (AssetDefinitionId, int, int, int, int, int, int) {
    return (
      OptFactorySettlementAsset,
      OptFactoryWithdrawalOnly,
      OptFactoryNextPositionId,
      OptFactoryAutomationJobId,
      OptFactoryAutomationCadence,
      OptFactoryAutomationBacklogCap,
      OptFactoryAutomationSafeMode
    );
  }

  view fn series_state(int series_id) -> (
    int,
    int,
    quantity,
    int,
    int,
    quantity,
    int,
    int,
    int,
    int
  ) {
    let exists = OptFactorySeriesKind.contains(series_id) ? 1 : 0;
    return (
      exists,
      OptFactorySeriesKind.get(series_id).unwrap_or(0),
      OptFactorySeriesMaxNotional.get(series_id).unwrap_or(zero_quantity()),
      OptFactorySeriesPremiumBps.get(series_id).unwrap_or(0),
      OptFactorySeriesCollateralMultiplierBps.get(series_id).unwrap_or(0),
      OptFactorySeriesOpenNotional.get(series_id).unwrap_or(zero_quantity()),
      OptFactorySeriesUtilisationBps.get(series_id).unwrap_or(0),
      OptFactorySeriesPauseThresholdBps.get(series_id).unwrap_or(0),
      OptFactorySeriesBumpPercentBps.get(series_id).unwrap_or(0),
      OptFactorySeriesLastSettlementSlot.get(series_id).unwrap_or(0)
    );
  }

  view fn position_state(int position_id) -> (
    int,
    int,
    int,
    quantity,
    quantity,
    quantity,
    int,
    quantity,
    int
  ) {
    let exists = OptFactoryPositionOwner.contains(position_id) ? 1 : 0;
    return (
      exists,
      OptFactoryPositionSeriesId.get(position_id).unwrap_or(0),
      OptFactoryPositionKind.get(position_id).unwrap_or(0),
      OptFactoryPositionNotional.get(position_id).unwrap_or(zero_quantity()),
      OptFactoryPositionPremiumPaid.get(position_id).unwrap_or(zero_quantity()),
      OptFactoryPositionCollateralLocked.get(position_id).unwrap_or(zero_quantity()),
      OptFactoryPositionStatus.get(position_id).unwrap_or(0),
      OptFactoryPositionRecordedPayout.get(position_id).unwrap_or(zero_quantity()),
      OptFactoryPositionSettlementReady.get(position_id).unwrap_or(0)
    );
  }

  view fn series_settlement(int series_id) -> (decimal, decimal, int, int, int) {
    assert_series_exists(series_id: series_id);
    return (
      OptFactorySeriesFinalMark.get(series_id).unwrap_or(zero_decimal()),
      OptFactorySeriesFinalQuoteMark.get(series_id).unwrap_or(zero_decimal()),
      OptFactorySeriesOracleSlot.get(series_id).unwrap_or(-1),
      OptFactorySeriesAttestationHash.get(series_id).unwrap_or(0),
      OptFactorySeriesSettlementReady.get(series_id).unwrap_or(0)
    );
  }

  view fn automation_state() -> (int, int, int, int, int, int, int) {
    return (
      OptFactoryInitialized,
      OptFactoryAutomationJobId,
      OptFactoryAutomationCadence,
      OptFactoryAutomationBacklogCap,
      OptFactoryAutomationBacklog,
      OptFactoryAutomationSafeMode,
      OptFactoryWithdrawalOnly
    );
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      OptFactoryLifecycleEnabled,
      OptFactoryLifecycleCadenceSlots,
      OptFactoryLifecycleMaxItems,
      OptFactoryLifecycleNextSlot,
      OptFactoryLifecycleCursor,
      OptFactoryLifecycleLastSlot,
      OptFactoryLifecycleLastProcessed
    );
  }
}
