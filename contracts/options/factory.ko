    let payload = json_set_int(payload, name("position_id"), position_id);
    let payload = json_set_int(payload, name("mark_price_bps"), mark_price_bps);
    let payload = json_set_int(payload, name("oracle_slot"), oracle_slot);
    let payload = json_set_int(payload, name("current_slot"), current_slot);
