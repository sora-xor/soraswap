    let payload = json_set_int(payload, name("series_id"), series_id);
    let payload = json_set_int(payload, name("expiry_slot"), expiry_slot);
    let payload = json_set_int(payload, name("strike_bps"), strike_bps);
    let result = call_contract(OptFactoryShoutContract, "sync_series_c2c", payload);
