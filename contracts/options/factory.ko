    let payload = json_set_int(payload, name("series_id"), series_id);
    let payload = json_set_account_id(payload, name("owner"), owner);
    let payload = json_set_int(payload, name("collateral_locked"), collateral_locked);
    let payload = json_set_int(payload, name("premium_paid"), premium_paid);
    let result = call_contract(OptFactoryVaultContract, "record_position_c2c", payload);
    assert(decode_int(result) == 1, "vault record failed");
  }

