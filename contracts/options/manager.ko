// Options template and series control plane.
//
// Series settlement values are stored through a private typed helper. The
// public signed-attestation entrypoint is intentionally added only with the
// compiler-owned schema-bound verifier; unsigned typed marks are not accepted.

seiyaku OptionsManager {
  error enum OptionsManagerError {
    OwnerMismatch = 1,
    GuardianMismatch = 2,
    ControllerMismatch = 3,
    WithdrawalOnly = 4,
    AutomationUnsafe = 5,
    InvalidOptionKind = 6,
    InvalidTenor = 7,
    InvalidStrike = 8,
    InvalidCollateralMultiplier = 9,
    InvalidPremium = 10,
    InvalidActive = 11,
    InvalidExpiry = 12,
    InvalidMaxNotional = 13,
    InvalidCadence = 14,
    InvalidMaxItems = 15,
    InvalidEnabled = 16,
    InvalidJobId = 17,
    InvalidBacklogCap = 18,
    InvalidBacklog = 19,
    InvalidSafeMode = 20,
    InvalidOracleScheme = 21,
    InvalidOracleStaleSlots = 22,
    InvalidOracleSlot = 23,
    InvalidFinalMark = 24,
    MissingAttestation = 25,
    OracleStale = 26,
    OracleSlotReplay = 27,
    TemplateMissing = 28,
    TemplateInactive = 29,
    SeriesMissing = 30,
    SeriesNotActive = 31,
    SeriesLive = 32,
    SeriesNotExpired = 33,
    TemplateLimit = 34,
    SeriesLimit = 35,
    IndexCorrupt = 36,
    InvalidAuthoritySeparation = 37,
  }

  state int OptMgrInitialized;
  state AccountId OptMgrOwner;
  state AccountId OptMgrController;
  state AccountId OptMgrGuardian;
  state AssetDefinitionId OptMgrSettlementAsset;
  state int OptMgrWithdrawalOnly;
  state bytes OptMgrOraclePublicKey;
  state int OptMgrOracleScheme;
  state int OptMgrOracleStaleSlots;

  state AccountId OptMgrAutomationExecutor;
  state int OptMgrExpiryJobId;
  state int OptMgrSettlementJobId;
  state int OptMgrAutomationCadence;
  state int OptMgrAutomationBacklogCap;
  state int OptMgrAutomationBacklog;
  state int OptMgrAutomationSafeMode;

  state int OptMgrLifecycleCadenceSlots;
  state int OptMgrLifecycleMaxItems;
  state int OptMgrLifecycleEnabled;
  state int OptMgrLifecycleNextSlot;
  state int OptMgrLifecycleCursor;
  state int OptMgrLifecycleLastSlot;
  state int OptMgrLifecycleLastProcessed;

  state int OptMgrNextTemplateId;
  state int OptMgrNextSeriesId;
  state StateMap<int, int> OptMgrTemplateKind;
  state StateMap<int, AssetDefinitionId> OptMgrTemplateUnderlyingAsset;
  state StateMap<int, AssetDefinitionId> OptMgrTemplateQuoteAsset;
  state StateMap<int, int> OptMgrTemplateTenorSlots;
  state StateMap<int, int> OptMgrTemplateStrikeBps;
  state StateMap<int, int> OptMgrTemplateCollateralMultiplierBps;
  state StateMap<int, int> OptMgrTemplateBasePremiumBps;
  state StateMap<int, int> OptMgrTemplateActive;

  state StateMap<int, int> OptMgrSeriesTemplateId;
  state StateMap<int, int> OptMgrSeriesKind;
  state StateMap<int, AssetDefinitionId> OptMgrSeriesUnderlyingAsset;
  state StateMap<int, AssetDefinitionId> OptMgrSeriesQuoteAsset;
  state StateMap<int, int> OptMgrSeriesExpirySlot;
  state StateMap<int, quantity> OptMgrSeriesMaxNotional;
  state StateMap<int, int> OptMgrSeriesPremiumBps;
  state StateMap<int, int> OptMgrSeriesStrikeBps;
  state StateMap<int, int> OptMgrSeriesCollateralMultiplierBps;
  state StateMap<int, int> OptMgrSeriesStatus;
  state StateMap<int, int> OptMgrSeriesSettlementSlot;
  state StateMap<int, int> OptMgrSeriesOracleSlot;
  state StateMap<int, int> OptMgrSeriesAttestationHash;
  state StateMap<int, decimal> OptMgrSeriesFinalMark;
  state StateMap<int, decimal> OptMgrSeriesFinalQuoteMark;

  trigger soraswap_options_lifecycle_tick -> native_lifecycle_tick {
    on time schedule(60000, 120000);
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "options.manager"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn zero_decimal() -> decimal {
    let decimal zero = 0;
    return zero;
  }

  fn fallback_asset() -> AssetDefinitionId {
    let asset = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
    return asset;
  }

  fn assert_owner() {
    require(OptMgrOwner == context::authority(), OptionsManagerError::OwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if OptMgrOwner == context::authority() {
      return;
    }
    require(OptMgrGuardian == context::authority(), OptionsManagerError::GuardianMismatch);
  }

  fn assert_owner_or_controller() {
    if OptMgrOwner == context::authority() {
      return;
    }
    require(OptMgrController == context::authority(), OptionsManagerError::ControllerMismatch);
  }

  fn assert_risk_on() {
    require(OptMgrWithdrawalOnly == 0, OptionsManagerError::WithdrawalOnly);
    require(OptMgrAutomationSafeMode == 0, OptionsManagerError::AutomationUnsafe);
    require(
      OptMgrAutomationBacklog <= OptMgrAutomationBacklogCap,
      OptionsManagerError::AutomationUnsafe
    );
  }

  fn assert_template_exists(int template_id) {
    require(OptMgrTemplateKind.contains(template_id), OptionsManagerError::TemplateMissing);
  }

  fn assert_series_exists(int series_id) {
    require(OptMgrSeriesTemplateId.contains(series_id), OptionsManagerError::SeriesMissing);
  }

  fn settle_series_values(
    int series_id,
    decimal final_mark,
    decimal final_quote_mark,
    int settlement_slot,
    int oracle_slot,
    int attestation_hash
  ) {
    assert_series_exists(series_id: series_id);
    require(OptMgrSeriesStatus.get(series_id).unwrap_or(0) == 2, OptionsManagerError::SeriesNotExpired);
    require(final_mark >= zero_decimal(), OptionsManagerError::InvalidFinalMark);
    require(final_quote_mark >= zero_decimal(), OptionsManagerError::InvalidFinalMark);
    require(attestation_hash > 0, OptionsManagerError::MissingAttestation);
    require(settlement_slot >= OptMgrSeriesExpirySlot.get(series_id).unwrap_or(0), OptionsManagerError::SeriesLive);
    require(oracle_slot >= 0 && settlement_slot >= oracle_slot, OptionsManagerError::InvalidOracleSlot);
    require(settlement_slot - oracle_slot <= OptMgrOracleStaleSlots, OptionsManagerError::OracleStale);
    require(
      oracle_slot > OptMgrSeriesOracleSlot.get(series_id).unwrap_or(-1),
      OptionsManagerError::OracleSlotReplay
    );
    OptMgrSeriesStatus[series_id] = 3;
    OptMgrSeriesSettlementSlot[series_id] = settlement_slot;
    OptMgrSeriesOracleSlot[series_id] = oracle_slot;
    OptMgrSeriesAttestationHash[series_id] = attestation_hash;
    OptMgrSeriesFinalMark[series_id] = final_mark;
    OptMgrSeriesFinalQuoteMark[series_id] = final_quote_mark;
  }

  hajimari(
    AssetDefinitionId settlement_asset,
    AccountId controller,
    AccountId guardian,
    bytes oracle_public_key,
    int oracle_scheme,
    int oracle_stale_slots
  ) {
    require(controller != context::authority(), OptionsManagerError::InvalidAuthoritySeparation);
    require(guardian != context::authority() && guardian != controller, OptionsManagerError::InvalidAuthoritySeparation);
    require(oracle_scheme > 0, OptionsManagerError::InvalidOracleScheme);
    require(oracle_stale_slots >= 0, OptionsManagerError::InvalidOracleStaleSlots);
    OptMgrInitialized = 1;
    OptMgrOwner = context::authority();
    OptMgrController = controller;
    OptMgrGuardian = guardian;
    OptMgrSettlementAsset = settlement_asset;
    OptMgrWithdrawalOnly = 1;
    OptMgrOraclePublicKey = oracle_public_key;
    OptMgrOracleScheme = oracle_scheme;
    OptMgrOracleStaleSlots = oracle_stale_slots;
    OptMgrAutomationExecutor = context::authority();
    OptMgrExpiryJobId = 0;
    OptMgrSettlementJobId = 0;
    OptMgrAutomationCadence = 0;
    OptMgrAutomationBacklogCap = 0;
    OptMgrAutomationBacklog = 0;
    OptMgrAutomationSafeMode = 0;
    OptMgrLifecycleCadenceSlots = 1;
    OptMgrLifecycleMaxItems = 1;
    OptMgrLifecycleEnabled = 0;
    OptMgrLifecycleNextSlot = 0;
    OptMgrLifecycleCursor = 1;
    OptMgrLifecycleLastSlot = 0;
    OptMgrLifecycleLastProcessed = 0;
    OptMgrNextTemplateId = 1;
    OptMgrNextSeriesId = 1;
  }

  view fn main() -> int {
    return OptMgrInitialized;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    OptMgrWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    OptMgrWithdrawalOnly = 0;
  }

  kotoage fn sync_automation(
    AccountId executor,
    int expiry_job_id,
    int settlement_job_id,
    int cadence_slots,
    int backlog_cap,
    int safe_mode
  ) authorize("Admin") {
    assert_owner();
    require(expiry_job_id >= 0 && settlement_job_id >= 0, OptionsManagerError::InvalidJobId);
    require(cadence_slots >= 0, OptionsManagerError::InvalidCadence);
    require(backlog_cap >= 0, OptionsManagerError::InvalidBacklogCap);
    require(safe_mode == 0 || safe_mode == 1, OptionsManagerError::InvalidSafeMode);
    require(OptMgrAutomationBacklog <= backlog_cap, OptionsManagerError::InvalidBacklog);
    OptMgrAutomationExecutor = executor;
    OptMgrExpiryJobId = expiry_job_id;
    OptMgrSettlementJobId = settlement_job_id;
    OptMgrAutomationCadence = cadence_slots;
    OptMgrAutomationBacklogCap = backlog_cap;
    OptMgrAutomationSafeMode = safe_mode;
  }

  kotoage fn heartbeat(int current_backlog, int safe_mode) authorize("Admin") {
    require(
      context::authority() == OptMgrOwner || context::authority() == OptMgrAutomationExecutor,
      OptionsManagerError::OwnerMismatch
    );
    require(current_backlog >= 0 && current_backlog <= OptMgrAutomationBacklogCap, OptionsManagerError::InvalidBacklog);
    require(safe_mode == 0 || safe_mode == 1, OptionsManagerError::InvalidSafeMode);
    OptMgrAutomationBacklog = current_backlog;
    OptMgrAutomationSafeMode = safe_mode;
  }

  kotoage fn configure_trigger_lifecycle(
    int cadence_slots,
    int max_items_per_tick,
    int enabled
  ) authorize("AssetOps") {
    assert_owner();
    require(cadence_slots > 0, OptionsManagerError::InvalidCadence);
    require(max_items_per_tick > 0 && max_items_per_tick <= 64, OptionsManagerError::InvalidMaxItems);
    require(enabled == 0 || enabled == 1, OptionsManagerError::InvalidEnabled);
    OptMgrLifecycleCadenceSlots = cadence_slots;
    OptMgrLifecycleMaxItems = max_items_per_tick;
    OptMgrLifecycleEnabled = enabled;
    OptMgrLifecycleNextSlot = context::block_height() + cadence_slots;
    ledger::trigger::set_enabled(Name::parse("soraswap_options_lifecycle_tick"), enabled);
  }

  kotoage fn register_template(
    int option_kind,
    AssetDefinitionId underlying_asset,
    AssetDefinitionId quote_asset,
    int tenor_slots,
    int strike_bps,
    int collateral_multiplier_bps,
    int base_premium_bps
  ) -> int authorize("Admin") {
    assert_owner();
    require(option_kind == 1 || option_kind == 2, OptionsManagerError::InvalidOptionKind);
    require(tenor_slots > 0, OptionsManagerError::InvalidTenor);
    require(strike_bps > 0, OptionsManagerError::InvalidStrike);
    require(collateral_multiplier_bps >= 10_000, OptionsManagerError::InvalidCollateralMultiplier);
    require(base_premium_bps > 0 && base_premium_bps <= 10_000, OptionsManagerError::InvalidPremium);
    require(OptMgrNextTemplateId >= 1 && OptMgrNextTemplateId <= 64, OptionsManagerError::TemplateLimit);
    let template_id = OptMgrNextTemplateId;
    OptMgrNextTemplateId = template_id + 1;
    OptMgrTemplateKind[template_id] = option_kind;
    OptMgrTemplateUnderlyingAsset[template_id] = underlying_asset;
    OptMgrTemplateQuoteAsset[template_id] = quote_asset;
    OptMgrTemplateTenorSlots[template_id] = tenor_slots;
    OptMgrTemplateStrikeBps[template_id] = strike_bps;
    OptMgrTemplateCollateralMultiplierBps[template_id] = collateral_multiplier_bps;
    OptMgrTemplateBasePremiumBps[template_id] = base_premium_bps;
    OptMgrTemplateActive[template_id] = 1;
    return template_id;
  }

  kotoage fn update_template(
    int template_id,
    int strike_bps,
    int collateral_multiplier_bps,
    int base_premium_bps,
    int active
  ) authorize("Admin") {
    assert_owner();
    assert_template_exists(template_id: template_id);
    require(strike_bps > 0, OptionsManagerError::InvalidStrike);
    require(collateral_multiplier_bps >= 10_000, OptionsManagerError::InvalidCollateralMultiplier);
    require(base_premium_bps > 0 && base_premium_bps <= 10_000, OptionsManagerError::InvalidPremium);
    require(active == 0 || active == 1, OptionsManagerError::InvalidActive);
    OptMgrTemplateStrikeBps[template_id] = strike_bps;
    OptMgrTemplateCollateralMultiplierBps[template_id] = collateral_multiplier_bps;
    OptMgrTemplateBasePremiumBps[template_id] = base_premium_bps;
    OptMgrTemplateActive[template_id] = active;
  }

  kotoage fn create_series(
    int template_id,
    int expiry_slot,
    quantity max_notional,
    int premium_bps
  ) -> int authorize("Entry") {
    assert_owner_or_controller();
    assert_risk_on();
    assert_template_exists(template_id: template_id);
    require(OptMgrTemplateActive.get(template_id).unwrap_or(0) == 1, OptionsManagerError::TemplateInactive);
    require(expiry_slot > context::block_height(), OptionsManagerError::InvalidExpiry);
    require(max_notional > zero_quantity(), OptionsManagerError::InvalidMaxNotional);
    require(premium_bps > 0 && premium_bps <= 10_000, OptionsManagerError::InvalidPremium);
    require(OptMgrNextSeriesId >= 1 && OptMgrNextSeriesId <= 64, OptionsManagerError::SeriesLimit);
    let series_id = OptMgrNextSeriesId;
    OptMgrNextSeriesId = series_id + 1;
    OptMgrSeriesTemplateId[series_id] = template_id;
    OptMgrSeriesKind[series_id] = OptMgrTemplateKind.get(template_id).unwrap_or(0);
    OptMgrSeriesUnderlyingAsset[series_id] = OptMgrTemplateUnderlyingAsset.get(template_id).unwrap_or(fallback_asset());
    OptMgrSeriesQuoteAsset[series_id] = OptMgrTemplateQuoteAsset.get(template_id).unwrap_or(fallback_asset());
    OptMgrSeriesExpirySlot[series_id] = expiry_slot;
    OptMgrSeriesMaxNotional[series_id] = max_notional;
    OptMgrSeriesPremiumBps[series_id] = premium_bps;
    OptMgrSeriesStrikeBps[series_id] = OptMgrTemplateStrikeBps.get(template_id).unwrap_or(0);
    OptMgrSeriesCollateralMultiplierBps[series_id] =
      OptMgrTemplateCollateralMultiplierBps.get(template_id).unwrap_or(0);
    OptMgrSeriesStatus[series_id] = 1;
    OptMgrSeriesSettlementSlot[series_id] = 0;
    OptMgrSeriesOracleSlot[series_id] = -1;
    OptMgrSeriesAttestationHash[series_id] = 0;
    OptMgrSeriesFinalMark[series_id] = zero_decimal();
    OptMgrSeriesFinalQuoteMark[series_id] = zero_decimal();
    return series_id;
  }

  kotoage fn close_series(int series_id) authorize("Entry") {
    assert_owner_or_controller();
    assert_series_exists(series_id: series_id);
    require(OptMgrSeriesStatus.get(series_id).unwrap_or(0) == 1, OptionsManagerError::SeriesNotActive);
    require(context::block_height() >= OptMgrSeriesExpirySlot.get(series_id).unwrap_or(0), OptionsManagerError::SeriesLive);
    OptMgrSeriesStatus[series_id] = 2;
  }

  kotoage fn native_lifecycle_tick() authorize("AssetOps") {
    if OptMgrInitialized == 0 || OptMgrLifecycleEnabled == 0 {
      return;
    }
    let current_slot = context::block_height();
    if OptMgrLifecycleNextSlot > 0 && current_slot < OptMgrLifecycleNextSlot {
      return;
    }
    var processed = 0;
    var cursor = OptMgrLifecycleCursor;
    for _step in range(64) {
      if processed < OptMgrLifecycleMaxItems && OptMgrNextSeriesId > 1 {
        if cursor < 1 || cursor >= OptMgrNextSeriesId {
          cursor = 1;
        }
        require(OptMgrSeriesTemplateId.contains(cursor), OptionsManagerError::IndexCorrupt);
        if OptMgrSeriesStatus.get(cursor).unwrap_or(0) == 1 &&
          current_slot >= OptMgrSeriesExpirySlot.get(cursor).unwrap_or(0) {
          OptMgrSeriesStatus[cursor] = 2;
        }
        cursor = cursor + 1;
        processed = processed + 1;
      }
    }
    if cursor >= OptMgrNextSeriesId {
      cursor = 1;
    }
    OptMgrLifecycleCursor = cursor;
    OptMgrLifecycleLastSlot = current_slot;
    OptMgrLifecycleLastProcessed = processed;
    OptMgrLifecycleNextSlot = current_slot + OptMgrLifecycleCadenceSlots;
  }

  view fn manager_config() -> (AssetDefinitionId, int, int, int, int, int, int, int, int) {
    return (
      OptMgrSettlementAsset,
      OptMgrInitialized,
      OptMgrNextTemplateId,
      OptMgrNextSeriesId,
      OptMgrExpiryJobId,
      OptMgrSettlementJobId,
      OptMgrAutomationCadence,
      OptMgrAutomationBacklogCap,
      OptMgrWithdrawalOnly
    );
  }

  view fn template_state(int template_id) -> (int, int, int, int, int, int, int, int) {
    let exists = OptMgrTemplateKind.contains(template_id) ? 1 : 0;
    return (
      exists,
      OptMgrTemplateKind.get(template_id).unwrap_or(0),
      OptMgrTemplateTenorSlots.get(template_id).unwrap_or(0),
      OptMgrTemplateStrikeBps.get(template_id).unwrap_or(0),
      OptMgrTemplateCollateralMultiplierBps.get(template_id).unwrap_or(0),
      OptMgrTemplateBasePremiumBps.get(template_id).unwrap_or(0),
      OptMgrTemplateActive.get(template_id).unwrap_or(0),
      OptMgrInitialized
    );
  }

  view fn series_state(int series_id) -> (
    int,
    int,
    int,
    int,
    quantity,
    int,
    int,
    int,
    int,
    int,
    int
  ) {
    let exists = OptMgrSeriesTemplateId.contains(series_id) ? 1 : 0;
    return (
      exists,
      OptMgrSeriesTemplateId.get(series_id).unwrap_or(0),
      OptMgrSeriesKind.get(series_id).unwrap_or(0),
      OptMgrSeriesExpirySlot.get(series_id).unwrap_or(0),
      OptMgrSeriesMaxNotional.get(series_id).unwrap_or(zero_quantity()),
      OptMgrSeriesPremiumBps.get(series_id).unwrap_or(0),
      OptMgrSeriesStrikeBps.get(series_id).unwrap_or(0),
      OptMgrSeriesCollateralMultiplierBps.get(series_id).unwrap_or(0),
      OptMgrSeriesStatus.get(series_id).unwrap_or(0),
      OptMgrSeriesSettlementSlot.get(series_id).unwrap_or(0),
      OptMgrSeriesAttestationHash.get(series_id).unwrap_or(0)
    );
  }

  view fn series_settlement(int series_id) -> (decimal, decimal, int, int) {
    assert_series_exists(series_id: series_id);
    return (
      OptMgrSeriesFinalMark.get(series_id).unwrap_or(zero_decimal()),
      OptMgrSeriesFinalQuoteMark.get(series_id).unwrap_or(zero_decimal()),
      OptMgrSeriesOracleSlot.get(series_id).unwrap_or(-1),
      OptMgrSeriesAttestationHash.get(series_id).unwrap_or(0)
    );
  }

  view fn automation_state() -> (int, int, int, int, int, int, int) {
    return (
      OptMgrInitialized,
      OptMgrExpiryJobId,
      OptMgrSettlementJobId,
      OptMgrAutomationCadence,
      OptMgrAutomationBacklogCap,
      OptMgrAutomationBacklog,
      OptMgrAutomationSafeMode
    );
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      OptMgrLifecycleEnabled,
      OptMgrLifecycleCadenceSlots,
      OptMgrLifecycleMaxItems,
      OptMgrLifecycleNextSlot,
      OptMgrLifecycleCursor,
      OptMgrLifecycleLastSlot,
      OptMgrLifecycleLastProcessed
    );
  }
}
