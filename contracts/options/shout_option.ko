seiyaku ShoutOption {
  error enum ShoutOptionError {
    InvalidExpiry = 4023744957,
    InvalidMark = 380842207,
    InvalidNotional = 1928954046,
    InvalidOracleScheme = 1474311732,
    InvalidOracleSlot = 3565780252,
    InvalidOracleStaleSlots = 3102299734,
    InvalidStrike = 4094971969,
    MissingAttestation = 2337340976,
    OracleDegraded = 1708865256,
    OracleDomainMismatch = 178003288,
    OraclePositionMismatch = 1683878401,
    OracleSchemeMissing = 110947573,
    OracleSignature = 1546989046,
    OracleSlotReplay = 127690675,
    OracleStale = 3761902256,
    PositionExists = 981894552,
    PositionInactive = 3980149945,
    PositionMissing = 3917543018,
    PositionOwnerMismatch = 2715695366,
    ProductControllerMismatch = 275683600,
    ProductInitialized = 2974071734,
    ProductNotInitialized = 3176388179,
    ProductOwnerMismatch = 3527590273,
    SeriesLive = 2275309761,
    SeriesMissing = 3910455899,
    WithdrawalOnly = 2082914943,
  }

  state int ShoutInitialized;
  state AccountId ShoutOwner;
  state AccountId ShoutController;
  state AccountId ShoutGuardian;
  state int ShoutWithdrawalOnly;
  state bytes ShoutOraclePublicKey;
  state int ShoutOracleScheme;
  state int ShoutOracleStaleSlots;

  state StateMap<int, int> ShoutSeriesExpirySlot;
  state StateMap<int, int> ShoutSeriesStatus;
  state StateMap<int, int> ShoutSeriesStrikeBps;

  state StateMap<int, AccountId> ShoutPositionOwner;
  state StateMap<int, int> ShoutPositionSeriesId;
  state StateMap<int, int> ShoutPositionNotional;
  state StateMap<int, int> ShoutPositionStrikeBps;
  state StateMap<int, int> ShoutPositionShoutFloor;
  state StateMap<int, int> ShoutPositionLastOracleMark;
  state StateMap<int, int> ShoutPositionLastOracleSlot;
  state StateMap<int, int> ShoutPositionLastAttestationHash;
  state StateMap<int, int> ShoutPositionPayout;
  state StateMap<int, int> ShoutPositionStatus;

  fn assert_initialized() {
    require(ShoutInitialized == 1, ShoutOptionError::ProductNotInitialized);
  }

  fn assert_owner() {
    assert_initialized();
    require(ShoutOwner == context::authority(), ShoutOptionError::ProductOwnerMismatch);
  }

  fn assert_owner_or_controller() {
    assert_initialized();
    if ShoutOwner == context::authority() {
      return;
    }
    require(ShoutController == context::authority(), ShoutOptionError::ProductControllerMismatch);
  }

  fn assert_position_exists(int position_id) {
    require(ShoutPositionOwner.contains(position_id), ShoutOptionError::PositionMissing);
  }

  fn assert_position_owner(int position_id) {
    assert_position_exists(position_id);
    require(ShoutPositionOwner[position_id] == context::authority(), ShoutOptionError::PositionOwnerMismatch);
  }

  fn assert_position_operator(int position_id) {
    assert_position_exists(position_id);
    if ShoutPositionOwner[position_id] == context::authority() {
      return;
    }
    assert_owner_or_controller();
  }

  fn max_int(int a, int b) -> int {
    if a >= b {
      return a;
    }
    return b;
  }

  fn shout_oracle_domain() -> int {
    return 3;
  }

  fn default_oracle_stale_slots() -> int {
    return 4;
  }

  fn assert_oracle_fresh(int current_slot, int oracle_slot, int stale_slots) {
    require(oracle_slot >= 0, ShoutOptionError::InvalidOracleSlot);
    require(stale_slots >= 0, ShoutOptionError::InvalidOracleStaleSlots);
    require(current_slot - oracle_slot <= stale_slots, ShoutOptionError::OracleStale);
  }

  fn assert_verified_shout_payload(int position_id,
                                   bytes oracle_payload,
                                   bytes oracle_signature) -> (int, int, int) {
    assert_position_exists(position_id);
    require(ShoutOracleScheme > 0, ShoutOptionError::OracleSchemeMissing);
    require(crypto::verify_signature(message: oracle_payload, signature: oracle_signature, public_key: ShoutOraclePublicKey, scheme: ShoutOracleScheme), ShoutOptionError::OracleSignature);
    let payload = codec::decode_json(oracle_payload);
    require(payload.get_int(Name::parse("domain")) == shout_oracle_domain(), ShoutOptionError::OracleDomainMismatch);
    require(payload.get_int(Name::parse("position_id")) == position_id, ShoutOptionError::OraclePositionMismatch);
    let mark_price_bps = payload.get_int(Name::parse("mark_price_bps"));
    let oracle_slot = payload.get_int(Name::parse("oracle_slot"));
    let status_flags = payload.get_int(Name::parse("status_flags"));
    let attestation_hash = payload.get_int(Name::parse("attestation_hash"));
    let current_slot = context::block_height();
    require(mark_price_bps >= 0, ShoutOptionError::InvalidMark);
    require(current_slot >= oracle_slot, ShoutOptionError::InvalidOracleSlot);
    assert_oracle_fresh(current_slot, oracle_slot, ShoutOracleStaleSlots);
    let prior_oracle_slot = ShoutPositionLastOracleSlot.get_or(position_id, 0);
    if prior_oracle_slot > 0 {
      require(oracle_slot > prior_oracle_slot, ShoutOptionError::OracleSlotReplay);
    }
    require(status_flags == 0, ShoutOptionError::OracleDegraded);
    require(attestation_hash > 0, ShoutOptionError::MissingAttestation);
    return (mark_price_bps, oracle_slot, attestation_hash);
  }

  fn option_registered(int position_id) -> int {
    if ShoutPositionOwner.contains(position_id) {
      return 1;
    }
    return 0;
  }

  fn record_shout_values(int position_id,
                         int mark_price_bps,
                         int oracle_slot,
                         int attestation_hash) {
    assert_initialized();
    assert_owner_or_controller();
    assert_position_exists(position_id);
    require(ShoutPositionStatus.get_or(position_id, 0) == 1, ShoutOptionError::PositionInactive);
    require(mark_price_bps >= 0, ShoutOptionError::InvalidMark);
    require(oracle_slot >= 0, ShoutOptionError::InvalidOracleSlot);
    require(attestation_hash > 0, ShoutOptionError::MissingAttestation);
    let current_slot = context::block_height();
    require(current_slot >= oracle_slot, ShoutOptionError::InvalidOracleSlot);
    assert_oracle_fresh(current_slot, oracle_slot, ShoutOracleStaleSlots);
    let prior_oracle_slot = ShoutPositionLastOracleSlot.get_or(position_id, 0);
    if prior_oracle_slot > 0 {
      require(oracle_slot > prior_oracle_slot, ShoutOptionError::OracleSlotReplay);
    }
    let next_floor = max_int(ShoutPositionShoutFloor.get_or(position_id, 0), mark_price_bps);
    ShoutPositionShoutFloor[position_id] = next_floor;
    ShoutPositionLastOracleMark[position_id] = mark_price_bps;
    ShoutPositionLastOracleSlot[position_id] = oracle_slot;
    ShoutPositionLastAttestationHash[position_id] = attestation_hash;
  }

  fn exercise_position_values(int position_id,
                              int mark_price_bps,
                              int oracle_slot,
                              int attestation_hash) -> int {
    assert_initialized();
    assert_owner_or_controller();
    assert_position_exists(position_id);
    require(ShoutPositionStatus.get_or(position_id, 0) == 1, ShoutOptionError::PositionInactive);
    require(mark_price_bps >= 0, ShoutOptionError::InvalidMark);
    require(oracle_slot >= 0, ShoutOptionError::InvalidOracleSlot);
    require(attestation_hash > 0, ShoutOptionError::MissingAttestation);
    let current_slot = context::block_height();
    require(current_slot >= oracle_slot, ShoutOptionError::InvalidOracleSlot);
    assert_oracle_fresh(current_slot, oracle_slot, ShoutOracleStaleSlots);
    let prior_oracle_slot = ShoutPositionLastOracleSlot.get_or(position_id, 0);
    if prior_oracle_slot > 0 {
      require(oracle_slot > prior_oracle_slot, ShoutOptionError::OracleSlotReplay);
    }
    let strike_bps = ShoutPositionStrikeBps.get_or(position_id, 0);
    let floor_bps = max_int(ShoutPositionShoutFloor.get_or(position_id, 0), mark_price_bps);
    let intrinsic_bps = floor_bps - strike_bps;
    let payout = 0;
    if intrinsic_bps > 0 {
      payout = (ShoutPositionNotional.get_or(position_id, 0) * intrinsic_bps) / 10_000;
    }
    ShoutPositionLastOracleMark[position_id] = mark_price_bps;
    ShoutPositionLastOracleSlot[position_id] = oracle_slot;
    ShoutPositionLastAttestationHash[position_id] = attestation_hash;
    ShoutPositionPayout[position_id] = payout;
    ShoutPositionStatus[position_id] = 2;
    return payout;
  }

  kotoage fn main() -> int authorize("AssetOps") {
    return ShoutInitialized;
  }

  kotoage fn init_product(AccountId guardian,
                          bytes oracle_public_key,
                          int oracle_scheme) authorize("AssetOps") {
    require(ShoutInitialized == 0, ShoutOptionError::ProductInitialized);
    require(oracle_scheme > 0, ShoutOptionError::InvalidOracleScheme);
    ShoutInitialized = 1;
    ShoutOwner = context::authority();
    ShoutController = context::authority();
    ShoutGuardian = guardian;
    ShoutOraclePublicKey = oracle_public_key;
    ShoutOracleScheme = oracle_scheme;
    ShoutOracleStaleSlots = default_oracle_stale_slots();
    ShoutWithdrawalOnly = 1;
  }

  kotoage fn bind_controller(AccountId controller) authorize("AssetOps") {
    assert_owner();
    ShoutController = controller;
  }

  kotoage fn configure_oracle_stale_slots(int oracle_stale_slots) authorize("AssetOps") {
    assert_owner();
    require(oracle_stale_slots >= 0, ShoutOptionError::InvalidOracleStaleSlots);
    ShoutOracleStaleSlots = oracle_stale_slots;
  }

  kotoage fn enter_withdrawal_only() authorize("AssetOps") {
    assert_owner();
    ShoutWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("AssetOps") {
    assert_owner();
    ShoutWithdrawalOnly = 0;
  }

  kotoage fn sync_series(int series_id,
                         int expiry_slot,
                         int strike_bps) authorize("AssetOps") {
    assert_owner_or_controller();
    require(expiry_slot >= 0, ShoutOptionError::InvalidExpiry);
    require(strike_bps > 0, ShoutOptionError::InvalidStrike);
    ShoutSeriesExpirySlot[series_id] = expiry_slot;
    ShoutSeriesStatus[series_id] = ShoutSeriesStatus.ensure(series_id, 1);
    ShoutSeriesStrikeBps[series_id] = strike_bps;
  }

  kotoage fn sync_series_c2c(int series_id,
                             int expiry_slot,
                             int strike_bps) -> int authorize("AssetOps") {
    sync_series(series_id, expiry_slot, strike_bps);
    return 1;
  }

  kotoage fn register_position(int position_id,
                               int series_id,
                               AccountId owner,
                               int notional,
                               int strike_bps) authorize("AssetOps") {
    assert_initialized();
    assert_owner_or_controller();
    require(ShoutWithdrawalOnly == 0, ShoutOptionError::WithdrawalOnly);
    require(!ShoutPositionOwner.contains(position_id), ShoutOptionError::PositionExists);
    require(notional > 0, ShoutOptionError::InvalidNotional);
    ShoutPositionOwner[position_id] = owner;
    ShoutPositionSeriesId[position_id] = series_id;
    ShoutPositionNotional[position_id] = notional;
    ShoutPositionStrikeBps[position_id] = strike_bps;
    ShoutPositionShoutFloor[position_id] = 0;
    ShoutPositionLastOracleMark[position_id] = 0;
    ShoutPositionLastOracleSlot[position_id] = 0;
    ShoutPositionLastAttestationHash[position_id] = 0;
    ShoutPositionPayout[position_id] = 0;
    ShoutPositionStatus[position_id] = 1;
  }

  kotoage fn register_position_c2c(int position_id,
                                   int series_id,
                                   AccountId owner,
                                   int notional,
                                   int strike_bps) -> int authorize("AssetOps") {
    register_position(position_id, series_id, owner, notional, strike_bps);
    return 1;
  }

  kotoage fn record_shout(int position_id,
                          bytes oracle_payload,
                          bytes oracle_signature) authorize("AssetOps") {
    assert_initialized();
    assert_position_operator(position_id);
    require(ShoutPositionStatus.get_or(position_id, 0) == 1, ShoutOptionError::PositionInactive);
    let oracle = assert_verified_shout_payload(position_id, oracle_payload, oracle_signature);
    let mark_price_bps = oracle.0;
    let oracle_slot = oracle.1;
    let attestation_hash = oracle.2;
    let next_floor = max_int(ShoutPositionShoutFloor.get_or(position_id, 0), mark_price_bps);
    ShoutPositionShoutFloor[position_id] = next_floor;
    ShoutPositionLastOracleMark[position_id] = mark_price_bps;
    ShoutPositionLastOracleSlot[position_id] = oracle_slot;
    ShoutPositionLastAttestationHash[position_id] = attestation_hash;
  }

  kotoage fn record_shout_c2c(int position_id,
                              int mark_price_bps,
                              int oracle_slot,
                              int attestation_hash) -> int authorize("AssetOps") {
    record_shout_values(position_id, mark_price_bps, oracle_slot, attestation_hash);
    return 1;
  }

  kotoage fn exercise_position(int position_id,
                               bytes oracle_payload,
                               bytes oracle_signature) -> int authorize("AssetOps") {
    assert_initialized();
    assert_position_operator(position_id);
    require(ShoutPositionStatus.get_or(position_id, 0) == 1, ShoutOptionError::PositionInactive);
    let oracle = assert_verified_shout_payload(position_id, oracle_payload, oracle_signature);
    let mark_price_bps = oracle.0;
    let oracle_slot = oracle.1;
    let attestation_hash = oracle.2;
    let strike_bps = ShoutPositionStrikeBps.get_or(position_id, 0);
    let floor_bps = max_int(ShoutPositionShoutFloor.get_or(position_id, 0), mark_price_bps);
    let intrinsic_bps = floor_bps - strike_bps;
    let payout = 0;
    if intrinsic_bps > 0 {
      payout = (ShoutPositionNotional.get_or(position_id, 0) * intrinsic_bps) / 10_000;
    }
    ShoutPositionLastOracleMark[position_id] = mark_price_bps;
    ShoutPositionLastOracleSlot[position_id] = oracle_slot;
    ShoutPositionLastAttestationHash[position_id] = attestation_hash;
    ShoutPositionPayout[position_id] = payout;
    ShoutPositionStatus[position_id] = 2;
    return payout;
  }

  kotoage fn exercise_position_c2c(int position_id,
                                   int mark_price_bps,
                                   int oracle_slot,
                                   int attestation_hash) -> int authorize("AssetOps") {
    return exercise_position_values(position_id, mark_price_bps, oracle_slot, attestation_hash);
  }

  kotoage fn expire_series(int series_id) authorize("AssetOps") {
    assert_owner_or_controller();
    require(ShoutSeriesExpirySlot.contains(series_id), ShoutOptionError::SeriesMissing);
    let current_slot = context::block_height();
    require(current_slot >= ShoutSeriesExpirySlot[series_id], ShoutOptionError::SeriesLive);
    ShoutSeriesStatus[series_id] = 3;
  }

  view fn series_state(int series_id) -> (int, int, int, int) {
    let registered = 0;
    if ShoutSeriesExpirySlot.contains(series_id) {
      registered = 1;
    }
    return (
      registered,
      ShoutSeriesExpirySlot.get_or(series_id, 0),
      ShoutSeriesStrikeBps.get_or(series_id, 0),
      ShoutSeriesStatus.get_or(series_id, 0)
    );
  }

  view fn position_state(int position_id) -> (int, int, int, int, int, int, int, int) {
    return (
      option_registered(position_id),
      ShoutPositionSeriesId.get_or(position_id, 0),
      ShoutPositionNotional.get_or(position_id, 0),
      ShoutPositionStrikeBps.get_or(position_id, 0),
      ShoutPositionShoutFloor.get_or(position_id, 0),
      ShoutPositionLastOracleMark.get_or(position_id, 0),
      ShoutPositionPayout.get_or(position_id, 0),
      ShoutPositionStatus.get_or(position_id, 0)
    );
  }

  view fn oracle_stale_slots() -> int {
    assert_initialized();
    return ShoutOracleStaleSlots;
  }
}
