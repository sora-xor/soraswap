// Accounting mirror for option collateral, premium, and payout flows.
// Asset custody remains in the canonical risk vault; every financial field is
// a Kotodama V1 `quantity` so host and contract arithmetic share one domain.

seiyaku OptionsVault {
  error enum OptionsVaultError {
    VaultOwnerMismatch = 1,
    VaultControllerMismatch = 2,
    WithdrawalOnly = 3,
    PositionExists = 4,
    PositionMissing = 5,
    PositionOwnerMismatch = 6,
    PositionInactive = 7,
    ReleaseExceedsCollateral = 8,
    PayoutExceedsCollateral = 9,
    PremiumBurnExceedsPremium = 10,
    SeriesCollateralInvariant = 11,
    SeriesPremiumInvariant = 12,
  }

  state int OptVaultInitialized;
  state AccountId OptVaultOwner;
  state AssetDefinitionId OptVaultSettlementAsset;
  state AccountId OptVaultController;
  state bytes OptVaultRiskVaultContract;
  state int OptVaultWithdrawalOnly;

  state StateMap<int, quantity> OptVaultSeriesCollateralLocked;
  state StateMap<int, quantity> OptVaultSeriesPremiumAccrued;
  state StateMap<int, quantity> OptVaultSeriesPayoutPaid;

  state StateMap<int, AccountId> OptVaultPositionOwner;
  state StateMap<int, int> OptVaultPositionSeriesId;
  state StateMap<int, quantity> OptVaultPositionCollateralLocked;
  state StateMap<int, quantity> OptVaultPositionPremiumPaid;
  state StateMap<int, quantity> OptVaultPositionPayoutPaid;
  state StateMap<int, int> OptVaultPositionStatus;

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn assert_owner() {
    require(OptVaultOwner == context::authority(), OptionsVaultError::VaultOwnerMismatch);
  }

  fn assert_owner_or_controller() {
    if OptVaultOwner == context::authority() {
      return;
    }
    require(
      OptVaultController == context::authority(),
      OptionsVaultError::VaultControllerMismatch
    );
  }

  fn assert_position_exists(int position_id) {
    require(OptVaultPositionOwner.contains(position_id), OptionsVaultError::PositionMissing);
    require(OptVaultPositionSeriesId.contains(position_id), OptionsVaultError::PositionMissing);
  }

  fn position_owner_value(int position_id) -> AccountId {
    assert_position_exists(position_id);
    return OptVaultPositionOwner.get(position_id).unwrap_or(context::authority());
  }

  fn position_series_value(int position_id) -> int {
    assert_position_exists(position_id);
    return OptVaultPositionSeriesId.get(position_id).unwrap_or(0);
  }

  fn position_collateral_value(int position_id) -> quantity {
    return OptVaultPositionCollateralLocked.get(position_id).unwrap_or(zero_quantity());
  }

  fn position_premium_value(int position_id) -> quantity {
    return OptVaultPositionPremiumPaid.get(position_id).unwrap_or(zero_quantity());
  }

  fn position_payout_value(int position_id) -> quantity {
    return OptVaultPositionPayoutPaid.get(position_id).unwrap_or(zero_quantity());
  }

  fn position_status_value(int position_id) -> int {
    return OptVaultPositionStatus.get(position_id).unwrap_or(0);
  }

  fn series_collateral_value(int series_id) -> quantity {
    return OptVaultSeriesCollateralLocked.get(series_id).unwrap_or(zero_quantity());
  }

  fn series_premium_value(int series_id) -> quantity {
    return OptVaultSeriesPremiumAccrued.get(series_id).unwrap_or(zero_quantity());
  }

  fn series_payout_value(int series_id) -> quantity {
    return OptVaultSeriesPayoutPaid.get(series_id).unwrap_or(zero_quantity());
  }

  fn sync_series_impl(int series_id) {
    if !OptVaultSeriesCollateralLocked.contains(series_id) {
      OptVaultSeriesCollateralLocked[series_id] = zero_quantity();
      OptVaultSeriesPremiumAccrued[series_id] = zero_quantity();
      OptVaultSeriesPayoutPaid[series_id] = zero_quantity();
    }
  }

  fn record_position_impl(
    int position_id,
    int series_id,
    AccountId owner,
    quantity collateral_locked,
    quantity premium_paid
  ) {
    assert_owner_or_controller();
    require(OptVaultWithdrawalOnly == 0, OptionsVaultError::WithdrawalOnly);
    require(!OptVaultPositionOwner.contains(position_id), OptionsVaultError::PositionExists);
    sync_series_impl(series_id);
    OptVaultPositionOwner[position_id] = owner;
    OptVaultPositionSeriesId[position_id] = series_id;
    OptVaultPositionCollateralLocked[position_id] = collateral_locked;
    OptVaultPositionPremiumPaid[position_id] = premium_paid;
    OptVaultPositionPayoutPaid[position_id] = zero_quantity();
    OptVaultPositionStatus[position_id] = 1;
    OptVaultSeriesCollateralLocked[series_id] =
      series_collateral_value(series_id) + collateral_locked;
    OptVaultSeriesPremiumAccrued[series_id] =
      series_premium_value(series_id) + premium_paid;
  }

  fn settle_position_impl(
    int position_id,
    quantity payout,
    quantity premium_burn
  ) {
    assert_owner_or_controller();
    assert_position_exists(position_id);
    require(position_status_value(position_id) == 1, OptionsVaultError::PositionInactive);
    let series_id = position_series_value(position_id);
    let locked = position_collateral_value(position_id);
    let premium = position_premium_value(position_id);
    let series_collateral = series_collateral_value(series_id);
    let series_premium = series_premium_value(series_id);
    require(locked >= payout, OptionsVaultError::PayoutExceedsCollateral);
    require(premium >= premium_burn, OptionsVaultError::PremiumBurnExceedsPremium);
    require(series_collateral >= payout, OptionsVaultError::SeriesCollateralInvariant);
    require(series_premium >= premium_burn, OptionsVaultError::SeriesPremiumInvariant);
    OptVaultPositionCollateralLocked[position_id] = locked - payout;
    OptVaultPositionPremiumPaid[position_id] = premium - premium_burn;
    OptVaultPositionPayoutPaid[position_id] = position_payout_value(position_id) + payout;
    OptVaultPositionStatus[position_id] = 2;
    OptVaultSeriesCollateralLocked[series_id] = series_collateral - payout;
    OptVaultSeriesPremiumAccrued[series_id] = series_premium - premium_burn;
    OptVaultSeriesPayoutPaid[series_id] = series_payout_value(series_id) + payout;
  }

  hajimari(AssetDefinitionId settlement_asset, bytes risk_vault_contract) {
    OptVaultInitialized = 1;
    OptVaultOwner = context::authority();
    OptVaultSettlementAsset = settlement_asset;
    OptVaultController = context::authority();
    OptVaultRiskVaultContract = risk_vault_contract;
    OptVaultWithdrawalOnly = 1;
  }

  view fn main() -> int {
    return OptVaultInitialized;
  }

  kotoage fn bind_controller(AccountId controller) authorize("Admin") {
    assert_owner();
    OptVaultController = controller;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner();
    OptVaultWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    OptVaultWithdrawalOnly = 0;
  }

  kotoage fn sync_series(int series_id) authorize("Entry") {
    assert_owner_or_controller();
    sync_series_impl(series_id);
  }

  kotoage fn sync_series_c2c(int series_id) -> int authorize("Entry") {
    assert_owner_or_controller();
    sync_series_impl(series_id);
    return 1;
  }

  kotoage fn record_position(
    int position_id,
    int series_id,
    AccountId owner,
    quantity collateral_locked,
    quantity premium_paid
  ) authorize("Entry") {
    record_position_impl(
      position_id: position_id,
      series_id: series_id,
      owner: owner,
      collateral_locked: collateral_locked,
      premium_paid: premium_paid
    );
  }

  kotoage fn record_position_c2c(
    int position_id,
    int series_id,
    AccountId owner,
    quantity collateral_locked,
    quantity premium_paid
  ) -> int authorize("Entry") {
    record_position_impl(
      position_id: position_id,
      series_id: series_id,
      owner: owner,
      collateral_locked: collateral_locked,
      premium_paid: premium_paid
    );
    return 1;
  }

  kotoage fn release_position(
    int position_id,
    quantity collateral_release
  ) authorize("Entry") {
    assert_owner_or_controller();
    assert_position_exists(position_id);
    let series_id = position_series_value(position_id);
    let locked = position_collateral_value(position_id);
    let series_collateral = series_collateral_value(series_id);
    require(locked >= collateral_release, OptionsVaultError::ReleaseExceedsCollateral);
    require(
      series_collateral >= collateral_release,
      OptionsVaultError::SeriesCollateralInvariant
    );
    OptVaultPositionCollateralLocked[position_id] = locked - collateral_release;
    OptVaultSeriesCollateralLocked[series_id] = series_collateral - collateral_release;
  }

  kotoage fn settle_position(
    int position_id,
    quantity payout,
    quantity premium_burn
  ) authorize("Entry") {
    settle_position_impl(
      position_id: position_id,
      payout: payout,
      premium_burn: premium_burn
    );
  }

  kotoage fn settle_position_c2c(
    int position_id,
    quantity payout,
    quantity premium_burn
  ) -> int authorize("Entry") {
    settle_position_impl(
      position_id: position_id,
      payout: payout,
      premium_burn: premium_burn
    );
    return 1;
  }

  view fn vault_state(int series_id) -> (int, quantity, quantity, quantity, int) {
    return (
      OptVaultInitialized,
      series_collateral_value(series_id),
      series_premium_value(series_id),
      series_payout_value(series_id),
      OptVaultWithdrawalOnly
    );
  }

  view fn position_accounting(int position_id) -> (
    int,
    int,
    quantity,
    quantity,
    quantity,
    int
  ) {
    let registered = OptVaultPositionOwner.contains(position_id) ? 1 : 0;
    return (
      registered,
      OptVaultPositionSeriesId.get(position_id).unwrap_or(0),
      position_collateral_value(position_id),
      position_premium_value(position_id),
      position_payout_value(position_id),
      position_status_value(position_id)
    );
  }

  view fn position_owner(int position_id) -> AccountId {
    return position_owner_value(position_id);
  }
}
