// Generic SCCP bridge registry and settlement surface for Sora Nexus.
// The bridge is hub-oriented: remote routes terminate on Nexus and use
// canonical-home lock/release for Sora-origin assets and wrapped burn/mint for
// remote-origin assets.

seiyaku SccpBridge {
  state int BridgeInitialized;
  state AccountId BridgeOwner;
  state AccountId BridgeProofAuthority;
  state int RegistryEnabled;
  state AssetDefinitionId ListingFeeAsset;
  state AccountId TreasuryAccount;
  state int ListingFeeAmount;

  state RegisteredAsset: Map<Name, AssetDefinitionId>;
  state AssetHomeDomain: Map<Name, int>;
  state AssetDecimals: Map<Name, int>;
  state AssetListingPaid: Map<Name, int>;
  state AssetVaultAccount: Map<Name, AccountId>;

  state RouteOwner: Map<Name, AccountId>;
  state RouteAssetKey: Map<Name, Name>;
  state RouteRemoteDomain: Map<Name, int>;
  state RouteLocalAsset: Map<Name, AssetDefinitionId>;
  state RouteVaultAccount: Map<Name, AccountId>;
  state RouteEnabled: Map<Name, int>;
  state RouteGoverned: Map<Name, int>;
  state RouteGovernanceMessage: Map<Name, Name>;
  state NextOutboundNonce: Map<Name, int>;

  state OutboundRoute: Map<Name, Name>;
  state OutboundSender: Map<Name, AccountId>;
  state OutboundRecipient: Map<Name, Name>;
  state OutboundAmount: Map<Name, int>;
  state OutboundNonce: Map<Name, int>;
  state OutboundStatus: Map<Name, int>;

  state ConsumedInbound: Map<Name, int>;

  fn sora_domain() -> int {
    return 0;
  }

  fn assert_initialized() {
    assert(BridgeInitialized == 1, "bridge not initialized");
  }

  fn assert_owner() {
    assert_initialized();
    assert(BridgeOwner == authority(), "bridge owner mismatch");
  }

  fn assert_proof_authority() {
    assert_initialized();
    assert(BridgeProofAuthority == authority(), "bridge proof authority mismatch");
  }

  fn assert_asset_exists(asset_key: Name) {
    assert(RegisteredAsset.contains(asset_key), "asset missing");
  }

  fn assert_route_exists(route: Name) {
    assert(RouteAssetKey.contains(route), "route missing");
  }

  fn assert_route_owner(route: Name) {
    assert_route_exists(route);
    assert(RouteOwner[route] == authority(), "route owner mismatch");
  }

  fn assert_route_not_governed(route: Name) {
    assert(RouteGoverned.get_or(route, 0) == 0, "governed route is proof-managed");
  }

  fn assert_asset_vault_bound(asset_key: Name) {
    assert(AssetVaultAccount.contains(asset_key), "asset vault missing");
  }

  fn route_message_or_self(route: Name) -> Name {
    if RouteGovernanceMessage.contains(route) {
      return RouteGovernanceMessage[route];
    }
    return route;
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  fn charge_listing_fee(registrant: AccountId) {
    let fee_amount = ListingFeeAmount;
    if fee_amount > 0 {
      move_asset_if_needed(registrant, TreasuryAccount, ListingFeeAsset, fee_amount);
    }
  }

  fn spend_outbound(route: Name,
                    sender: AccountId,
                    amount: int) {
    let asset_key = RouteAssetKey[route];
    let local_asset = RouteLocalAsset[route];
    let vault = RouteVaultAccount[route];
    if AssetHomeDomain[asset_key] == sora_domain() {
      move_asset_if_needed(sender, vault, local_asset, amount);
    } else {
      burn_asset(sender, local_asset, amount);
    }
  }

  fn settle_inbound(route: Name,
                    recipient: AccountId,
                    amount: int) {
    let asset_key = RouteAssetKey[route];
    let local_asset = RouteLocalAsset[route];
    let vault = RouteVaultAccount[route];
    if AssetHomeDomain[asset_key] == sora_domain() {
      move_asset_if_needed(vault, recipient, local_asset, amount);
    } else {
      mint_asset(recipient, local_asset, amount);
    }
  }

  fn store_route(route: Name,
                 asset_key: Name,
                 remote_domain: int,
                 local_asset: AssetDefinitionId,
                 vault_account: AccountId,
                 governed: int,
                 governance_message: Name) {
    RouteOwner[route] = authority();
    RouteAssetKey[route] = asset_key;
    RouteRemoteDomain[route] = remote_domain;
    RouteLocalAsset[route] = local_asset;
    RouteVaultAccount[route] = vault_account;
    RouteEnabled[route] = 1;
    RouteGoverned[route] = governed;
    RouteGovernanceMessage[route] = governance_message;
    if NextOutboundNonce.get_or(route, 0) <= 0 {
      NextOutboundNonce[route] = 1;
    }
  }

  kotoage fn main() -> int {
    return BridgeInitialized;
  }

  kotoage fn init_bridge(listing_fee_asset: AssetDefinitionId,
                         treasury: AccountId,
                         listing_fee_amount: int,
                         proof_authority: AccountId) {
    assert(BridgeInitialized == 0, "bridge initialized");
    assert(listing_fee_amount >= 0, "invalid listing fee");
    BridgeOwner = authority();
    BridgeProofAuthority = proof_authority;
    ListingFeeAsset = listing_fee_asset;
    TreasuryAccount = treasury;
    ListingFeeAmount = listing_fee_amount;
    RegistryEnabled = 1;
    BridgeInitialized = 1;
  }

  kotoage fn set_proof_authority(proof_authority: AccountId) {
    assert_owner();
    BridgeProofAuthority = proof_authority;
  }

  kotoage fn register_asset(asset_key: Name,
                            asset: AssetDefinitionId,
                            home_domain: int,
                            decimals: int) permission(AssetOps) {
    assert_initialized();
    assert(RegistryEnabled == 1, "registry disabled");
    assert(!RegisteredAsset.contains(asset_key), "asset exists");
    assert(home_domain >= 0, "invalid home domain");
    assert(decimals >= 0, "invalid decimals");
    charge_listing_fee(authority());
    RegisteredAsset[asset_key] = asset;
    AssetHomeDomain[asset_key] = home_domain;
    AssetDecimals[asset_key] = decimals;
    AssetListingPaid[asset_key] = ListingFeeAmount;
  }

  kotoage fn bind_asset_vault(asset_key: Name,
                              vault_account: AccountId) permission(AssetOps) {
    assert_initialized();
    assert_asset_exists(asset_key);
    if AssetVaultAccount.contains(asset_key) {
      assert(AssetVaultAccount[asset_key] == vault_account, "asset vault mismatch");
      return;
    }
    AssetVaultAccount[asset_key] = vault_account;
  }

  kotoage fn activate_route(route: Name,
                            asset_key: Name,
                            remote_domain: int,
                            local_asset: AssetDefinitionId,
                            vault_account: AccountId) {
    assert_initialized();
    assert_asset_exists(asset_key);
    assert(!RouteAssetKey.contains(route), "route exists");
    assert(remote_domain >= 0, "invalid remote domain");
    store_route(route, asset_key, remote_domain, local_asset, vault_account, 0, route);
  }

  kotoage fn activate_route_governed(message_id: Name,
                                     route: Name,
                                     asset_key: Name,
                                     remote_domain: int) {
    assert_initialized();
    assert_proof_authority();
    assert_asset_exists(asset_key);
    assert_asset_vault_bound(asset_key);
    assert(remote_domain >= 0, "invalid remote domain");

    let local_asset = RegisteredAsset[asset_key];
    let vault_account = AssetVaultAccount[asset_key];
    if RouteAssetKey.contains(route) {
      assert(RouteAssetKey[route] == asset_key, "route asset mismatch");
      assert(RouteRemoteDomain[route] == remote_domain, "route remote mismatch");
      assert(RouteLocalAsset[route] == local_asset, "route local asset mismatch");
      assert(RouteVaultAccount[route] == vault_account, "route vault mismatch");
    }
    store_route(route, asset_key, remote_domain, local_asset, vault_account, 1, message_id);
  }

  kotoage fn pause_route(route: Name) {
    assert_route_owner(route);
    assert_route_not_governed(route);
    RouteEnabled[route] = 0;
  }

  kotoage fn resume_route(route: Name) {
    assert_route_owner(route);
    assert_route_not_governed(route);
    RouteEnabled[route] = 1;
  }

  kotoage fn lock_to_remote(route: Name,
                            transfer: Name,
                            recipient: Name,
                            amount: int) -> int permission(AssetOps) {
    assert_initialized();
    assert_route_exists(route);
    assert(RouteEnabled[route] == 1, "route disabled");
    assert(!OutboundRoute.contains(transfer), "transfer exists");
    assert(amount > 0, "invalid amount");

    let next_nonce = NextOutboundNonce.get_or(route, 1);
    let sender = authority();
    spend_outbound(route, sender, amount);

    OutboundRoute[transfer] = route;
    OutboundSender[transfer] = sender;
    OutboundRecipient[transfer] = recipient;
    OutboundAmount[transfer] = amount;
    OutboundNonce[transfer] = next_nonce;
    OutboundStatus[transfer] = 1;
    NextOutboundNonce[route] = next_nonce + 1;
    return next_nonce;
  }

  kotoage fn finalize_inbound(route: Name,
                              message_id: Name,
                              recipient: AccountId,
                              amount: int) permission(AssetOps) {
    assert_initialized();
    assert_proof_authority();
    assert_route_exists(route);
    assert(amount > 0, "invalid amount");
    assert(ConsumedInbound.get_or(message_id, 0) == 0, "message consumed");
    settle_inbound(route, recipient, amount);
    ConsumedInbound[message_id] = 1;
  }

  view fn listing_config() -> (AssetDefinitionId, AccountId, int, int) {
    assert_initialized();
    return (
      ListingFeeAsset,
      TreasuryAccount,
      ListingFeeAmount,
      RegistryEnabled
    );
  }

  view fn bridge_authorities() -> (AccountId, AccountId) {
    assert_initialized();
    return (
      BridgeOwner,
      BridgeProofAuthority
    );
  }

  view fn mirror_asset(asset_key: Name) -> (int, int, int, int) {
    let registered = 0;
    if RegisteredAsset.contains(asset_key) {
      registered = 1;
    }
    return (
      registered,
      AssetHomeDomain.get_or(asset_key, 0),
      AssetDecimals.get_or(asset_key, 0),
      AssetListingPaid.get_or(asset_key, 0)
    );
  }

  view fn asset_config(asset_key: Name) -> (AssetDefinitionId, int, int) {
    assert_asset_exists(asset_key);
    return (
      RegisteredAsset[asset_key],
      AssetHomeDomain.get_or(asset_key, 0),
      AssetDecimals.get_or(asset_key, 0)
    );
  }

  view fn asset_vault_bound(asset_key: Name) -> int {
    if AssetVaultAccount.contains(asset_key) {
      return 1;
    }
    return 0;
  }

  view fn asset_vault_account(asset_key: Name) -> AccountId {
    assert_asset_vault_bound(asset_key);
    return AssetVaultAccount[asset_key];
  }

  view fn mirror_route(route: Name) -> (int, int, int, int) {
    let registered = 0;
    if RouteAssetKey.contains(route) {
      registered = 1;
    }
    return (
      registered,
      RouteRemoteDomain.get_or(route, 0),
      RouteEnabled.get_or(route, 0),
      NextOutboundNonce.get_or(route, 0)
    );
  }

  view fn route_config(route: Name) -> (Name, int, AssetDefinitionId, AccountId) {
    assert_route_exists(route);
    return (
      RouteAssetKey[route],
      RouteRemoteDomain.get_or(route, 0),
      RouteLocalAsset[route],
      RouteVaultAccount[route]
    );
  }

  view fn route_provenance(route: Name) -> (int, Name) {
    assert_route_exists(route);
    return (
      RouteGoverned.get_or(route, 0),
      route_message_or_self(route)
    );
  }

  view fn mirror_outbound(transfer: Name) -> (int, int, int, int) {
    let registered = 0;
    if OutboundRoute.contains(transfer) {
      registered = 1;
    }
    return (
      registered,
      OutboundAmount.get_or(transfer, 0),
      OutboundNonce.get_or(transfer, 0),
      OutboundStatus.get_or(transfer, 0)
    );
  }

  view fn outbound_config(transfer: Name) -> (Name, AccountId, Name, int) {
    assert(OutboundRoute.contains(transfer), "transfer missing");
    return (
      OutboundRoute[transfer],
      OutboundSender[transfer],
      OutboundRecipient[transfer],
      OutboundAmount[transfer]
    );
  }

  view fn inbound_consumed(message_id: Name) -> int {
    return ConsumedInbound.get_or(message_id, 0);
  }
}
