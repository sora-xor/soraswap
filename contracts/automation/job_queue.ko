seiyaku JobQueue {
    error enum JobQueueError {
        JobMissing = 1, OwnerMismatch = 2, ExecutorMismatch = 3, RunnerMismatch = 4, JobNotQueued = 5, JobNotReady = 6, RetryLimitReached = 7, JobAlreadyExists = 8, InvalidNextSlot = 9, InvalidMaxRetries = 10, InvalidRetryDelay = 11, InvalidCronInterval = 12, JobNotRunning = 13, InvalidCurrentSlot = 14, JobNotActive = 15, JobNotPaused = 16, JobAlreadyDone = 17, JobAlreadyCancelled = 18, JobNotRetryable = 19, JobNotConfigurable = 20,
    }

    state StateMap<Name, AccountId> JobOwner;
    state StateMap<Name, AccountId> JobExecutor;
    state StateMap<Name, int> JobPayloadHash;
    state StateMap<Name, int> JobStatus;
    state StateMap<Name, int> RetryCount;
    state StateMap<Name, int> JobNextSlot;
    state StateMap<Name, int> JobCronIntervalSlots;
    state StateMap<Name, int> JobMaxRetries;
    state StateMap<Name, int> JobRetryDelaySlots;
    state StateMap<Name, int> JobLastRunSlot;
    state StateMap<Name, int> JobRunCount;
    fn assert_job_exists(Name job) {
        require(JobOwner.contains(key: job), JobQueueError::JobMissing);
    }

    fn assert_job_owner(Name job) {
        assert_job_exists(job: job);
        let owner = JobOwner.get_or(key: job, default: context::authority());
        require(owner == context::authority(), JobQueueError::OwnerMismatch);
    }

    fn assert_job_runner(Name job) {
        assert_job_exists(job: job);
        if JobExecutor.contains(key: job) {
            let executor = JobExecutor.get_or(key: job, default: context::authority());
            require(executor == context::authority(), JobQueueError::ExecutorMismatch);
        } else {
            let owner = JobOwner.get_or(key: job, default: context::authority());
            require(owner == context::authority(), JobQueueError::RunnerMismatch);
        }
    }

    fn assert_job_configurable(Name job) {
        let status = JobStatus.get_or(key: job, default: 0);
        require(status == 1 || status == 4, JobQueueError::JobNotConfigurable);
    }

    fn mark_running_impl(Name job) {
        assert_job_runner(job: job);
        let current_slot = context::block_height();
        require(JobStatus.get_or(key: job, default: 0) == 1, JobQueueError::JobNotQueued);
        require(
            current_slot >= JobNextSlot.get_or(key: job, default: 0),
            JobQueueError::JobNotReady,
        );
        JobStatus[job] = 2;
        JobLastRunSlot[job] = current_slot;
        JobRunCount[job] = JobRunCount.get_or(key: job, default: 0) + 1;
    }

    fn retry_impl(Name job) {
        assert_job_owner(job: job);
        let current_slot = context::block_height();
        let status = JobStatus.get_or(key: job, default: 0);
        require(status == 1 || status == 2 || status == 4, JobQueueError::JobNotRetryable);
        let retries = RetryCount.get_or(key: job, default: 0);
        let max_retries = JobMaxRetries.get_or(key: job, default: 0);
        if max_retries > 0 {
            require(retries < max_retries, JobQueueError::RetryLimitReached);
        }
        JobStatus[job] = 1;
        RetryCount[job] = retries + 1;
        JobNextSlot[job] = current_slot + JobRetryDelaySlots.get_or(key: job, default: 0);
    }

    view fn main() -> int {
        return 1;
    }

    kotoage fn enqueue(Name job, int payload_hash) authorize("Entry") {
        require(!JobOwner.contains(key: job), JobQueueError::JobAlreadyExists);
        JobOwner[job] = context::authority();
        JobPayloadHash[job] = payload_hash;
        JobStatus[job] = 1;
        RetryCount[job] = 0;
        JobNextSlot[job] = 0;
        JobCronIntervalSlots[job] = 0;
        JobMaxRetries[job] = 0;
        JobRetryDelaySlots[job] = 0;
        JobLastRunSlot[job] = 0;
        JobRunCount[job] = 0;
    }

    kotoage fn assign_executor(Name job, AccountId executor) authorize("Entry") {
        assert_job_owner(job: job);
        assert_job_configurable(job: job);
        JobExecutor[job] = executor;
    }

    kotoage fn configure_job(Name job, int next_slot, int max_retries, int retry_delay_slots, ) authorize(
        "Entry"
    ) {
        assert_job_owner(job: job);
        assert_job_configurable(job: job);
        require(next_slot >= 0, JobQueueError::InvalidNextSlot);
        require(max_retries >= 0, JobQueueError::InvalidMaxRetries);
        require(retry_delay_slots >= 0, JobQueueError::InvalidRetryDelay);
        JobNextSlot[job] = next_slot;
        JobMaxRetries[job] = max_retries;
        JobRetryDelaySlots[job] = retry_delay_slots;
    }

    kotoage fn configure_cron(Name job, int interval_slots) authorize("Entry") {
        assert_job_owner(job: job);
        assert_job_configurable(job: job);
        require(interval_slots >= 0, JobQueueError::InvalidCronInterval);
        JobCronIntervalSlots[job] = interval_slots;
    }

    kotoage fn mark_running(Name job) authorize("Entry") {
        mark_running_impl(job: job);
    }

    kotoage fn dispatch_job(Name job) authorize("Entry") {
        mark_running_impl(job: job);
    }

    kotoage fn mark_done(Name job) authorize("Entry") {
        assert_job_runner(job: job);
        require(JobStatus.get_or(key: job, default: 0) == 2, JobQueueError::JobNotRunning);
        JobStatus[job] = 3;
    }

    kotoage fn complete_run(Name job) authorize("Entry") {
        assert_job_runner(job: job);
        let current_slot = context::block_height();
        require(JobStatus.get_or(key: job, default: 0) == 2, JobQueueError::JobNotRunning);
        require(
            current_slot >= JobLastRunSlot.get_or(key: job, default: 0),
            JobQueueError::InvalidCurrentSlot,
        );
        let interval_slots = JobCronIntervalSlots.get_or(key: job, default: 0);
        if interval_slots > 0 {
            JobStatus[job] = 1;
            JobNextSlot[job] = current_slot + interval_slots;
        } else {
            JobStatus[job] = 3;
        }
    }

    kotoage fn retry(Name job) authorize("Entry") {
        retry_impl(job: job);
    }

    kotoage fn pause_job(Name job) authorize("Entry") {
        assert_job_owner(job: job);
        let status = JobStatus.get_or(key: job, default: 0);
        require(status == 1 || status == 2, JobQueueError::JobNotActive);
        JobStatus[job] = 4;
    }

    kotoage fn resume_job(Name job) authorize("Entry") {
        assert_job_owner(job: job);
        require(JobStatus.get_or(key: job, default: 0) == 4, JobQueueError::JobNotPaused);
        JobStatus[job] = 1;
        JobNextSlot[job] = context::block_height();
    }

    kotoage fn cancel_job(Name job) authorize("Entry") {
        assert_job_owner(job: job);
        let status = JobStatus.get_or(key: job, default: 0);
        require(status != 3, JobQueueError::JobAlreadyDone);
        require(status != 5, JobQueueError::JobAlreadyCancelled);
        JobStatus[job] = 5;
    }

    view fn mirror_job(Name job) -> (int, int, int, int, int, int, int, int, int, int, int) {
        var int job_registered = 0;
        var int executor_bound = 0;
        if JobOwner.contains(key: job) {
            job_registered = 1;
        }
        if JobExecutor.contains(key: job) {
            executor_bound = 1;
        }
        return (job_registered, executor_bound, JobPayloadHash.get_or(key: job, default: 0), JobStatus.get_or(
            key: job,
            default: 0,
        ), RetryCount.get_or(key: job, default: 0), JobNextSlot.get_or(key: job, default: 0), JobCronIntervalSlots.get_or(
            key: job,
            default: 0,
        ), JobMaxRetries.get_or(key: job, default: 0), JobRetryDelaySlots.get_or(
            key: job,
            default: 0,
        ), JobLastRunSlot.get_or(key: job, default: 0), JobRunCount.get_or(key: job, default: 0));
    }
}
