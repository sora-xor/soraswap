seiyaku JobQueue {
  state JobOwner: Map<Name, AccountId>;
  state JobExecutor: Map<Name, AccountId>;
  state JobPayloadHash: Map<Name, int>;
  state JobStatus: Map<Name, int>;
  state RetryCount: Map<Name, int>;
  state JobNextSlot: Map<Name, int>;
  state JobCronIntervalSlots: Map<Name, int>;
  state JobMaxRetries: Map<Name, int>;
  state JobRetryDelaySlots: Map<Name, int>;
  state JobLastRunSlot: Map<Name, int>;
  state JobRunCount: Map<Name, int>;

  fn assert_job_exists(job: Name) {
    assert(JobOwner.contains(job), "job missing");
  }

  fn assert_job_owner(job: Name) {
    assert_job_exists(job);
    assert(JobOwner[job] == authority(), "job owner mismatch");
  }

  fn assert_job_runner(job: Name) {
    assert_job_exists(job);
    if JobExecutor.contains(job) {
      assert(JobExecutor[job] == authority(), "executor mismatch");
      return;
    }
    assert(JobOwner[job] == authority(), "job runner mismatch");
  }

  fn mark_running_impl(job: Name) {
    assert_job_runner(job);
    let current_slot = block_height();
    assert(JobStatus.ensure(job, 0) == 1, "job not queued");
    assert(current_slot >= JobNextSlot.ensure(job, 0), "job not ready");
    JobStatus[job] = 2;
    JobLastRunSlot[job] = current_slot;
    JobRunCount[job] = JobRunCount.ensure(job, 0) + 1;
  }

  fn retry_impl(job: Name) {
    assert_job_owner(job);
    let current_slot = block_height();
    let retries = RetryCount.ensure(job, 0);
    let max_retries = JobMaxRetries.ensure(job, 0);
    if max_retries > 0 {
      assert(retries < max_retries, "retry limit");
    }
    JobStatus[job] = 1;
    RetryCount[job] = retries + 1;
    JobNextSlot[job] = current_slot + JobRetryDelaySlots.ensure(job, 0);
  }

  kotoage fn main() -> int {
    return 1;
  }

  kotoage fn enqueue(job: Name, payload_hash: int) {
    assert(!JobOwner.contains(job), "job exists");
    JobOwner[job] = authority();
    JobPayloadHash[job] = payload_hash;
    JobStatus[job] = 1;
    RetryCount[job] = 0;
    JobNextSlot[job] = 0;
    JobCronIntervalSlots[job] = 0;
    JobMaxRetries[job] = 0;
    JobRetryDelaySlots[job] = 0;
    JobLastRunSlot[job] = 0;
    JobRunCount[job] = 0;
  }

  kotoage fn assign_executor(job: Name, executor: AccountId) {
    assert_job_owner(job);
    JobExecutor[job] = executor;
  }

  kotoage fn configure_job(job: Name,
                           next_slot: int,
                           max_retries: int,
                           retry_delay_slots: int) {
    assert_job_owner(job);
    assert(next_slot >= 0, "invalid next slot");
    assert(max_retries >= 0, "invalid max retries");
    assert(retry_delay_slots >= 0, "invalid retry delay");
    JobNextSlot[job] = next_slot;
    JobMaxRetries[job] = max_retries;
    JobRetryDelaySlots[job] = retry_delay_slots;
  }

  kotoage fn configure_cron(job: Name, interval_slots: int) {
    assert_job_owner(job);
    assert(interval_slots >= 0, "invalid interval");
    JobCronIntervalSlots[job] = interval_slots;
  }

  kotoage fn mark_running(job: Name) {
    mark_running_impl(job);
  }

  kotoage fn dispatch_job(job: Name) {
    mark_running_impl(job);
  }

  kotoage fn mark_done(job: Name) {
    assert_job_runner(job);
    let status = JobStatus.ensure(job, 0);
    assert(status != 3, "job already done");
    assert(status != 5, "job canceled");
    JobStatus[job] = 3;
  }

  kotoage fn complete_run(job: Name) {
    assert_job_runner(job);
    let current_slot = block_height();
    assert(JobStatus.ensure(job, 0) == 2, "job not running");
    assert(current_slot >= JobLastRunSlot.ensure(job, 0), "invalid current slot");
    let interval_slots = JobCronIntervalSlots.ensure(job, 0);
    if interval_slots > 0 {
      JobStatus[job] = 1;
      JobNextSlot[job] = current_slot + interval_slots;
    } else {
      JobStatus[job] = 3;
    }
  }

  kotoage fn retry(job: Name) {
    retry_impl(job);
  }

  kotoage fn pause_job(job: Name) {
    assert_job_owner(job);
    let status = JobStatus.ensure(job, 0);
    assert(status == 1 || status == 2, "job not active");
    JobStatus[job] = 4;
  }

  kotoage fn resume_job(job: Name) {
    assert_job_owner(job);
    let current_slot = block_height();
    assert(JobStatus.ensure(job, 0) == 4, "job not paused");
    JobStatus[job] = 1;
    JobNextSlot[job] = current_slot;
  }

  kotoage fn cancel_job(job: Name) {
    assert_job_owner(job);
    let status = JobStatus.ensure(job, 0);
    assert(status != 3, "job already done");
    assert(status != 5, "job already canceled");
    JobStatus[job] = 5;
  }

  view fn mirror_job(job: Name) -> (int, int, int, int, int, int, int, int, int, int, int) {
    let job_registered = 0;
    let executor_bound = 0;
    if JobOwner.contains(job) {
      job_registered = 1;
    }
    if JobExecutor.contains(job) {
      executor_bound = 1;
    }
    return (
      job_registered,
      executor_bound,
      JobPayloadHash.get_or(job, 0),
      JobStatus.get_or(job, 0),
      RetryCount.get_or(job, 0),
      JobNextSlot.get_or(job, 0),
      JobCronIntervalSlots.get_or(job, 0),
      JobMaxRetries.get_or(job, 0),
      JobRetryDelaySlots.get_or(job, 0),
      JobLastRunSlot.get_or(job, 0),
      JobRunCount.get_or(job, 0)
    );
  }
}
