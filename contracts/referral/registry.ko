seiyaku ReferralRegistry {
  state int RegistryInitialized;
  state AccountId RegistryOwner;
  state AssetDefinitionId RewardAsset;
  state AccountId Treasury;
  state int ClaimThreshold;
  state int DirectShareBps;
  state int ParentShareBps;
  state MemberOwner: Map<Name, AccountId>;
  state ParentMember: Map<Name, Name>;
  state Accrued: Map<Name, int>;
  state TotalAccrued: Map<Name, int>;
  state TotalClaimed: Map<Name, int>;
  state ClaimCount: Map<Name, int>;

  fn assert_initialized() {
    assert(RegistryInitialized == 1, "registry not initialized");
  }

  fn assert_member_bound(member: Name) {
    assert(MemberOwner.contains(member), "member missing");
  }

  fn validate_share_bps(direct_share_bps: int, parent_share_bps: int) {
    assert(direct_share_bps >= 0, "invalid direct share");
    assert(parent_share_bps >= 0, "invalid parent share");
    assert(direct_share_bps <= 10_000, "invalid direct share");
    assert(parent_share_bps <= 10_000, "invalid parent share");
    assert(direct_share_bps + parent_share_bps == 10_000, "invalid share sum");
  }

  fn init_member_accounting(member: Name) {
    Accrued[member] = 0;
    TotalAccrued[member] = 0;
    TotalClaimed[member] = 0;
    ClaimCount[member] = 0;
  }

  fn accrue_member(member: Name, amount: int) {
    if amount > 0 {
      Accrued[member] = Accrued.ensure(member, 0) + amount;
      TotalAccrued[member] = TotalAccrued.ensure(member, 0) + amount;
    }
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  #[access(read="*", write="*")]
  kotoage fn main() -> int {
    return RegistryInitialized;
  }

  #[access(read="*", write="*")]
  kotoage fn init_registry(reward_asset: AssetDefinitionId,
                           treasury: AccountId,
                           claim_threshold: int,
                           direct_share_bps: int,
                           parent_share_bps: int) {
    assert(RegistryInitialized == 0, "registry initialized");
    assert(claim_threshold > 0, "invalid claim threshold");
    validate_share_bps(direct_share_bps, parent_share_bps);
    RegistryInitialized = 1;
    RegistryOwner = authority();
    RewardAsset = reward_asset;
    Treasury = treasury;
    ClaimThreshold = claim_threshold;
    DirectShareBps = direct_share_bps;
    ParentShareBps = parent_share_bps;
  }

  #[access(read="*", write="*")]
  kotoage fn bind_member(member: Name) {
    assert_initialized();
    assert(!MemberOwner.contains(member), "member exists");
    MemberOwner[member] = authority();
    init_member_accounting(member);
  }

  #[access(read="*", write="*")]
  kotoage fn bind_member_with_parent(member: Name, parent_member: Name) {
    assert_initialized();
    assert(member != parent_member, "invalid parent member");
    assert_member_bound(parent_member);
    assert(!MemberOwner.contains(member), "member exists");
    MemberOwner[member] = authority();
    ParentMember[member] = parent_member;
    init_member_accounting(member);
  }

  #[access(read="*", write="*")]
  kotoage fn accrue(member: Name, amount: int) permission(AssetOps) {
    assert_initialized();
    assert_member_bound(member);
    assert(amount > 0, "invalid amount");
    let funder = authority();
    move_asset_if_needed(funder, Treasury, RewardAsset, amount);
    if ParentMember.contains(member) {
      let direct_share = (amount * DirectShareBps) / 10_000;
      let parent_share = amount - direct_share;
      accrue_member(member, direct_share);
      accrue_member(ParentMember[member], parent_share);
      return;
    }
    accrue_member(member, amount);
  }

  #[access(read="*", write="*")]
  kotoage fn claim(member: Name) permission(AssetOps) {
    assert_initialized();
    assert_member_bound(member);
    let claimant = authority();
    assert(claimant == MemberOwner[member], "claimant mismatch");
    let amount = Accrued.ensure(member, 0);
    assert(amount > 0, "nothing accrued");
    assert(amount >= ClaimThreshold, "below claim threshold");
    move_asset_if_needed(Treasury, claimant, RewardAsset, amount);
    Accrued[member] = 0;
    TotalClaimed[member] = TotalClaimed.ensure(member, 0) + amount;
    ClaimCount[member] = ClaimCount.ensure(member, 0) + 1;
  }

  view fn registry_config() -> (AssetDefinitionId, AccountId, int, int, int) {
    assert_initialized();
    return (
      RewardAsset,
      Treasury,
      ClaimThreshold,
      DirectShareBps,
      ParentShareBps
    );
  }

  view fn mirror_member(member: Name) -> (int, int, int, int, int, int, int, int, int, int, int, int, int) {
    let bound = 0;
    let parent_bound = 0;
    let parent_accrued = 0;
    let parent_total_accrued = 0;
    let parent_total_claimed = 0;
    let parent_claim_count = 0;
    if MemberOwner.contains(member) {
      bound = 1;
    }
    if ParentMember.contains(member) {
      let parent_member = ParentMember[member];
      parent_bound = 1;
      parent_accrued = Accrued.get_or(parent_member, 0);
      parent_total_accrued = TotalAccrued.get_or(parent_member, 0);
      parent_total_claimed = TotalClaimed.get_or(parent_member, 0);
      parent_claim_count = ClaimCount.get_or(parent_member, 0);
    }
    return (
      bound,
      ClaimThreshold,
      DirectShareBps,
      ParentShareBps,
      Accrued.get_or(member, 0),
      TotalAccrued.get_or(member, 0),
      TotalClaimed.get_or(member, 0),
      ClaimCount.get_or(member, 0),
      parent_bound,
      parent_accrued,
      parent_total_accrued,
      parent_total_claimed,
      parent_claim_count
    );
  }
}
