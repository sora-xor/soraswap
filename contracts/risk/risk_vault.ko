// Shared collateral vault for perps, options, and cover.
// Bucket controllers account for liabilities, while all collateral is held by
// the single configured vault account. Financial values use V1 `quantity`.

seiyaku RiskVault {
  error enum RiskVaultError {
    VaultOwnerMismatch = 1,
    VaultGuardianMismatch = 2,
    WithdrawalOnly = 3,
    BucketIdOutOfRange = 4,
    BucketNotConfigured = 5,
    BucketControllerMismatch = 6,
    InvalidPayoutCap = 7,
    InvalidUtilisationCap = 8,
    InvalidCollateralMultiplier = 9,
    BucketUndercollateralized = 10,
    BucketUtilisation = 11,
    BucketAccountingInvariant = 12,
    InsufficientSurplus = 13,
    ExposureIdOutOfRange = 14,
    LiabilityMissing = 15,
    LiabilityAlreadyReleased = 16,
    LiabilityPayoutExceedsNewCap = 17,
    InvalidJobId = 18,
    InvalidCadence = 19,
    InvalidBacklogCap = 20,
    InvalidBacklog = 21,
    InvalidSafeMode = 22,
    AutomationSafeMode = 23,
    AutomationBacklog = 24,
  }

  state int RiskVaultInitialized;
  state AccountId RiskVaultOwner;
  state AccountId RiskVaultGuardian;
  state AssetDefinitionId RiskVaultCollateralAsset;
  state AccountId RiskVaultAccount;
  state int RiskVaultWithdrawalOnly;

  state StateMap<int, AccountId> RiskVaultBucketController;
  state StateMap<int, int> RiskVaultBucketPayoutCapBps;
  state StateMap<int, int> RiskVaultBucketUtilisationCapBps;
  state StateMap<int, int> RiskVaultBucketCollateralMultiplierBps;
  state StateMap<int, quantity> RiskVaultBucketDeposits;
  state StateMap<int, quantity> RiskVaultBucketOutstandingNotional;
  state StateMap<int, quantity> RiskVaultBucketReservedCollateral;
  state StateMap<int, quantity> RiskVaultBucketSettledPayouts;

  state StateMap<int, AccountId> RiskVaultBucketAutomationExecutor;
  state StateMap<int, int> RiskVaultBucketAutomationJobId;
  state StateMap<int, int> RiskVaultBucketAutomationCadence;
  state StateMap<int, int> RiskVaultBucketAutomationBacklogCap;
  state StateMap<int, int> RiskVaultBucketAutomationBacklog;
  state StateMap<int, int> RiskVaultBucketAutomationSafeMode;

  state StateMap<int, int> RiskVaultLiabilityStatus;
  state StateMap<int, quantity> RiskVaultLiabilityNotional;
  state StateMap<int, quantity> RiskVaultLiabilityCollateral;
  state StateMap<int, quantity> RiskVaultLiabilitySettledPayout;

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn max_int(int left, int right) -> int {
    if left >= right {
      return left;
    }
    return right;
  }

  fn min_quantity(quantity left, quantity right) -> quantity {
    if left <= right {
      return left;
    }
    return right;
  }

  fn max_quantity(quantity left, quantity right) -> quantity {
    if left >= right {
      return left;
    }
    return right;
  }

  fn assert_bucket_id(int bucket_id) {
    require(bucket_id >= 1 && bucket_id <= 3, RiskVaultError::BucketIdOutOfRange);
  }

  fn assert_owner() {
    require(RiskVaultOwner == context::authority(), RiskVaultError::VaultOwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if RiskVaultOwner == context::authority() {
      return;
    }
    require(
      RiskVaultGuardian == context::authority(),
      RiskVaultError::VaultGuardianMismatch
    );
  }

  fn assert_bucket_configured(int bucket_id) {
    assert_bucket_id(bucket_id);
    require(
      RiskVaultBucketController.contains(bucket_id),
      RiskVaultError::BucketNotConfigured
    );
  }

  fn bucket_controller_value(int bucket_id) -> AccountId {
    assert_bucket_configured(bucket_id);
    return RiskVaultBucketController.get(bucket_id).unwrap_or(RiskVaultOwner);
  }

  fn assert_owner_or_controller(int bucket_id) {
    assert_bucket_configured(bucket_id);
    if RiskVaultOwner == context::authority() {
      return;
    }
    require(
      bucket_controller_value(bucket_id) == context::authority(),
      RiskVaultError::BucketControllerMismatch
    );
  }

  fn assert_risk_on(int bucket_id) {
    require(RiskVaultWithdrawalOnly == 0, RiskVaultError::WithdrawalOnly);
    require(
      RiskVaultBucketAutomationSafeMode.get(bucket_id).unwrap_or(0) == 0,
      RiskVaultError::AutomationSafeMode
    );
    require(
      RiskVaultBucketAutomationBacklog.get(bucket_id).unwrap_or(0) <=
        RiskVaultBucketAutomationBacklogCap.get(bucket_id).unwrap_or(0),
      RiskVaultError::AutomationBacklog
    );
  }

  fn bucket_deposits_value(int bucket_id) -> quantity {
    return RiskVaultBucketDeposits.get(bucket_id).unwrap_or(zero_quantity());
  }

  fn bucket_outstanding_notional_value(int bucket_id) -> quantity {
    return RiskVaultBucketOutstandingNotional.get(bucket_id).unwrap_or(zero_quantity());
  }

  fn bucket_reserved_collateral_value(int bucket_id) -> quantity {
    return RiskVaultBucketReservedCollateral.get(bucket_id).unwrap_or(zero_quantity());
  }

  fn bucket_settled_payouts_value(int bucket_id) -> quantity {
    return RiskVaultBucketSettledPayouts.get(bucket_id).unwrap_or(zero_quantity());
  }

  fn bucket_required_collateral(
    int bucket_id,
    quantity outstanding_notional,
    quantity reserved_collateral
  ) -> quantity {
    let decimal bps_scale = 10_000;
    let multiplier = decimal::from_int(
      value: RiskVaultBucketCollateralMultiplierBps.get(bucket_id).unwrap_or(0)
    ) / bps_scale;
    return max_quantity(
      left: outstanding_notional * multiplier,
      right: reserved_collateral
    );
  }

  fn bucket_utilisation_bps(
    int bucket_id,
    quantity deposits,
    quantity outstanding_notional,
    quantity reserved_collateral
  ) -> int {
    let required = bucket_required_collateral(
      bucket_id: bucket_id,
      outstanding_notional: outstanding_notional,
      reserved_collateral: reserved_collateral
    );
    if required == zero_quantity() {
      return 0;
    }
    if deposits == zero_quantity() {
      return 10_000;
    }
    let ratio = required.ratio_round(
      divisor: deposits,
      scale: 12,
      mode: Rounding::ceil
    );
    return decimal::to_int_round(
      value: ratio * 10_000,
      mode: Rounding::ceil
    );
  }

  fn bucket_surplus_value(int bucket_id) -> quantity {
    let deposits = bucket_deposits_value(bucket_id);
    let required = bucket_required_collateral(
      bucket_id: bucket_id,
      outstanding_notional: bucket_outstanding_notional_value(bucket_id),
      reserved_collateral: bucket_reserved_collateral_value(bucket_id)
    );
    if deposits <= required {
      return zero_quantity();
    }
    return deposits - required;
  }

  fn assert_bucket_capacity(
    int bucket_id,
    quantity deposits,
    quantity outstanding_notional,
    quantity reserved_collateral
  ) {
    let required = bucket_required_collateral(
      bucket_id: bucket_id,
      outstanding_notional: outstanding_notional,
      reserved_collateral: reserved_collateral
    );
    require(deposits >= required, RiskVaultError::BucketUndercollateralized);
    let utilisation_cap = RiskVaultBucketUtilisationCapBps.get(bucket_id).unwrap_or(0);
    if utilisation_cap > 0 {
      require(
        bucket_utilisation_bps(
          bucket_id: bucket_id,
          deposits: deposits,
          outstanding_notional: outstanding_notional,
          reserved_collateral: reserved_collateral
        ) <= utilisation_cap,
        RiskVaultError::BucketUtilisation
      );
    }
  }

  fn liability_key(int bucket_id, int exposure_id) -> int {
    assert_bucket_id(bucket_id);
    require(
      exposure_id >= 0 && exposure_id < 1_000_000_000,
      RiskVaultError::ExposureIdOutOfRange
    );
    return bucket_id * 1_000_000_000 + exposure_id;
  }

  fn liability_status_value(int key) -> int {
    return RiskVaultLiabilityStatus.get(key).unwrap_or(0);
  }

  fn liability_notional_value(int key) -> quantity {
    return RiskVaultLiabilityNotional.get(key).unwrap_or(zero_quantity());
  }

  fn liability_collateral_value(int key) -> quantity {
    return RiskVaultLiabilityCollateral.get(key).unwrap_or(zero_quantity());
  }

  fn liability_settled_payout_value(int key) -> quantity {
    return RiskVaultLiabilitySettledPayout.get(key).unwrap_or(zero_quantity());
  }

  fn payout_cap_for(int bucket_id, quantity notional) -> quantity {
    let decimal bps_scale = 10_000;
    let payout_rate = decimal::from_int(
      value: RiskVaultBucketPayoutCapBps.get(bucket_id).unwrap_or(0)
    ) / bps_scale;
    return notional * payout_rate;
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: RiskVaultCollateralAsset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn report_bucket_impl(int bucket_id, int backlog, int safe_mode) {
    assert_owner_or_controller(bucket_id);
    require(backlog >= 0, RiskVaultError::InvalidBacklog);
    require(safe_mode == 0 || safe_mode == 1, RiskVaultError::InvalidSafeMode);
    require(
      backlog <= RiskVaultBucketAutomationBacklogCap.get(bucket_id).unwrap_or(0),
      RiskVaultError::AutomationBacklog
    );
    RiskVaultBucketAutomationBacklog[bucket_id] = backlog;
    RiskVaultBucketAutomationSafeMode[bucket_id] = safe_mode;
  }

  hajimari(
    AssetDefinitionId collateral_asset,
    AccountId vault_account,
    AccountId guardian
  ) {
    RiskVaultInitialized = 1;
    RiskVaultOwner = context::authority();
    RiskVaultGuardian = guardian;
    RiskVaultCollateralAsset = collateral_asset;
    RiskVaultAccount = vault_account;
    RiskVaultWithdrawalOnly = 1;
  }

  view fn main() -> int {
    return RiskVaultInitialized;
  }

  kotoage fn configure_bucket(
    int bucket_id,
    AccountId controller,
    int payout_cap_bps,
    int utilisation_cap_bps,
    int collateral_multiplier_bps
  ) authorize("Admin") {
    assert_owner();
    assert_bucket_id(bucket_id);
    require(
      payout_cap_bps >= 0 && payout_cap_bps <= 10_000,
      RiskVaultError::InvalidPayoutCap
    );
    require(
      utilisation_cap_bps >= 0 && utilisation_cap_bps <= 10_000,
      RiskVaultError::InvalidUtilisationCap
    );
    require(collateral_multiplier_bps >= 0, RiskVaultError::InvalidCollateralMultiplier);
    if RiskVaultBucketPayoutCapBps.contains(bucket_id) &&
      bucket_outstanding_notional_value(bucket_id) > zero_quantity() {
      require(
        payout_cap_bps >= RiskVaultBucketPayoutCapBps.get(bucket_id).unwrap_or(0),
        RiskVaultError::InvalidPayoutCap
      );
    }
    RiskVaultBucketController[bucket_id] = controller;
    RiskVaultBucketPayoutCapBps[bucket_id] = payout_cap_bps;
    RiskVaultBucketUtilisationCapBps[bucket_id] = utilisation_cap_bps;
    RiskVaultBucketCollateralMultiplierBps[bucket_id] = collateral_multiplier_bps;
    if !RiskVaultBucketDeposits.contains(bucket_id) {
      RiskVaultBucketDeposits[bucket_id] = zero_quantity();
      RiskVaultBucketOutstandingNotional[bucket_id] = zero_quantity();
      RiskVaultBucketReservedCollateral[bucket_id] = zero_quantity();
      RiskVaultBucketSettledPayouts[bucket_id] = zero_quantity();
      RiskVaultBucketAutomationJobId[bucket_id] = 0;
      RiskVaultBucketAutomationCadence[bucket_id] = 0;
      RiskVaultBucketAutomationBacklogCap[bucket_id] = 0;
      RiskVaultBucketAutomationBacklog[bucket_id] = 0;
      RiskVaultBucketAutomationSafeMode[bucket_id] = 0;
    }
    assert_bucket_capacity(
      bucket_id: bucket_id,
      deposits: bucket_deposits_value(bucket_id),
      outstanding_notional: bucket_outstanding_notional_value(bucket_id),
      reserved_collateral: bucket_reserved_collateral_value(bucket_id)
    );
  }

  kotoage fn sync_automation(
    int bucket_id,
    AccountId executor,
    int job_id,
    int cadence_slots,
    int backlog_cap,
    int safe_mode
  ) authorize("Admin") {
    assert_owner_or_controller(bucket_id);
    require(job_id >= 0, RiskVaultError::InvalidJobId);
    require(cadence_slots >= 0, RiskVaultError::InvalidCadence);
    require(backlog_cap >= 0, RiskVaultError::InvalidBacklogCap);
    require(safe_mode == 0 || safe_mode == 1, RiskVaultError::InvalidSafeMode);
    require(
      RiskVaultBucketAutomationBacklog.get(bucket_id).unwrap_or(0) <= backlog_cap,
      RiskVaultError::AutomationBacklog
    );
    RiskVaultBucketAutomationExecutor[bucket_id] = executor;
    RiskVaultBucketAutomationJobId[bucket_id] = job_id;
    RiskVaultBucketAutomationCadence[bucket_id] = cadence_slots;
    RiskVaultBucketAutomationBacklogCap[bucket_id] = backlog_cap;
    RiskVaultBucketAutomationSafeMode[bucket_id] = safe_mode;
  }

  kotoage fn report_bucket(
    int bucket_id,
    int backlog,
    int safe_mode
  ) authorize("Entry") {
    report_bucket_impl(bucket_id: bucket_id, backlog: backlog, safe_mode: safe_mode);
  }

  kotoage fn report_bucket_c2c(
    int bucket_id,
    int backlog,
    int safe_mode
  ) -> int authorize("Entry") {
    report_bucket_impl(bucket_id: bucket_id, backlog: backlog, safe_mode: safe_mode);
    return 1;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    RiskVaultWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    RiskVaultWithdrawalOnly = 0;
  }

  kotoage fn deposit(
    int bucket_id,
    quantity amount
  ) -> quantity authorize("AssetOps") {
    assert_owner_or_controller(bucket_id);
    require(amount > zero_quantity(), RiskVaultError::BucketAccountingInvariant);
    let payer = context::authority();
    move_asset_if_needed(source: payer, destination: RiskVaultAccount, amount: amount);
    RiskVaultBucketDeposits[bucket_id] = bucket_deposits_value(bucket_id) + amount;
    return bucket_deposits_value(bucket_id);
  }

  kotoage fn withdraw_surplus(
    int bucket_id,
    quantity amount
  ) authorize("AssetOps") {
    assert_owner_or_controller(bucket_id);
    require(amount > zero_quantity(), RiskVaultError::BucketAccountingInvariant);
    require(bucket_surplus_value(bucket_id) >= amount, RiskVaultError::InsufficientSurplus);
    move_asset_if_needed(
      source: RiskVaultAccount,
      destination: context::authority(),
      amount: amount
    );
    RiskVaultBucketDeposits[bucket_id] = bucket_deposits_value(bucket_id) - amount;
  }

  kotoage fn lock_liability(
    int bucket_id,
    int exposure_id,
    quantity notional,
    quantity collateral_locked,
    int backlog
  ) -> int authorize("Entry") {
    assert_owner_or_controller(bucket_id);
    assert_risk_on(bucket_id);
    require(backlog >= 0, RiskVaultError::InvalidBacklog);
    require(
      backlog <= RiskVaultBucketAutomationBacklogCap.get(bucket_id).unwrap_or(0),
      RiskVaultError::AutomationBacklog
    );
    let key = liability_key(bucket_id: bucket_id, exposure_id: exposure_id);
    require(
      liability_status_value(key) != 2,
      RiskVaultError::LiabilityAlreadyReleased
    );
    let prior_notional = liability_notional_value(key);
    let prior_collateral = liability_collateral_value(key);
    let current_outstanding = bucket_outstanding_notional_value(bucket_id);
    let current_reserved = bucket_reserved_collateral_value(bucket_id);
    require(current_outstanding >= prior_notional, RiskVaultError::BucketAccountingInvariant);
    require(current_reserved >= prior_collateral, RiskVaultError::BucketAccountingInvariant);
    let next_outstanding = current_outstanding - prior_notional + notional;
    let next_reserved = current_reserved - prior_collateral + collateral_locked;
    require(
      liability_settled_payout_value(key) <= payout_cap_for(bucket_id: bucket_id, notional: notional),
      RiskVaultError::LiabilityPayoutExceedsNewCap
    );
    assert_bucket_capacity(
      bucket_id: bucket_id,
      deposits: bucket_deposits_value(bucket_id),
      outstanding_notional: next_outstanding,
      reserved_collateral: next_reserved
    );
    RiskVaultBucketOutstandingNotional[bucket_id] = next_outstanding;
    RiskVaultBucketReservedCollateral[bucket_id] = next_reserved;
    RiskVaultBucketAutomationBacklog[bucket_id] = backlog;
    RiskVaultLiabilityStatus[key] = 1;
    RiskVaultLiabilityNotional[key] = notional;
    RiskVaultLiabilityCollateral[key] = collateral_locked;
    if !RiskVaultLiabilitySettledPayout.contains(key) {
      RiskVaultLiabilitySettledPayout[key] = zero_quantity();
    }
    return bucket_utilisation_bps(
      bucket_id: bucket_id,
      deposits: bucket_deposits_value(bucket_id),
      outstanding_notional: next_outstanding,
      reserved_collateral: next_reserved
    );
  }

  kotoage fn release_liability(
    int bucket_id,
    int exposure_id,
    int backlog
  ) -> int authorize("Entry") {
    assert_owner_or_controller(bucket_id);
    require(backlog >= 0, RiskVaultError::InvalidBacklog);
    require(
      backlog <= RiskVaultBucketAutomationBacklogCap.get(bucket_id).unwrap_or(0),
      RiskVaultError::AutomationBacklog
    );
    let key = liability_key(bucket_id: bucket_id, exposure_id: exposure_id);
    require(liability_status_value(key) != 0, RiskVaultError::LiabilityMissing);
    require(liability_status_value(key) != 2, RiskVaultError::LiabilityAlreadyReleased);
    let prior_notional = liability_notional_value(key);
    let prior_collateral = liability_collateral_value(key);
    let outstanding = bucket_outstanding_notional_value(bucket_id);
    let reserved = bucket_reserved_collateral_value(bucket_id);
    require(outstanding >= prior_notional, RiskVaultError::BucketAccountingInvariant);
    require(reserved >= prior_collateral, RiskVaultError::BucketAccountingInvariant);
    RiskVaultBucketOutstandingNotional[bucket_id] = outstanding - prior_notional;
    RiskVaultBucketReservedCollateral[bucket_id] = reserved - prior_collateral;
    RiskVaultBucketAutomationBacklog[bucket_id] = backlog;
    RiskVaultLiabilityStatus[key] = 2;
    RiskVaultLiabilityNotional[key] = zero_quantity();
    RiskVaultLiabilityCollateral[key] = zero_quantity();
    return bucket_utilisation_bps(
      bucket_id: bucket_id,
      deposits: bucket_deposits_value(bucket_id),
      outstanding_notional: bucket_outstanding_notional_value(bucket_id),
      reserved_collateral: bucket_reserved_collateral_value(bucket_id)
    );
  }

  kotoage fn settle_payout(
    int bucket_id,
    int exposure_id,
    AccountId recipient,
    quantity amount
  ) -> quantity authorize("AssetOps") {
    assert_owner_or_controller(bucket_id);
    let key = liability_key(bucket_id: bucket_id, exposure_id: exposure_id);
    require(liability_status_value(key) == 1, RiskVaultError::LiabilityMissing);
    let payout_cap = payout_cap_for(
      bucket_id: bucket_id,
      notional: liability_notional_value(key)
    );
    let already_paid = liability_settled_payout_value(key);
    let remaining_cap = (payout_cap > already_paid)
      ? payout_cap - already_paid
      : zero_quantity();
    let final_amount = min_quantity(
      left: min_quantity(left: amount, right: remaining_cap),
      right: bucket_deposits_value(bucket_id)
    );
    if final_amount > zero_quantity() {
      move_asset_if_needed(
        source: RiskVaultAccount,
        destination: recipient,
        amount: final_amount
      );
      RiskVaultBucketDeposits[bucket_id] = bucket_deposits_value(bucket_id) - final_amount;
      RiskVaultBucketSettledPayouts[bucket_id] =
        bucket_settled_payouts_value(bucket_id) + final_amount;
      RiskVaultLiabilitySettledPayout[key] = already_paid + final_amount;
      let exposure_collateral = liability_collateral_value(key);
      let collateral_reduction = min_quantity(left: final_amount, right: exposure_collateral);
      let bucket_reserved = bucket_reserved_collateral_value(bucket_id);
      require(
        bucket_reserved >= collateral_reduction,
        RiskVaultError::BucketAccountingInvariant
      );
      RiskVaultLiabilityCollateral[key] = exposure_collateral - collateral_reduction;
      RiskVaultBucketReservedCollateral[bucket_id] = bucket_reserved - collateral_reduction;
    }
    return final_amount;
  }

  view fn bucket_state(int bucket_id) -> (
    int,
    quantity,
    quantity,
    quantity,
    int,
    int,
    int,
    quantity,
    int,
    quantity,
    int,
    int
  ) {
    let configured = RiskVaultBucketController.contains(bucket_id) ? 1 : 0;
    let deposits = bucket_deposits_value(bucket_id);
    let outstanding = bucket_outstanding_notional_value(bucket_id);
    let reserved = bucket_reserved_collateral_value(bucket_id);
    return (
      configured,
      deposits,
      outstanding,
      reserved,
      RiskVaultBucketPayoutCapBps.get(bucket_id).unwrap_or(0),
      RiskVaultBucketUtilisationCapBps.get(bucket_id).unwrap_or(0),
      RiskVaultBucketCollateralMultiplierBps.get(bucket_id).unwrap_or(0),
      bucket_settled_payouts_value(bucket_id),
      bucket_utilisation_bps(
        bucket_id: bucket_id,
        deposits: deposits,
        outstanding_notional: outstanding,
        reserved_collateral: reserved
      ),
      bucket_surplus_value(bucket_id),
      RiskVaultBucketAutomationBacklog.get(bucket_id).unwrap_or(0),
      RiskVaultBucketAutomationSafeMode.get(bucket_id).unwrap_or(0)
    );
  }

  view fn risk_state() -> (
    quantity,
    quantity,
    quantity,
    quantity,
    int,
    int,
    int,
    int
  ) {
    let total_deposits = bucket_deposits_value(1) + bucket_deposits_value(2) +
      bucket_deposits_value(3);
    let total_outstanding = bucket_outstanding_notional_value(1) +
      bucket_outstanding_notional_value(2) + bucket_outstanding_notional_value(3);
    let total_reserved = bucket_reserved_collateral_value(1) +
      bucket_reserved_collateral_value(2) + bucket_reserved_collateral_value(3);
    let total_payouts = bucket_settled_payouts_value(1) + bucket_settled_payouts_value(2) +
      bucket_settled_payouts_value(3);
    let util_1 = bucket_utilisation_bps(
      bucket_id: 1,
      deposits: bucket_deposits_value(1),
      outstanding_notional: bucket_outstanding_notional_value(1),
      reserved_collateral: bucket_reserved_collateral_value(1)
    );
    let util_2 = bucket_utilisation_bps(
      bucket_id: 2,
      deposits: bucket_deposits_value(2),
      outstanding_notional: bucket_outstanding_notional_value(2),
      reserved_collateral: bucket_reserved_collateral_value(2)
    );
    let util_3 = bucket_utilisation_bps(
      bucket_id: 3,
      deposits: bucket_deposits_value(3),
      outstanding_notional: bucket_outstanding_notional_value(3),
      reserved_collateral: bucket_reserved_collateral_value(3)
    );
    var unsafe_buckets = 0;
    if RiskVaultBucketAutomationSafeMode.get(1).unwrap_or(0) != 0 {
      unsafe_buckets = unsafe_buckets + 1;
    }
    if RiskVaultBucketAutomationSafeMode.get(2).unwrap_or(0) != 0 {
      unsafe_buckets = unsafe_buckets + 1;
    }
    if RiskVaultBucketAutomationSafeMode.get(3).unwrap_or(0) != 0 {
      unsafe_buckets = unsafe_buckets + 1;
    }
    return (
      total_deposits,
      total_outstanding,
      total_reserved,
      total_payouts,
      max_int(left: util_1, right: max_int(left: util_2, right: util_3)),
      unsafe_buckets,
      RiskVaultWithdrawalOnly,
      3
    );
  }

  view fn automation_state(int bucket_id) -> (int, int, int, int, int, int, int) {
    let executor_bound = RiskVaultBucketAutomationExecutor.contains(bucket_id) ? 1 : 0;
    return (
      executor_bound,
      RiskVaultBucketAutomationJobId.get(bucket_id).unwrap_or(0),
      RiskVaultBucketAutomationCadence.get(bucket_id).unwrap_or(0),
      RiskVaultBucketAutomationBacklogCap.get(bucket_id).unwrap_or(0),
      RiskVaultBucketAutomationBacklog.get(bucket_id).unwrap_or(0),
      RiskVaultBucketAutomationSafeMode.get(bucket_id).unwrap_or(0),
      RiskVaultWithdrawalOnly
    );
  }

  view fn liability_state(
    int bucket_id,
    int exposure_id
  ) -> (int, quantity, quantity, quantity) {
    let key = liability_key(bucket_id: bucket_id, exposure_id: exposure_id);
    return (
      liability_status_value(key),
      liability_notional_value(key),
      liability_collateral_value(key),
      liability_settled_payout_value(key)
    );
  }

  view fn vault_config() -> (AssetDefinitionId, AccountId, AccountId, int) {
    return (
      RiskVaultCollateralAsset,
      RiskVaultAccount,
      RiskVaultGuardian,
      RiskVaultWithdrawalOnly
    );
  }
}
