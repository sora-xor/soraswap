// Immutable launchpad-to-DLMM liquidity bridge.
//
// Only the configured sale-factory contract subject may stage seed assets. The
// executor derives its custody account from the deployed contract subject and
// performs Iroha's exact Quantity2 call into the pool. Failed calls roll back
// both transfers. The pool owns the fixed position/bin binding; the executor
// records aggregate deposits and shares while the factory records per-sale
// shares.

seiyaku LaunchpadLiquidityExecutor {
  error enum LaunchpadLiquidityExecutorError {
    IdenticalAssets = 1,
    InvalidAuthoritySeparation = 2,
    ExecutorOwnerMismatch = 3,
    ExecutorGuardianMismatch = 4,
    ExecutorPaused = 5,
    InvalidPaused = 6,
    SaleFactoryMismatch = 7,
    ZeroLiquidity = 8,
    PoolSeedFailed = 9,
  }

  state int ExecutorInitialized;
  state AccountId ExecutorOwner;
  state AccountId ExecutorGuardian;
  state int ExecutorPaused;
  state bytes PoolContract;
  state AssetDefinitionId BaseAsset;
  state AssetDefinitionId QuoteAsset;
  state AccountId ExecutorContractAccount;
  state AccountId SaleFactoryContractAccount;

  state int SeedCount;
  state quantity TotalBaseAmount;
  state quantity TotalQuoteAmount;
  state quantity TotalShares;
  state int LastSeedSlot;

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn assert_owner() {
    require(
      ExecutorOwner == context::authority(),
      LaunchpadLiquidityExecutorError::ExecutorOwnerMismatch
    );
  }

  fn assert_owner_or_guardian() {
    if ExecutorOwner == context::authority() {
      return;
    }
    require(
      ExecutorGuardian == context::authority(),
      LaunchpadLiquidityExecutorError::ExecutorGuardianMismatch
    );
  }

  fn assert_not_paused() {
    require(ExecutorPaused == 0, LaunchpadLiquidityExecutorError::ExecutorPaused);
  }

  fn assert_sale_factory() {
    require(
      SaleFactoryContractAccount == context::authority(),
      LaunchpadLiquidityExecutorError::SaleFactoryMismatch
    );
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    AssetDefinitionId asset,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: asset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  hajimari(
    bytes pool_contract,
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    AccountId sale_factory_account,
    AccountId guardian
  ) {
    require(base_asset != quote_asset, LaunchpadLiquidityExecutorError::IdenticalAssets);
    let executor_account = context::seiyaku_subject();
    require(
      executor_account != context::authority() &&
      sale_factory_account != context::authority() &&
      sale_factory_account != executor_account &&
      guardian != context::authority() &&
      guardian != executor_account &&
      guardian != sale_factory_account,
      LaunchpadLiquidityExecutorError::InvalidAuthoritySeparation
    );

    ExecutorInitialized = 1;
    ExecutorOwner = context::authority();
    ExecutorGuardian = guardian;
    ExecutorPaused = 1;
    PoolContract = pool_contract;
    BaseAsset = base_asset;
    QuoteAsset = quote_asset;
    ExecutorContractAccount = executor_account;
    SaleFactoryContractAccount = sale_factory_account;
    SeedCount = 0;
    TotalBaseAmount = zero_quantity();
    TotalQuoteAmount = zero_quantity();
    TotalShares = zero_quantity();
    LastSeedSlot = 0;
  }

  view fn main() -> int {
    return ExecutorInitialized;
  }

  kotoage fn set_paused(int paused) authorize("Admin") {
    require(
      paused == 0 || paused == 1,
      LaunchpadLiquidityExecutorError::InvalidPaused
    );
    if paused == 1 {
      assert_owner_or_guardian();
    } else {
      assert_owner();
    }
    ExecutorPaused = paused;
  }

  view fn executor_config() -> (
    bytes,
    AssetDefinitionId,
    AssetDefinitionId,
    AccountId,
    AccountId,
    AccountId,
    AccountId,
    int
  ) {
    return (
      PoolContract,
      BaseAsset,
      QuoteAsset,
      ExecutorOwner,
      ExecutorGuardian,
      ExecutorContractAccount,
      SaleFactoryContractAccount,
      ExecutorPaused
    );
  }

  view fn seed_count() -> int {
    return SeedCount;
  }

  view fn liquidity_state() -> (int, quantity, quantity, quantity, int) {
    return (
      SeedCount,
      TotalBaseAmount,
      TotalQuoteAmount,
      TotalShares,
      LastSeedSlot
    );
  }

  // Iroha's current cross-contract ABI requires exactly these names and types.
  // For launchpad seeding, `amount_in` is the base-side deposit and `min_out`
  // is the quote-side deposit, not a slippage threshold.
  kotoage fn seed_liquidity(
    quantity amount_in,
    quantity min_out
  ) -> quantity authorize("AssetOps") {
    assert_not_paused();
    assert_sale_factory();
    require(
      amount_in > zero_quantity() && min_out > zero_quantity(),
      LaunchpadLiquidityExecutorError::ZeroLiquidity
    );

    move_asset_if_needed(
      source: SaleFactoryContractAccount,
      destination: ExecutorContractAccount,
      asset: BaseAsset,
      amount: amount_in
    );
    move_asset_if_needed(
      source: SaleFactoryContractAccount,
      destination: ExecutorContractAccount,
      asset: QuoteAsset,
      amount: min_out
    );
    let minted_shares = contract::invoke(
      contract: PoolContract,
      entrypoint: "seed_launchpad_liquidity",
      returns: "quantity",
      amount_in: amount_in,
      min_out: min_out
    );
    require(
      minted_shares > zero_quantity(),
      LaunchpadLiquidityExecutorError::PoolSeedFailed
    );

    SeedCount = SeedCount + 1;
    TotalBaseAmount = TotalBaseAmount + amount_in;
    TotalQuoteAmount = TotalQuoteAmount + min_out;
    TotalShares = TotalShares + minted_shares;
    LastSeedSlot = context::block_height();
    return minted_shares;
  }
}
