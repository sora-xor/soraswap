seiyaku SaleFactory {
  state int FactoryOwnerSet;
  state AccountId FactoryOwner;
  state int FactoryContractBound;
  state AccountId FactoryContractId;
  state int SeedExecutorBound;
  state bytes SeedExecutorContract;
  state int NextSaleIndex;
  state SaleByIndex: Map<int, Name>;
  state int LaunchLifecycleCadenceSlots;
  state int LaunchLifecycleMaxItems;
  state int LaunchLifecycleEnabled;
  state int LaunchLifecycleNextSlot;
  state int LaunchLifecycleCursor;
  state int LaunchLifecycleLastSlot;
  state int LaunchLifecycleLastProcessed;
  state SaleOwner: Map<Name, AccountId>;
  state SaleAsset: Map<Name, AssetDefinitionId>;
  state PaymentAsset: Map<Name, AssetDefinitionId>;
  state Treasury: Map<Name, AccountId>;
  state UnitPrice: Map<Name, int>;
  state SoftCap: Map<Name, int>;
  state HardCap: Map<Name, int>;
  state Raised: Map<Name, int>;
  state Sold: Map<Name, int>;
  state Closed: Map<Name, int>;
  state Successful: Map<Name, int>;
  state Seeded: Map<Name, int>;
  state SeedInventory: Map<Name, int>;
  state SeedVault: Map<Name, AccountId>;
  state SeedPositionId: Map<Name, Name>;
  state SeedBinId: Map<Name, int>;
  state SeedPaymentAmount: Map<Name, int>;
  state SeedSaleAmount: Map<Name, int>;
  state SeedPaymentUsed: Map<Name, int>;
  state SeedSaleUsed: Map<Name, int>;
  state SeedActivationValue: Map<Name, int>;
  state ClaimInventory: Map<Name, int>;
  state ClaimedSupply: Map<Name, int>;
  state RefundedPayment: Map<Name, int>;
  state ClaimStartSlot: Map<Name, int>;
  state ClaimEndSlot: Map<Name, int>;
  state AllocationSale: Map<Name, Name>;
  state AllocationBuyer: Map<Name, AccountId>;
  state AllocationPaymentAmount: Map<Name, int>;
  state AllocationSaleAmount: Map<Name, int>;
  state AllocationClaimed: Map<Name, int>;
  state AllocationRefunded: Map<Name, int>;

  register_trigger soraswap_launchpad_lifecycle_tick {
    call native_lifecycle_tick;
    on time pre_commit;
    repeats indefinitely;
    metadata { tag: "soraswap"; module: "launchpad.sale_factory"; __enabled: false; }
  }

  fn move_asset_if_needed(from: AccountId,
                          to: AccountId,
                          asset: AssetDefinitionId,
                          amount: int) {
    if amount > 0 {
      if from != to {
        transfer_asset(from, to, asset, amount);
      }
    }
  }

  fn ensure_factory_admin() {
    assert(FactoryOwnerSet == 1, "factory not initialized");
    assert(FactoryOwner == authority(), "factory owner mismatch");
  }

  fn assert_factory_contract_bound() {
    assert(FactoryContractBound == 1, "factory contract unbound");
  }

  fn assert_executor_bound() {
    assert(SeedExecutorBound == 1, "seed executor unbound");
  }

  fn assert_sale_exists(sale: Name) {
    assert(SaleAsset.contains(sale), "sale missing");
  }

  fn assert_sale_owner(sale: Name) {
    assert_sale_exists(sale);
    assert(SaleOwner[sale] == authority(), "sale owner mismatch");
  }

  fn assert_allocation_exists(allocation: Name) {
    assert(AllocationSale.contains(allocation), "allocation missing");
  }

  fn validate_sale_config(unit_price: int, soft_cap: int, hard_cap: int) {
    assert(unit_price > 0, "invalid unit price");
    assert(soft_cap > 0, "invalid soft cap");
    assert(hard_cap >= soft_cap, "invalid hard cap");
  }

  fn validate_vesting_config(claim_start_slot: int, claim_end_slot: int) {
    assert(claim_start_slot >= 0, "invalid claim start");
    assert(claim_end_slot >= claim_start_slot, "invalid claim end");
  }

  fn available_payment_for_seed(sale: Name) -> int {
    let raised = Raised.get_or(sale, 0);
    let used = SeedPaymentUsed.get_or(sale, 0);
    let refunded = RefundedPayment.get_or(sale, 0);
    return raised - used - refunded;
  }

  fn vested_claimable(total_amount: int,
                      claim_start_slot: int,
                      claim_end_slot: int,
                      current_slot: int) -> int {
    if current_slot < claim_start_slot {
      return 0;
    }
    if claim_end_slot <= claim_start_slot {
      return total_amount;
    }
    if current_slot >= claim_end_slot {
      return total_amount;
    }
    let vested_slots = current_slot - claim_start_slot;
    let total_slots = claim_end_slot - claim_start_slot;
    return (total_amount * vested_slots) / total_slots;
  }

  fn claim_amount_for(allocation: Name, sale: Name) -> int {
    assert(Closed.get_or(sale, 0) == 1, "sale open");
    assert(Successful.get_or(sale, 0) == 1, "sale failed");
    assert(AllocationRefunded[allocation] == 0, "allocation refunded");
    let current_slot = block_height();
    let total_sale = AllocationSaleAmount[allocation];
    let claimable = vested_claimable(
      total_sale,
      ClaimStartSlot.get_or(sale, 0),
      ClaimEndSlot.get_or(sale, 0),
      current_slot
    );
    let claimed = AllocationClaimed[allocation];
    assert(claimable > claimed, "nothing claimable");
    return claimable - claimed;
  }

  fn close_sale_impl(sale: Name) {
    assert(Closed.get_or(sale, 0) == 0, "sale closed");
    Closed[sale] = 1;
    if Raised.get_or(sale, 0) >= SoftCap.get_or(sale, 0) {
      Successful[sale] = 1;
    } else {
      Successful[sale] = 0;
    }
  }

  kotoage fn main() -> int {
    return FactoryOwnerSet;
  }

  kotoage fn init_factory() {
    assert(FactoryOwnerSet == 0, "factory initialized");
    FactoryOwner = authority();
    FactoryOwnerSet = 1;
    NextSaleIndex = 1;
    LaunchLifecycleCadenceSlots = 0;
    LaunchLifecycleMaxItems = 1;
    LaunchLifecycleEnabled = 0;
    LaunchLifecycleNextSlot = 0;
    LaunchLifecycleCursor = 1;
    LaunchLifecycleLastSlot = 0;
    LaunchLifecycleLastProcessed = 0;
  }

  kotoage fn configure_trigger_lifecycle(cadence_slots: int,
                                         max_items_per_tick: int,
                                         enabled: int) permission(Admin) {
    ensure_factory_admin();
    assert(cadence_slots >= 0, "invalid cadence");
    assert(max_items_per_tick > 0, "invalid max items");
    assert(max_items_per_tick <= 16, "max items too high");
    assert(enabled == 0 || enabled == 1, "invalid enabled");
    LaunchLifecycleCadenceSlots = cadence_slots;
    LaunchLifecycleMaxItems = max_items_per_tick;
    LaunchLifecycleEnabled = enabled;
    LaunchLifecycleNextSlot = block_height() + cadence_slots;
    if LaunchLifecycleCursor <= 0 {
      LaunchLifecycleCursor = 1;
    }
    if NextSaleIndex <= 0 {
      NextSaleIndex = 1;
    }
    set_trigger_enabled(name("soraswap_launchpad_lifecycle_tick"), enabled);
  }

  view fn mirror_sale(sale: Name) -> (int, int, int, int, int, int, int, int, int, int, int, int, int) {
    assert_sale_exists(sale);
    let raised = Raised.get_or(sale, 0);
    let sold = Sold.get_or(sale, 0);
    let closed = Closed.get_or(sale, 0);
    let successful = Successful.get_or(sale, 0);
    let seeded = Seeded.get_or(sale, 0);
    let seed_inventory = SeedInventory.get_or(sale, 0);
    let seed_bin_id = SeedBinId.get_or(sale, 0);
    let seed_payment_amount = SeedPaymentAmount.get_or(sale, 0);
    let seed_sale_amount = SeedSaleAmount.get_or(sale, 0);
    let claim_inventory = ClaimInventory.get_or(sale, 0);
    let claim_start_slot = ClaimStartSlot.get_or(sale, 0);
    let claim_end_slot = ClaimEndSlot.get_or(sale, 0);
    let seed_registered = 0;
    if seed_payment_amount > 0 || seed_sale_amount > 0 {
      seed_registered = 1;
    }
    return (
      seed_registered,
      raised,
      sold,
      closed,
      successful,
      seeded,
      seed_inventory,
      seed_bin_id,
      seed_payment_amount,
      seed_sale_amount,
      claim_inventory,
      claim_start_slot,
      claim_end_slot
    );
  }

  view fn sale_config(sale: Name) -> (AssetDefinitionId, AssetDefinitionId, AccountId, int, int, int, int, int) {
    assert_sale_exists(sale);
    return (
      SaleAsset[sale],
      PaymentAsset[sale],
      Treasury[sale],
      UnitPrice[sale],
      SoftCap.get_or(sale, 0),
      HardCap.get_or(sale, 0),
      ClaimStartSlot.get_or(sale, 0),
      ClaimEndSlot.get_or(sale, 0)
    );
  }

  view fn mirror_sale_accounting(sale: Name) -> (int, int, int, int) {
    assert_sale_exists(sale);
    return (
      SeedPaymentUsed.get_or(sale, 0),
      SeedSaleUsed.get_or(sale, 0),
      ClaimedSupply.get_or(sale, 0),
      RefundedPayment.get_or(sale, 0)
    );
  }

  view fn factory_binding_state() -> (int, int) {
    return (
      FactoryContractBound,
      SeedExecutorBound
    );
  }

  view fn factory_owner_state() -> (int, AccountId) {
    return (
      FactoryOwnerSet,
      FactoryOwner
    );
  }

  view fn factory_binding_details() -> (AccountId, bytes, int, int) {
    return (
      FactoryContractId,
      SeedExecutorContract,
      FactoryContractBound,
      SeedExecutorBound
    );
  }

  view fn activation_state(sale: Name) -> (int, int) {
    assert_sale_exists(sale);
    return (
      SeedExecutorBound,
      SeedActivationValue.get_or(sale, 0)
    );
  }

  view fn mirror_allocation(allocation: Name) -> (int, int, int, int, int) {
    if AllocationSale.contains(allocation) {
      return (
        1,
        AllocationPaymentAmount[allocation],
        AllocationSaleAmount[allocation],
        AllocationClaimed[allocation],
        AllocationRefunded[allocation]
      );
    }
    return (0, 0, 0, 0, 0);
  }

  kotoage fn init_sale(sale: Name,
                       sale_asset: AssetDefinitionId,
                       payment_asset: AssetDefinitionId,
                       treasury: AccountId,
                       unit_price: int,
                       soft_cap: int,
                       hard_cap: int,
                       claim_start_slot: int,
                       claim_end_slot: int) {
    ensure_factory_admin();
    assert(!SaleAsset.contains(sale), "sale exists");
    validate_sale_config(unit_price, soft_cap, hard_cap);
    validate_vesting_config(claim_start_slot, claim_end_slot);
    SaleOwner[sale] = authority();
    if NextSaleIndex <= 0 {
      NextSaleIndex = 1;
    }
    let sale_index = NextSaleIndex;
    NextSaleIndex = sale_index + 1;
    SaleByIndex[sale_index] = sale;
    SaleAsset[sale] = sale_asset;
    PaymentAsset[sale] = payment_asset;
    Treasury[sale] = treasury;
    UnitPrice[sale] = unit_price;
    SoftCap[sale] = soft_cap;
    HardCap[sale] = hard_cap;
    ClaimStartSlot[sale] = claim_start_slot;
    ClaimEndSlot[sale] = claim_end_slot;
    Raised[sale] = 0;
    Sold[sale] = 0;
    Closed[sale] = 0;
    Successful[sale] = 0;
    Seeded[sale] = 0;
    SeedInventory[sale] = 0;
    ClaimInventory[sale] = 0;
    ClaimedSupply[sale] = 0;
    RefundedPayment[sale] = 0;
    SeedPaymentUsed[sale] = 0;
    SeedSaleUsed[sale] = 0;
    SeedActivationValue[sale] = 0;
  }

  kotoage fn bind_contract(contract_id: AccountId) {
    ensure_factory_admin();
    FactoryContractId = contract_id;
    FactoryContractBound = 1;
  }

  kotoage fn bind_executor(executor_contract: bytes) {
    ensure_factory_admin();
    SeedExecutorContract = executor_contract;
    SeedExecutorBound = 1;
  }

  kotoage fn contribute(sale: Name, payment_amount: int) -> int permission(AssetOps) {
    assert_sale_exists(sale);
    assert(payment_amount > 0, "invalid payment");
    assert(false, "use contribute_recorded");
    return 0;
  }

  kotoage fn contribute_recorded(sale: Name,
                                 allocation: Name,
                                 payment_amount: int) -> int permission(AssetOps) {
    let buyer = authority();
    assert_sale_exists(sale);
    assert(!AllocationSale.contains(allocation), "allocation exists");
    assert(payment_amount > 0, "invalid payment");
    assert(Closed.get_or(sale, 0) == 0, "sale closed");
    let raised = Raised.get_or(sale, 0);
    let next = raised + payment_amount;
    assert(next <= HardCap.get_or(sale, 0), "hard cap");
    let sale_amount = payment_amount / UnitPrice.get_or(sale, 1);
    assert(sale_amount > 0, "zero sale output");

    move_asset_if_needed(buyer, Treasury[sale], PaymentAsset[sale], payment_amount);
    AllocationSale[allocation] = sale;
    AllocationBuyer[allocation] = buyer;
    AllocationPaymentAmount[allocation] = payment_amount;
    AllocationSaleAmount[allocation] = sale_amount;
    AllocationClaimed[allocation] = 0;
    AllocationRefunded[allocation] = 0;
    Raised[sale] = next;
    Sold[sale] = Sold.get_or(sale, 0) + sale_amount;
    return sale_amount;
  }

  kotoage fn close_sale(sale: Name) {
    assert_sale_owner(sale);
    close_sale_impl(sale);
  }

  kotoage fn deposit_seed_inventory(sale: Name, amount: int) -> int permission(AssetOps) {
    assert_sale_exists(sale);
    assert(amount > 0, "invalid amount");
    assert(Seeded.get_or(sale, 0) == 0, "sale seeded");
    move_asset_if_needed(authority(), Treasury[sale], SaleAsset[sale], amount);
    SeedInventory[sale] = SeedInventory.get_or(sale, 0) + amount;
    return amount;
  }

  kotoage fn deposit_claim_inventory(sale: Name, amount: int) -> int permission(AssetOps) {
    assert_sale_exists(sale);
    assert(amount > 0, "invalid amount");
    move_asset_if_needed(authority(), Treasury[sale], SaleAsset[sale], amount);
    ClaimInventory[sale] = ClaimInventory.get_or(sale, 0) + amount;
    return amount;
  }

  kotoage fn register_seed_liquidity(sale: Name,
                                     position_id: Name,
                                     vault_account: AccountId,
                                     bin_id: int,
                                     payment_amount: int,
                                     sale_amount: int) {
    assert_sale_owner(sale);
    assert_sale_exists(sale);
    assert(Seeded.get_or(sale, 0) == 0, "sale seeded");
    assert(payment_amount > 0, "invalid payment amount");
    assert(sale_amount > 0, "invalid sale amount");
    SeedPositionId[sale] = position_id;
    SeedVault[sale] = vault_account;
    SeedBinId[sale] = bin_id;
    SeedPaymentAmount[sale] = payment_amount;
    SeedSaleAmount[sale] = sale_amount;
  }

  fn activate_seed_with_executor(sale: Name) -> int {
    assert_sale_exists(sale);
    assert_sale_owner(sale);
    assert_factory_contract_bound();
    assert_executor_bound();
    assert(Closed.get_or(sale, 0) == 1, "sale open");
    assert(Successful.get_or(sale, 0) == 1, "sale failed");
    assert(Seeded.get_or(sale, 0) == 0, "sale seeded");
    assert(SeedPositionId.contains(sale), "seed plan missing");
    let payment_amount = SeedPaymentAmount.get_or(sale, 0);
    let sale_amount = SeedSaleAmount.get_or(sale, 0);
    assert(payment_amount > 0, "seed payment missing");
    assert(sale_amount > 0, "seed sale missing");
    assert(available_payment_for_seed(sale) >= payment_amount, "insufficient payment proceeds");
    assert(SeedInventory.get_or(sale, 0) >= sale_amount, "insufficient seed inventory");
    move_asset_if_needed(Treasury[sale], FactoryContractId, PaymentAsset[sale], payment_amount);
    move_asset_if_needed(Treasury[sale], FactoryContractId, SaleAsset[sale], sale_amount);
    let payload = json_object();
    let payload = json_set_account_id(payload, name("funding_account"), FactoryContractId);
    let payload = json_set_int(payload, name("bin_id"), SeedBinId.get_or(sale, 0));
    let payload = json_set_int(payload, name("base_amount"), payment_amount);
    let payload = json_set_int(payload, name("quote_amount"), sale_amount);
    let seeded_value = decode_int(call_contract(SeedExecutorContract, "seed_liquidity", payload));
    SeedInventory[sale] = SeedInventory.get_or(sale, 0) - sale_amount;
    SeedPaymentUsed[sale] = SeedPaymentUsed.get_or(sale, 0) + payment_amount;
    SeedSaleUsed[sale] = SeedSaleUsed.get_or(sale, 0) + sale_amount;
    Seeded[sale] = 1;
    SeedActivationValue[sale] = seeded_value;
    return seeded_value;
  }

  fn activate_seed_if_contract_custodied(sale: Name) -> int {
    assert_sale_exists(sale);
    assert_factory_contract_bound();
    assert_executor_bound();
    assert(Closed.get_or(sale, 0) == 1, "sale open");
    assert(Successful.get_or(sale, 0) == 1, "sale failed");
    assert(Seeded.get_or(sale, 0) == 0, "sale seeded");
    assert(SeedPositionId.contains(sale), "seed plan missing");
    assert(Treasury[sale] == FactoryContractId, "seed activation pending");
    let payment_amount = SeedPaymentAmount.get_or(sale, 0);
    let sale_amount = SeedSaleAmount.get_or(sale, 0);
    assert(payment_amount > 0, "seed payment missing");
    assert(sale_amount > 0, "seed sale missing");
    assert(available_payment_for_seed(sale) >= payment_amount, "insufficient payment proceeds");
    assert(SeedInventory.get_or(sale, 0) >= sale_amount, "insufficient seed inventory");
    let payload = json_object();
    let payload = json_set_account_id(payload, name("funding_account"), FactoryContractId);
    let payload = json_set_int(payload, name("bin_id"), SeedBinId.get_or(sale, 0));
    let payload = json_set_int(payload, name("base_amount"), payment_amount);
    let payload = json_set_int(payload, name("quote_amount"), sale_amount);
    let seeded_value = decode_int(call_contract(SeedExecutorContract, "seed_liquidity", payload));
    SeedInventory[sale] = SeedInventory.get_or(sale, 0) - sale_amount;
    SeedPaymentUsed[sale] = SeedPaymentUsed.get_or(sale, 0) + payment_amount;
    SeedSaleUsed[sale] = SeedSaleUsed.get_or(sale, 0) + sale_amount;
    Seeded[sale] = 1;
    SeedActivationValue[sale] = seeded_value;
    return seeded_value;
  }

  kotoage fn native_lifecycle_tick() permission(AssetOps) {
    if LaunchLifecycleEnabled == 0 {
      return;
    }
    let current_slot = block_height();
    if LaunchLifecycleNextSlot > 0 && current_slot < LaunchLifecycleNextSlot {
      return;
    }
    if NextSaleIndex <= 0 {
      NextSaleIndex = 1;
    }
    let processed = 0;
    let index = LaunchLifecycleCursor;
    if index <= 0 || index >= NextSaleIndex {
      index = 1;
    }
    while processed < LaunchLifecycleMaxItems && index < NextSaleIndex {
      let sale = SaleByIndex.get_or(index, name!("missing"));
      if SaleAsset.contains(sale) && Closed.get_or(sale, 0) == 0 &&
        current_slot >= ClaimStartSlot.get_or(sale, 0) {
        close_sale_impl(sale);
      }
      if SaleAsset.contains(sale) && Closed.get_or(sale, 0) == 1 &&
        Successful.get_or(sale, 0) == 1 &&
        SeedPositionId.contains(sale) &&
        Seeded.get_or(sale, 0) == 0 {
        if Treasury[sale] == FactoryContractId {
          activate_seed_if_contract_custodied(sale);
        } else {
          SeedActivationValue[sale] = -1;
        }
      }
      processed = processed + 1;
      index = index + 1;
    }
    if index >= NextSaleIndex {
      index = 1;
    }
    LaunchLifecycleCursor = index;
    LaunchLifecycleLastSlot = current_slot;
    LaunchLifecycleLastProcessed = processed;
    LaunchLifecycleNextSlot = current_slot + LaunchLifecycleCadenceSlots;
  }

  kotoage fn seed_liquidity(sale: Name) -> int permission(AssetOps) {
    return activate_seed_with_executor(sale);
  }

  kotoage fn finalize_sale_activation(sale: Name,
                                      claim_inventory_amount: int) -> int permission(AssetOps) {
    assert_sale_owner(sale);
    assert(claim_inventory_amount >= 0, "invalid claim inventory amount");
    if Closed.get_or(sale, 0) == 0 {
      close_sale_impl(sale);
    }
    if claim_inventory_amount > 0 {
      move_asset_if_needed(authority(), Treasury[sale], SaleAsset[sale], claim_inventory_amount);
      ClaimInventory[sale] = ClaimInventory.get_or(sale, 0) + claim_inventory_amount;
    }
    if SeedPositionId.contains(sale) && Seeded.get_or(sale, 0) == 0 {
      return activate_seed_with_executor(sale);
    }
    return SeedActivationValue.get_or(sale, 0);
  }

  kotoage fn claim_allocation(allocation: Name) -> int permission(AssetOps) {
    let buyer = authority();
    assert_allocation_exists(allocation);
    let sale = AllocationSale[allocation];
    assert(AllocationBuyer[allocation] == buyer, "buyer mismatch");
    let amount = claim_amount_for(allocation, sale);
    let claim_inventory = ClaimInventory.get_or(sale, 0);
    assert(claim_inventory >= amount, "insufficient claim inventory");
    move_asset_if_needed(Treasury[sale], buyer, SaleAsset[sale], amount);
    AllocationClaimed[allocation] = AllocationClaimed[allocation] + amount;
    ClaimInventory[sale] = claim_inventory - amount;
    ClaimedSupply[sale] = ClaimedSupply.get_or(sale, 0) + amount;
    return amount;
  }

  kotoage fn refund_allocation(allocation: Name) -> int permission(AssetOps) {
    let buyer = authority();
    assert_allocation_exists(allocation);
    let sale = AllocationSale[allocation];
    assert(AllocationBuyer[allocation] == buyer, "buyer mismatch");
    assert(Closed.get_or(sale, 0) == 1, "sale open");
    assert(Successful.get_or(sale, 0) == 0, "sale successful");
    assert(AllocationClaimed[allocation] == 0, "allocation claimed");
    assert(AllocationRefunded[allocation] == 0, "allocation refunded");
    let amount = AllocationPaymentAmount[allocation];
    assert(amount > 0, "nothing refundable");
    move_asset_if_needed(Treasury[sale], buyer, PaymentAsset[sale], amount);
    AllocationRefunded[allocation] = 1;
    RefundedPayment[sale] = RefundedPayment.get_or(sale, 0) + amount;
    return amount;
  }

  kotoage fn mark_seeded(sale: Name) permission(AssetOps) {
    activate_seed_with_executor(sale);
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      LaunchLifecycleEnabled,
      LaunchLifecycleCadenceSlots,
      LaunchLifecycleMaxItems,
      LaunchLifecycleNextSlot,
      LaunchLifecycleCursor,
      LaunchLifecycleLastSlot,
      LaunchLifecycleLastProcessed
    );
  }
}
