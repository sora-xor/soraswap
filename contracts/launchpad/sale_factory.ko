// Custodial launchpad sale factory with bounded lifecycle processing.

seiyaku SaleFactory {
  error enum SaleFactoryError {
    OwnerMismatch = 1,
    GuardianMismatch = 2,
    WithdrawalOnly = 3,
    SaleExists = 4,
    SaleMissing = 5,
    SaleOwnerMismatch = 6,
    SaleClosed = 7,
    SaleOpen = 8,
    SaleFailed = 9,
    SaleSuccessful = 10,
    SaleSeeded = 11,
    SaleNotSeeded = 12,
    InvalidPrice = 13,
    InvalidCap = 14,
    InvalidClaimWindow = 15,
    InvalidAmount = 16,
    HardCapExceeded = 17,
    ZeroSaleOutput = 18,
    AllocationExists = 19,
    AllocationMissing = 20,
    BuyerMismatch = 21,
    AllocationRefunded = 22,
    NothingClaimable = 23,
    NothingRefundable = 24,
    InsufficientClaimInventory = 25,
    InsufficientSeedInventory = 26,
    InsufficientPaymentProceeds = 27,
    SeedPlanMissing = 28,
    SeedActivationFailed = 29,
    InvalidCadence = 30,
    InvalidMaxItems = 31,
    InvalidEnabled = 32,
    SaleLimit = 33,
    IndexCorrupt = 34,
    InvalidAuthoritySeparation = 35,
  }

  state int FactoryInitialized;
  state AccountId FactoryOwner;
  state AccountId FactoryGuardian;
  state AccountId FactoryAccount;
  state bytes SeedExecutorContract;
  state int FactoryWithdrawalOnly;

  state int LaunchLifecycleCadenceSlots;
  state int LaunchLifecycleMaxItems;
  state int LaunchLifecycleEnabled;
  state int LaunchLifecycleNextSlot;
  state int LaunchLifecycleCursor;
  state int LaunchLifecycleLastSlot;
  state int LaunchLifecycleLastProcessed;
  state int NextSaleIndex;
  state StateMap<int, Name> SaleByIndex;

  state StateMap<Name, AccountId> SaleOwner;
  state StateMap<Name, AssetDefinitionId> SaleAsset;
  state StateMap<Name, AssetDefinitionId> PaymentAsset;
  state StateMap<Name, AccountId> Treasury;
  state StateMap<Name, decimal> UnitPrice;
  state StateMap<Name, quantity> SoftCap;
  state StateMap<Name, quantity> HardCap;
  state StateMap<Name, int> ClaimStartSlot;
  state StateMap<Name, int> ClaimEndSlot;
  state StateMap<Name, quantity> Raised;
  state StateMap<Name, quantity> Sold;
  state StateMap<Name, int> Closed;
  state StateMap<Name, int> Successful;
  state StateMap<Name, int> Seeded;
  state StateMap<Name, quantity> SeedInventory;
  state StateMap<Name, quantity> ClaimInventory;
  state StateMap<Name, quantity> ClaimedSupply;
  state StateMap<Name, quantity> RefundedPayment;
  state StateMap<Name, quantity> TreasuryPaymentReleased;

  state StateMap<Name, Name> SeedPositionId;
  state StateMap<Name, int> SeedBinId;
  state StateMap<Name, quantity> SeedPaymentAmount;
  state StateMap<Name, quantity> SeedSaleAmount;
  state StateMap<Name, quantity> SeedPaymentUsed;
  state StateMap<Name, quantity> SeedSaleUsed;
  state StateMap<Name, quantity> SeedActivationShares;

  state StateMap<Name, Name> AllocationSale;
  state StateMap<Name, AccountId> AllocationBuyer;
  state StateMap<Name, quantity> AllocationPaymentAmount;
  state StateMap<Name, quantity> AllocationSaleAmount;
  state StateMap<Name, quantity> AllocationClaimed;
  state StateMap<Name, int> AllocationRefunded;

  trigger soraswap_launchpad_lifecycle_tick -> native_lifecycle_tick {
    on time schedule(20000, 120000);
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "launchpad.sale_factory"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn zero_decimal() -> decimal {
    let decimal zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn missing_name() -> Name {
    let missing = Name::parse("missing");
    return missing;
  }

  fn fallback_asset() -> AssetDefinitionId {
    let asset = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
    return asset;
  }

  fn assert_owner() {
    require(FactoryOwner == context::authority(), SaleFactoryError::OwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if FactoryOwner == context::authority() {
      return;
    }
    require(FactoryGuardian == context::authority(), SaleFactoryError::GuardianMismatch);
  }

  fn assert_sale_exists(Name sale) {
    require(SaleAsset.contains(sale), SaleFactoryError::SaleMissing);
  }

  fn assert_sale_owner(Name sale) {
    assert_sale_exists(sale: sale);
    require(
      SaleOwner.get(sale).unwrap_or(FactoryOwner) == context::authority(),
      SaleFactoryError::SaleOwnerMismatch
    );
  }

  fn assert_allocation_exists(Name allocation) {
    require(AllocationSale.contains(allocation), SaleFactoryError::AllocationMissing);
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    AssetDefinitionId asset,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: asset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn close_sale_impl(Name sale) {
    assert_sale_exists(sale: sale);
    require(Closed.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleClosed);
    Closed[sale] = 1;
    Successful[sale] = (
      Raised.get(sale).unwrap_or(zero_quantity()) >=
        SoftCap.get(sale).unwrap_or(zero_quantity())
    ) ? 1 : 0;
  }

  fn vested_amount(Name allocation, int current_slot) -> quantity {
    let sale = AllocationSale.get(allocation).unwrap_or(missing_name());
    let total = AllocationSaleAmount.get(allocation).unwrap_or(zero_quantity());
    let start = ClaimStartSlot.get(sale).unwrap_or(0);
    let end = ClaimEndSlot.get(sale).unwrap_or(0);
    if current_slot < start {
      return zero_quantity();
    }
    if current_slot >= end {
      return total;
    }
    let elapsed = current_slot - start;
    let duration = end - start;
    let fraction = decimal::from_int(value: elapsed).div_round(
      divisor: decimal::from_int(value: duration),
      scale: 28,
      mode: Rounding::floor
    );
    return total * fraction;
  }

  fn activate_seed(Name sale) -> quantity {
    assert_sale_owner(sale: sale);
    require(Closed.get(sale).unwrap_or(0) == 1, SaleFactoryError::SaleOpen);
    require(Successful.get(sale).unwrap_or(0) == 1, SaleFactoryError::SaleFailed);
    require(Seeded.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleSeeded);
    require(SeedPositionId.contains(sale), SaleFactoryError::SeedPlanMissing);
    let base_amount = SeedPaymentAmount.get(sale).unwrap_or(zero_quantity());
    let quote_amount = SeedSaleAmount.get(sale).unwrap_or(zero_quantity());
    require(base_amount > zero_quantity() && quote_amount > zero_quantity(), SaleFactoryError::InvalidAmount);
    require(
      Raised.get(sale).unwrap_or(zero_quantity()) >= base_amount,
      SaleFactoryError::InsufficientPaymentProceeds
    );
    require(
      SeedInventory.get(sale).unwrap_or(zero_quantity()) >= quote_amount,
      SaleFactoryError::InsufficientSeedInventory
    );
    require(
      ClaimInventory.get(sale).unwrap_or(zero_quantity()) >=
        Sold.get(sale).unwrap_or(zero_quantity()),
      SaleFactoryError::InsufficientClaimInventory
    );
    let shares = contract::invoke(
      contract: SeedExecutorContract,
      entrypoint: "seed_liquidity",
      returns: "quantity",
      position_id: SeedPositionId.get(sale).unwrap_or(missing_name()),
      funding_account: FactoryAccount,
      bin_id: SeedBinId.get(sale).unwrap_or(0),
      base_amount: base_amount,
      quote_amount: quote_amount
    );
    require(shares > zero_quantity(), SaleFactoryError::SeedActivationFailed);
    SeedInventory[sale] = SeedInventory.get(sale).unwrap_or(zero_quantity()) - quote_amount;
    SeedPaymentUsed[sale] = base_amount;
    SeedSaleUsed[sale] = quote_amount;
    SeedActivationShares[sale] = shares;
    Seeded[sale] = 1;
    let proceeds = Raised.get(sale).unwrap_or(zero_quantity()) - base_amount;
    move_asset_if_needed(
      source: FactoryAccount,
      destination: Treasury.get(sale).unwrap_or(FactoryOwner),
      asset: PaymentAsset.get(sale).unwrap_or(SaleAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: proceeds
    );
    TreasuryPaymentReleased[sale] = proceeds;
    return shares;
  }

  hajimari(
    AccountId factory_account,
    bytes executor_contract,
    AccountId guardian
  ) {
    require(factory_account != context::authority(), SaleFactoryError::InvalidAuthoritySeparation);
    require(guardian != context::authority() && guardian != factory_account, SaleFactoryError::InvalidAuthoritySeparation);
    FactoryInitialized = 1;
    FactoryOwner = context::authority();
    FactoryGuardian = guardian;
    FactoryAccount = factory_account;
    SeedExecutorContract = executor_contract;
    FactoryWithdrawalOnly = 1;
    LaunchLifecycleCadenceSlots = 1;
    LaunchLifecycleMaxItems = 1;
    LaunchLifecycleEnabled = 0;
    LaunchLifecycleNextSlot = 0;
    LaunchLifecycleCursor = 1;
    LaunchLifecycleLastSlot = 0;
    LaunchLifecycleLastProcessed = 0;
    NextSaleIndex = 1;
  }

  view fn main() -> int {
    return FactoryInitialized;
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    FactoryWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    FactoryWithdrawalOnly = 0;
  }

  kotoage fn configure_trigger_lifecycle(
    int cadence_slots,
    int max_items_per_tick,
    int enabled
  ) authorize("AssetOps") {
    assert_owner();
    require(cadence_slots > 0, SaleFactoryError::InvalidCadence);
    require(max_items_per_tick > 0 && max_items_per_tick <= 64, SaleFactoryError::InvalidMaxItems);
    require(enabled == 0 || enabled == 1, SaleFactoryError::InvalidEnabled);
    LaunchLifecycleCadenceSlots = cadence_slots;
    LaunchLifecycleMaxItems = max_items_per_tick;
    LaunchLifecycleEnabled = enabled;
    LaunchLifecycleNextSlot = context::block_height() + cadence_slots;
    ledger::trigger::set_enabled(Name::parse("soraswap_launchpad_lifecycle_tick"), enabled);
  }

  kotoage fn init_sale(
    Name sale,
    AssetDefinitionId sale_asset,
    AssetDefinitionId payment_asset,
    AccountId treasury,
    decimal unit_price,
    quantity soft_cap,
    quantity hard_cap,
    int claim_start_slot,
    int claim_end_slot
  ) authorize("Entry") {
    require(FactoryWithdrawalOnly == 0, SaleFactoryError::WithdrawalOnly);
    require(!SaleAsset.contains(sale), SaleFactoryError::SaleExists);
    require(unit_price > zero_decimal(), SaleFactoryError::InvalidPrice);
    require(
      soft_cap > zero_quantity() && hard_cap >= soft_cap,
      SaleFactoryError::InvalidCap
    );
    require(
      claim_start_slot > context::block_height() && claim_end_slot > claim_start_slot,
      SaleFactoryError::InvalidClaimWindow
    );
    require(NextSaleIndex >= 1 && NextSaleIndex <= 64, SaleFactoryError::SaleLimit);
    SaleByIndex[NextSaleIndex] = sale;
    NextSaleIndex = NextSaleIndex + 1;
    SaleOwner[sale] = context::authority();
    SaleAsset[sale] = sale_asset;
    PaymentAsset[sale] = payment_asset;
    Treasury[sale] = treasury;
    UnitPrice[sale] = unit_price;
    SoftCap[sale] = soft_cap;
    HardCap[sale] = hard_cap;
    ClaimStartSlot[sale] = claim_start_slot;
    ClaimEndSlot[sale] = claim_end_slot;
    Raised[sale] = zero_quantity();
    Sold[sale] = zero_quantity();
    Closed[sale] = 0;
    Successful[sale] = 0;
    Seeded[sale] = 0;
    SeedInventory[sale] = zero_quantity();
    ClaimInventory[sale] = zero_quantity();
    ClaimedSupply[sale] = zero_quantity();
    RefundedPayment[sale] = zero_quantity();
    TreasuryPaymentReleased[sale] = zero_quantity();
    SeedPaymentUsed[sale] = zero_quantity();
    SeedSaleUsed[sale] = zero_quantity();
    SeedActivationShares[sale] = zero_quantity();
  }

  kotoage fn contribute_recorded(
    Name sale,
    Name allocation,
    quantity payment_amount
  ) -> quantity authorize("AssetOps") {
    require(FactoryWithdrawalOnly == 0, SaleFactoryError::WithdrawalOnly);
    assert_sale_exists(sale: sale);
    require(!AllocationSale.contains(allocation), SaleFactoryError::AllocationExists);
    require(Closed.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleClosed);
    require(context::block_height() < ClaimStartSlot.get(sale).unwrap_or(0), SaleFactoryError::SaleClosed);
    require(payment_amount > zero_quantity(), SaleFactoryError::InvalidAmount);
    let next_raised = Raised.get(sale).unwrap_or(zero_quantity()) + payment_amount;
    require(next_raised <= HardCap.get(sale).unwrap_or(zero_quantity()), SaleFactoryError::HardCapExceeded);
    let sale_amount = payment_amount / UnitPrice.get(sale).unwrap_or(zero_decimal());
    require(sale_amount > zero_quantity(), SaleFactoryError::ZeroSaleOutput);
    move_asset_if_needed(
      source: context::authority(),
      destination: FactoryAccount,
      asset: PaymentAsset.get(sale).unwrap_or(SaleAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: payment_amount
    );
    AllocationSale[allocation] = sale;
    AllocationBuyer[allocation] = context::authority();
    AllocationPaymentAmount[allocation] = payment_amount;
    AllocationSaleAmount[allocation] = sale_amount;
    AllocationClaimed[allocation] = zero_quantity();
    AllocationRefunded[allocation] = 0;
    Raised[sale] = next_raised;
    Sold[sale] = Sold.get(sale).unwrap_or(zero_quantity()) + sale_amount;
    return sale_amount;
  }

  kotoage fn close_sale(Name sale) authorize("Entry") {
    assert_sale_owner(sale: sale);
    close_sale_impl(sale: sale);
  }

  kotoage fn deposit_seed_inventory(Name sale, quantity amount) -> quantity authorize("AssetOps") {
    assert_sale_owner(sale: sale);
    require(Seeded.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleSeeded);
    require(amount > zero_quantity(), SaleFactoryError::InvalidAmount);
    move_asset_if_needed(
      source: context::authority(),
      destination: FactoryAccount,
      asset: SaleAsset.get(sale).unwrap_or(PaymentAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: amount
    );
    SeedInventory[sale] = SeedInventory.get(sale).unwrap_or(zero_quantity()) + amount;
    return amount;
  }

  kotoage fn deposit_claim_inventory(Name sale, quantity amount) -> quantity authorize("AssetOps") {
    assert_sale_owner(sale: sale);
    require(amount > zero_quantity(), SaleFactoryError::InvalidAmount);
    move_asset_if_needed(
      source: context::authority(),
      destination: FactoryAccount,
      asset: SaleAsset.get(sale).unwrap_or(PaymentAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: amount
    );
    ClaimInventory[sale] = ClaimInventory.get(sale).unwrap_or(zero_quantity()) + amount;
    return amount;
  }

  kotoage fn register_seed_liquidity(
    Name sale,
    Name position_id,
    int bin_id,
    quantity payment_amount,
    quantity sale_amount
  ) authorize("Entry") {
    assert_sale_owner(sale: sale);
    require(Seeded.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleSeeded);
    require(payment_amount > zero_quantity() && sale_amount > zero_quantity(), SaleFactoryError::InvalidAmount);
    SeedPositionId[sale] = position_id;
    SeedBinId[sale] = bin_id;
    SeedPaymentAmount[sale] = payment_amount;
    SeedSaleAmount[sale] = sale_amount;
  }

  kotoage fn seed_liquidity(Name sale) -> quantity authorize("AssetOps") {
    return activate_seed(sale: sale);
  }

  kotoage fn finalize_sale_activation(
    Name sale,
    quantity claim_inventory_amount
  ) -> quantity authorize("AssetOps") {
    assert_sale_owner(sale: sale);
    if Closed.get(sale).unwrap_or(0) == 0 {
      close_sale_impl(sale: sale);
    }
    if claim_inventory_amount > zero_quantity() {
      move_asset_if_needed(
        source: context::authority(),
        destination: FactoryAccount,
        asset: SaleAsset.get(sale).unwrap_or(PaymentAsset.get(sale).unwrap_or(
          fallback_asset()
        )),
        amount: claim_inventory_amount
      );
      ClaimInventory[sale] =
        ClaimInventory.get(sale).unwrap_or(zero_quantity()) + claim_inventory_amount;
    }
    return activate_seed(sale: sale);
  }

  kotoage fn claim_allocation(Name allocation) -> quantity authorize("AssetOps") {
    assert_allocation_exists(allocation: allocation);
    require(
      AllocationBuyer.get(allocation).unwrap_or(FactoryOwner) == context::authority(),
      SaleFactoryError::BuyerMismatch
    );
    require(AllocationRefunded.get(allocation).unwrap_or(0) == 0, SaleFactoryError::AllocationRefunded);
    let sale = AllocationSale.get(allocation).unwrap_or(missing_name());
    require(Seeded.get(sale).unwrap_or(0) == 1, SaleFactoryError::SaleNotSeeded);
    let vested = vested_amount(allocation: allocation, current_slot: context::block_height());
    let claimed = AllocationClaimed.get(allocation).unwrap_or(zero_quantity());
    require(vested > claimed, SaleFactoryError::NothingClaimable);
    let amount = vested - claimed;
    require(
      ClaimInventory.get(sale).unwrap_or(zero_quantity()) >= amount,
      SaleFactoryError::InsufficientClaimInventory
    );
    AllocationClaimed[allocation] = vested;
    ClaimInventory[sale] = ClaimInventory.get(sale).unwrap_or(zero_quantity()) - amount;
    ClaimedSupply[sale] = ClaimedSupply.get(sale).unwrap_or(zero_quantity()) + amount;
    move_asset_if_needed(
      source: FactoryAccount,
      destination: context::authority(),
      asset: SaleAsset.get(sale).unwrap_or(PaymentAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: amount
    );
    return amount;
  }

  kotoage fn refund_allocation(Name allocation) -> quantity authorize("AssetOps") {
    assert_allocation_exists(allocation: allocation);
    require(
      AllocationBuyer.get(allocation).unwrap_or(FactoryOwner) == context::authority(),
      SaleFactoryError::BuyerMismatch
    );
    let sale = AllocationSale.get(allocation).unwrap_or(missing_name());
    require(Closed.get(sale).unwrap_or(0) == 1, SaleFactoryError::SaleOpen);
    require(Successful.get(sale).unwrap_or(0) == 0, SaleFactoryError::SaleSuccessful);
    require(AllocationRefunded.get(allocation).unwrap_or(0) == 0, SaleFactoryError::AllocationRefunded);
    require(AllocationClaimed.get(allocation).unwrap_or(zero_quantity()) == zero_quantity(), SaleFactoryError::NothingRefundable);
    let amount = AllocationPaymentAmount.get(allocation).unwrap_or(zero_quantity());
    require(amount > zero_quantity(), SaleFactoryError::NothingRefundable);
    AllocationRefunded[allocation] = 1;
    RefundedPayment[sale] = RefundedPayment.get(sale).unwrap_or(zero_quantity()) + amount;
    move_asset_if_needed(
      source: FactoryAccount,
      destination: context::authority(),
      asset: PaymentAsset.get(sale).unwrap_or(SaleAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      amount: amount
    );
    return amount;
  }

  kotoage fn native_lifecycle_tick() authorize("AssetOps") {
    if FactoryInitialized == 0 || LaunchLifecycleEnabled == 0 {
      return;
    }
    let current_slot = context::block_height();
    if LaunchLifecycleNextSlot > 0 && current_slot < LaunchLifecycleNextSlot {
      return;
    }
    var processed = 0;
    var cursor = LaunchLifecycleCursor;
    for _step in range(64) {
      if processed < LaunchLifecycleMaxItems && NextSaleIndex > 1 {
        if cursor < 1 || cursor >= NextSaleIndex {
          cursor = 1;
        }
        require(SaleByIndex.contains(cursor), SaleFactoryError::IndexCorrupt);
        let sale = SaleByIndex.get(cursor).unwrap_or(missing_name());
        if Closed.get(sale).unwrap_or(0) == 0 &&
          current_slot >= ClaimStartSlot.get(sale).unwrap_or(0) {
          close_sale_impl(sale: sale);
        }
        cursor = cursor + 1;
        processed = processed + 1;
      }
    }
    if cursor >= NextSaleIndex {
      cursor = 1;
    }
    LaunchLifecycleCursor = cursor;
    LaunchLifecycleLastSlot = current_slot;
    LaunchLifecycleLastProcessed = processed;
    LaunchLifecycleNextSlot = current_slot + LaunchLifecycleCadenceSlots;
  }

  view fn sale_config(Name sale) -> (
    AssetDefinitionId,
    AssetDefinitionId,
    AccountId,
    decimal,
    quantity,
    quantity,
    int,
    int
  ) {
    assert_sale_exists(sale: sale);
    return (
      SaleAsset.get(sale).unwrap_or(PaymentAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      PaymentAsset.get(sale).unwrap_or(SaleAsset.get(sale).unwrap_or(
        fallback_asset()
      )),
      Treasury.get(sale).unwrap_or(FactoryOwner),
      UnitPrice.get(sale).unwrap_or(zero_decimal()),
      SoftCap.get(sale).unwrap_or(zero_quantity()),
      HardCap.get(sale).unwrap_or(zero_quantity()),
      ClaimStartSlot.get(sale).unwrap_or(0),
      ClaimEndSlot.get(sale).unwrap_or(0)
    );
  }

  view fn mirror_sale(Name sale) -> (
    int,
    quantity,
    quantity,
    int,
    int,
    int,
    quantity,
    quantity,
    quantity,
    quantity,
    quantity,
    quantity,
    quantity
  ) {
    let exists = SaleAsset.contains(sale) ? 1 : 0;
    return (
      exists,
      Raised.get(sale).unwrap_or(zero_quantity()),
      Sold.get(sale).unwrap_or(zero_quantity()),
      Closed.get(sale).unwrap_or(0),
      Successful.get(sale).unwrap_or(0),
      Seeded.get(sale).unwrap_or(0),
      SeedInventory.get(sale).unwrap_or(zero_quantity()),
      ClaimInventory.get(sale).unwrap_or(zero_quantity()),
      ClaimedSupply.get(sale).unwrap_or(zero_quantity()),
      RefundedPayment.get(sale).unwrap_or(zero_quantity()),
      SeedPaymentUsed.get(sale).unwrap_or(zero_quantity()),
      SeedSaleUsed.get(sale).unwrap_or(zero_quantity()),
      SeedActivationShares.get(sale).unwrap_or(zero_quantity())
    );
  }

  view fn mirror_sale_accounting(Name sale) -> (quantity, quantity, quantity, quantity) {
    assert_sale_exists(sale: sale);
    return (
      Raised.get(sale).unwrap_or(zero_quantity()),
      TreasuryPaymentReleased.get(sale).unwrap_or(zero_quantity()),
      RefundedPayment.get(sale).unwrap_or(zero_quantity()),
      SeedPaymentUsed.get(sale).unwrap_or(zero_quantity())
    );
  }

  view fn mirror_allocation(Name allocation) -> (int, quantity, quantity, quantity, int) {
    let exists = AllocationSale.contains(allocation) ? 1 : 0;
    return (
      exists,
      AllocationPaymentAmount.get(allocation).unwrap_or(zero_quantity()),
      AllocationSaleAmount.get(allocation).unwrap_or(zero_quantity()),
      AllocationClaimed.get(allocation).unwrap_or(zero_quantity()),
      AllocationRefunded.get(allocation).unwrap_or(0)
    );
  }

  view fn factory_binding_details() -> (AccountId, bytes, int, int) {
    return (FactoryAccount, SeedExecutorContract, 1, 1);
  }

  view fn activation_state(Name sale) -> (int, quantity) {
    assert_sale_exists(sale: sale);
    return (
      Seeded.get(sale).unwrap_or(0),
      SeedActivationShares.get(sale).unwrap_or(zero_quantity())
    );
  }

  view fn trigger_lifecycle_state() -> (int, int, int, int, int, int, int) {
    return (
      LaunchLifecycleEnabled,
      LaunchLifecycleCadenceSlots,
      LaunchLifecycleMaxItems,
      LaunchLifecycleNextSlot,
      LaunchLifecycleCursor,
      LaunchLifecycleLastSlot,
      LaunchLifecycleLastProcessed
    );
  }
}
