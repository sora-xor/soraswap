// Bounded DLMM hook policy and TWAMM execution manager.
//
// The contract escrows inputs in one immutable custody account, limits the
// active work set to 64 slots, and uses a typed nested router invocation.

seiyaku DlmmHookManager {
  error enum DlmmHookManagerError {
    OwnerMismatch = 1,
    GuardianMismatch = 2,
    WithdrawalOnly = 3,
    InvalidDirection = 4,
    InvalidFee = 5,
    InvalidPhase = 6,
    InvalidEnabled = 7,
    InvalidAmount = 8,
    InvalidMinimum = 9,
    InvalidInterval = 10,
    InvalidStartSlot = 11,
    InvalidCadence = 12,
    InvalidMaxOrders = 13,
    HookMissing = 14,
    HookDisabled = 15,
    OrderExists = 16,
    OrderMissing = 17,
    OrderOwnerMismatch = 18,
    OrderNotActive = 19,
    OrderNotClaimable = 20,
    NothingClaimable = 21,
    InsufficientOutput = 22,
    ActiveOrderLimit = 23,
    SlotIndexCorrupt = 24,
    InvalidAuthoritySeparation = 25,
    IdenticalAssets = 26,
  }

  state int HookManagerInitialized;
  state AccountId HookManagerOwner;
  state AccountId HookManagerGuardian;
  state AccountId HookManagerCustodyAccount;
  state bytes HookManagerRouterContract;
  state AssetDefinitionId HookManagerBaseAsset;
  state AssetDefinitionId HookManagerQuoteAsset;
  state int HookManagerWithdrawalOnly;

  state StateMap<Name, int> HookPhase;
  state StateMap<Name, int> HookMaxFeePips;
  state StateMap<Name, int> HookEnabled;

  state StateMap<Name, AccountId> LimitOrderOwner;
  state StateMap<Name, Name> LimitOrderHook;
  state StateMap<Name, quantity> LimitOrderAmountIn;
  state StateMap<Name, quantity> LimitOrderMinOut;
  state StateMap<Name, quantity> LimitOrderExecutedIn;
  state StateMap<Name, quantity> LimitOrderExecutedOut;

  state int TwammCadenceSlots;
  state int TwammMaxOrdersPerTick;
  state int TwammTriggerEnabled;
  state int TwammNextSlotCursor;
  state int TwammActiveOrderCount;
  state int TwammLastTickSlot;
  state int TwammLastTickProcessed;
  state StateMap<int, int> TwammSlotOccupied;
  state StateMap<int, Name> TwammOrderBySlot;
  state StateMap<Name, int> TwammOrderSlot;
  state StateMap<Name, AccountId> TwammOrderOwner;
  state StateMap<Name, int> TwammOrderInputIsBase;
  state StateMap<Name, quantity> TwammOrderTotalIn;
  state StateMap<Name, quantity> TwammOrderSliceIn;
  state StateMap<Name, quantity> TwammOrderMinTotalOut;
  state StateMap<Name, quantity> TwammOrderRemainingIn;
  state StateMap<Name, quantity> TwammOrderExecutedIn;
  state StateMap<Name, quantity> TwammOrderExecutedOut;
  state StateMap<Name, quantity> TwammOrderClaimedOut;
  state StateMap<Name, int> TwammOrderNextSlot;
  state StateMap<Name, int> TwammOrderIntervalSlots;
  state StateMap<Name, int> TwammOrderStatus;

  trigger soraswap_twamm_tick -> native_twamm_tick {
    on time pre_commit;
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "dlmm_hooks.hook_manager"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn missing_name() -> Name {
    let missing = Name::parse("missing");
    return missing;
  }

  fn min_quantity(quantity left, quantity right) -> quantity {
    if left <= right {
      return left;
    }
    return right;
  }

  fn max_quantity(quantity left, quantity right) -> quantity {
    if left >= right {
      return left;
    }
    return right;
  }

  fn assert_owner() {
    require(HookManagerOwner == context::authority(), DlmmHookManagerError::OwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if HookManagerOwner == context::authority() {
      return;
    }
    require(HookManagerGuardian == context::authority(), DlmmHookManagerError::GuardianMismatch);
  }

  fn assert_hook_exists(Name hook_id) {
    require(HookEnabled.contains(hook_id), DlmmHookManagerError::HookMissing);
  }

  fn assert_order_exists(Name order_id) {
    require(TwammOrderOwner.contains(order_id), DlmmHookManagerError::OrderMissing);
  }

  fn assert_order_owner(Name order_id) {
    assert_order_exists(order_id);
    require(
      TwammOrderOwner.get(order_id).unwrap_or(HookManagerOwner) == context::authority(),
      DlmmHookManagerError::OrderOwnerMismatch
    );
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    AssetDefinitionId asset,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: asset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn input_asset(int input_is_base) -> AssetDefinitionId {
    if input_is_base == 1 {
      return HookManagerBaseAsset;
    }
    require(input_is_base == 0, DlmmHookManagerError::InvalidDirection);
    return HookManagerQuoteAsset;
  }

  fn output_asset(int input_is_base) -> AssetDefinitionId {
    if input_is_base == 1 {
      return HookManagerQuoteAsset;
    }
    require(input_is_base == 0, DlmmHookManagerError::InvalidDirection);
    return HookManagerBaseAsset;
  }

  fn allocate_slot(Name order_id) -> int {
    require(TwammActiveOrderCount < 64, DlmmHookManagerError::ActiveOrderLimit);
    var found = 0;
    var chosen = 0;
    for offset in range(64) {
      if found == 0 {
        let candidate = (TwammNextSlotCursor - 1 + offset) % 64 + 1;
        if TwammSlotOccupied.get(candidate).unwrap_or(0) == 0 {
          found = 1;
          chosen = candidate;
        }
      }
    }
    require(found == 1, DlmmHookManagerError::SlotIndexCorrupt);
    TwammSlotOccupied[chosen] = 1;
    TwammOrderBySlot[chosen] = order_id;
    TwammOrderSlot[order_id] = chosen;
    TwammActiveOrderCount = TwammActiveOrderCount + 1;
    TwammNextSlotCursor = (chosen % 64) + 1;
    return chosen;
  }

  fn release_slot(Name order_id) {
    let slot = TwammOrderSlot.get(order_id).unwrap_or(0);
    require(slot >= 1 && slot <= 64, DlmmHookManagerError::SlotIndexCorrupt);
    require(TwammSlotOccupied.get(slot).unwrap_or(0) == 1, DlmmHookManagerError::SlotIndexCorrupt);
    require(TwammActiveOrderCount > 0, DlmmHookManagerError::SlotIndexCorrupt);
    TwammSlotOccupied[slot] = 0;
    TwammActiveOrderCount = TwammActiveOrderCount - 1;
  }

  fn twamm_min_slice_out(
    Name order_id,
    quantity amount_in,
    quantity remaining
  ) -> quantity {
    let total_in = TwammOrderTotalIn.get(order_id).unwrap_or(zero_quantity());
    let min_total_out = TwammOrderMinTotalOut.get(order_id).unwrap_or(zero_quantity());
    require(total_in > zero_quantity(), DlmmHookManagerError::InvalidAmount);
    let ratio = amount_in.ratio_round(
      divisor: total_in,
      scale: 28,
      mode: Rounding::floor
    );
    let proportional = min_total_out * ratio;
    if amount_in >= remaining {
      let executed = TwammOrderExecutedOut.get(order_id).unwrap_or(zero_quantity());
      let residual = (min_total_out > executed)
        ? min_total_out - executed
        : zero_quantity();
      return max_quantity(left: proportional, right: residual);
    }
    return proportional;
  }

  fn execute_twamm_order(Name order_id, int current_slot) -> int {
    if TwammOrderStatus.get(order_id).unwrap_or(0) != 1 {
      return 0;
    }
    if current_slot < TwammOrderNextSlot.get(order_id).unwrap_or(0) {
      return 0;
    }
    let remaining = TwammOrderRemainingIn.get(order_id).unwrap_or(zero_quantity());
    require(remaining > zero_quantity(), DlmmHookManagerError::SlotIndexCorrupt);
    let amount_in = min_quantity(
      left: remaining,
      right: TwammOrderSliceIn.get(order_id).unwrap_or(zero_quantity())
    );
    require(amount_in > zero_quantity(), DlmmHookManagerError::InvalidAmount);
    let min_out = twamm_min_slice_out(
      order_id: order_id,
      amount_in: amount_in,
      remaining: remaining
    );
    let input_is_base = TwammOrderInputIsBase.get(order_id).unwrap_or(0);
    var amount_out = zero_quantity();
    if input_is_base == 1 {
      amount_out = contract::invoke(
        contract: HookManagerRouterContract,
        entrypoint: "route_exact_in_base",
        returns: "quantity",
        amount_in: amount_in,
        min_out: min_out
      );
    } else {
      require(input_is_base == 0, DlmmHookManagerError::InvalidDirection);
      amount_out = contract::invoke(
        contract: HookManagerRouterContract,
        entrypoint: "route_exact_in_quote",
        returns: "quantity",
        amount_in: amount_in,
        min_out: min_out
      );
    }
    require(amount_out >= min_out, DlmmHookManagerError::InsufficientOutput);
    TwammOrderRemainingIn[order_id] = remaining - amount_in;
    TwammOrderExecutedIn[order_id] =
      TwammOrderExecutedIn.get(order_id).unwrap_or(zero_quantity()) + amount_in;
    TwammOrderExecutedOut[order_id] =
      TwammOrderExecutedOut.get(order_id).unwrap_or(zero_quantity()) + amount_out;
    TwammOrderNextSlot[order_id] =
      current_slot + TwammOrderIntervalSlots.get(order_id).unwrap_or(1);
    if TwammOrderRemainingIn.get(order_id).unwrap_or(zero_quantity()) == zero_quantity() {
      require(
        TwammOrderExecutedOut.get(order_id).unwrap_or(zero_quantity()) >=
          TwammOrderMinTotalOut.get(order_id).unwrap_or(zero_quantity()),
        DlmmHookManagerError::InsufficientOutput
      );
      TwammOrderStatus[order_id] = 3;
      release_slot(order_id: order_id);
    }
    return 1;
  }

  fn assert_valid_initialization(
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    AccountId custody_account,
    AccountId guardian
  ) {
    require(base_asset != quote_asset, DlmmHookManagerError::IdenticalAssets);
    require(
      custody_account != context::authority(),
      DlmmHookManagerError::InvalidAuthoritySeparation
    );
    require(
      guardian != context::authority() && guardian != custody_account,
      DlmmHookManagerError::InvalidAuthoritySeparation
    );
  }

  hajimari(
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    AccountId custody_account,
    bytes router_contract,
    AccountId guardian
  ) {
    assert_valid_initialization(
      base_asset: base_asset,
      quote_asset: quote_asset,
      custody_account: custody_account,
      guardian: guardian
    );
    HookManagerInitialized = 1;
    HookManagerOwner = context::authority();
    HookManagerGuardian = guardian;
    HookManagerCustodyAccount = custody_account;
    HookManagerRouterContract = router_contract;
    HookManagerBaseAsset = base_asset;
    HookManagerQuoteAsset = quote_asset;
    HookManagerWithdrawalOnly = 1;
    TwammCadenceSlots = 1;
    TwammMaxOrdersPerTick = 1;
    TwammTriggerEnabled = 0;
    TwammNextSlotCursor = 1;
    TwammActiveOrderCount = 0;
    TwammLastTickSlot = 0;
    TwammLastTickProcessed = 0;
  }

  view fn main() -> int {
    return HookManagerInitialized;
  }

  kotoage fn configure_hook_policy(
    Name hook_id,
    int phase,
    int max_fee_pips,
    int enabled
  ) authorize("Admin") {
    assert_owner();
    require(phase >= 1 && phase <= 3, DlmmHookManagerError::InvalidPhase);
    require(max_fee_pips >= 0 && max_fee_pips < 1_000_000, DlmmHookManagerError::InvalidFee);
    require(enabled == 0 || enabled == 1, DlmmHookManagerError::InvalidEnabled);
    HookPhase[hook_id] = phase;
    HookMaxFeePips[hook_id] = max_fee_pips;
    HookEnabled[hook_id] = enabled;
  }

  kotoage fn configure_trigger_twamm(
    int cadence_slots,
    int max_orders_per_tick,
    int enabled
  ) authorize("AssetOps") {
    assert_owner();
    require(cadence_slots > 0, DlmmHookManagerError::InvalidCadence);
    require(
      max_orders_per_tick > 0 && max_orders_per_tick <= 64,
      DlmmHookManagerError::InvalidMaxOrders
    );
    require(enabled == 0 || enabled == 1, DlmmHookManagerError::InvalidEnabled);
    TwammCadenceSlots = cadence_slots;
    TwammMaxOrdersPerTick = max_orders_per_tick;
    TwammTriggerEnabled = enabled;
    ledger::trigger::set_enabled(Name::parse("soraswap_twamm_tick"), enabled);
  }

  kotoage fn enter_withdrawal_only() authorize("Admin") {
    assert_owner_or_guardian();
    HookManagerWithdrawalOnly = 1;
  }

  kotoage fn exit_withdrawal_only() authorize("Admin") {
    assert_owner();
    HookManagerWithdrawalOnly = 0;
  }

  kotoage fn place_limit_order(
    Name order_id,
    Name hook_id,
    quantity amount_in,
    quantity min_out
  ) authorize("AssetOps") {
    require(HookManagerWithdrawalOnly == 0, DlmmHookManagerError::WithdrawalOnly);
    assert_hook_exists(hook_id: hook_id);
    require(HookEnabled.get(hook_id).unwrap_or(0) == 1, DlmmHookManagerError::HookDisabled);
    require(!LimitOrderOwner.contains(order_id), DlmmHookManagerError::OrderExists);
    require(amount_in > zero_quantity(), DlmmHookManagerError::InvalidAmount);
    LimitOrderOwner[order_id] = context::authority();
    LimitOrderHook[order_id] = hook_id;
    LimitOrderAmountIn[order_id] = amount_in;
    LimitOrderMinOut[order_id] = min_out;
    LimitOrderExecutedIn[order_id] = zero_quantity();
    LimitOrderExecutedOut[order_id] = zero_quantity();
  }

  kotoage fn record_execution(
    Name order_id,
    quantity amount_in,
    quantity amount_out
  ) authorize("Admin") {
    assert_owner();
    require(LimitOrderOwner.contains(order_id), DlmmHookManagerError::OrderMissing);
    let next_in = LimitOrderExecutedIn.get(order_id).unwrap_or(zero_quantity()) + amount_in;
    require(
      next_in <= LimitOrderAmountIn.get(order_id).unwrap_or(zero_quantity()),
      DlmmHookManagerError::InvalidAmount
    );
    LimitOrderExecutedIn[order_id] = next_in;
    LimitOrderExecutedOut[order_id] =
      LimitOrderExecutedOut.get(order_id).unwrap_or(zero_quantity()) + amount_out;
  }

  kotoage fn schedule_twamm(
    Name order_id,
    quantity total_in,
    quantity slice_in,
    int input_is_base,
    quantity min_total_out,
    int start_slot,
    int interval_slots
  ) authorize("AssetOps") {
    require(HookManagerWithdrawalOnly == 0, DlmmHookManagerError::WithdrawalOnly);
    require(!TwammOrderOwner.contains(order_id), DlmmHookManagerError::OrderExists);
    require(total_in > zero_quantity(), DlmmHookManagerError::InvalidAmount);
    require(slice_in > zero_quantity() && slice_in <= total_in, DlmmHookManagerError::InvalidAmount);
    require(min_total_out >= zero_quantity(), DlmmHookManagerError::InvalidMinimum);
    require(input_is_base == 0 || input_is_base == 1, DlmmHookManagerError::InvalidDirection);
    require(start_slot >= context::block_height(), DlmmHookManagerError::InvalidStartSlot);
    require(interval_slots > 0, DlmmHookManagerError::InvalidInterval);
    allocate_slot(order_id: order_id);
    move_asset_if_needed(
      source: context::authority(),
      destination: HookManagerCustodyAccount,
      asset: input_asset(input_is_base: input_is_base),
      amount: total_in
    );
    TwammOrderOwner[order_id] = context::authority();
    TwammOrderInputIsBase[order_id] = input_is_base;
    TwammOrderTotalIn[order_id] = total_in;
    TwammOrderSliceIn[order_id] = slice_in;
    TwammOrderMinTotalOut[order_id] = min_total_out;
    TwammOrderRemainingIn[order_id] = total_in;
    TwammOrderExecutedIn[order_id] = zero_quantity();
    TwammOrderExecutedOut[order_id] = zero_quantity();
    TwammOrderClaimedOut[order_id] = zero_quantity();
    TwammOrderNextSlot[order_id] = start_slot;
    TwammOrderIntervalSlots[order_id] = interval_slots;
    TwammOrderStatus[order_id] = 1;
  }

  kotoage fn cancel_twamm(Name order_id) -> quantity authorize("AssetOps") {
    assert_order_owner(order_id: order_id);
    require(TwammOrderStatus.get(order_id).unwrap_or(0) == 1, DlmmHookManagerError::OrderNotActive);
    let refund = TwammOrderRemainingIn.get(order_id).unwrap_or(zero_quantity());
    TwammOrderRemainingIn[order_id] = zero_quantity();
    TwammOrderStatus[order_id] = 4;
    release_slot(order_id: order_id);
    move_asset_if_needed(
      source: HookManagerCustodyAccount,
      destination: context::authority(),
      asset: input_asset(
        input_is_base: TwammOrderInputIsBase.get(order_id).unwrap_or(0)
      ),
      amount: refund
    );
    return refund;
  }

  kotoage fn claim_twamm(Name order_id) -> quantity authorize("AssetOps") {
    assert_order_owner(order_id: order_id);
    let status = TwammOrderStatus.get(order_id).unwrap_or(0);
    require(status == 3 || status == 4, DlmmHookManagerError::OrderNotClaimable);
    let executed = TwammOrderExecutedOut.get(order_id).unwrap_or(zero_quantity());
    let claimed = TwammOrderClaimedOut.get(order_id).unwrap_or(zero_quantity());
    require(executed > claimed, DlmmHookManagerError::NothingClaimable);
    let amount = executed - claimed;
    TwammOrderClaimedOut[order_id] = executed;
    move_asset_if_needed(
      source: HookManagerCustodyAccount,
      destination: context::authority(),
      asset: output_asset(
        input_is_base: TwammOrderInputIsBase.get(order_id).unwrap_or(0)
      ),
      amount: amount
    );
    return amount;
  }

  kotoage fn native_twamm_tick() authorize("AssetOps") {
    if HookManagerInitialized == 0 || HookManagerWithdrawalOnly == 1 || TwammTriggerEnabled == 0 {
      return;
    }
    let current_slot = context::block_height();
    if TwammLastTickSlot > 0 && current_slot < TwammLastTickSlot + TwammCadenceSlots {
      return;
    }
    var processed = 0;
    for offset in range(64) {
      if processed < TwammMaxOrdersPerTick {
        let slot = (TwammNextSlotCursor - 1 + offset) % 64 + 1;
        if TwammSlotOccupied.get(slot).unwrap_or(0) == 1 {
          require(TwammOrderBySlot.contains(slot), DlmmHookManagerError::SlotIndexCorrupt);
          processed = processed + execute_twamm_order(
            order_id: TwammOrderBySlot.get(slot).unwrap_or(missing_name()),
            current_slot: current_slot
          );
        }
      }
    }
    TwammLastTickSlot = current_slot;
    TwammLastTickProcessed = processed;
  }

  view fn hook_policy(Name hook_id) -> (int, int, int, int) {
    let exists = HookEnabled.contains(hook_id) ? 1 : 0;
    return (
      exists,
      HookPhase.get(hook_id).unwrap_or(0),
      HookMaxFeePips.get(hook_id).unwrap_or(0),
      HookEnabled.get(hook_id).unwrap_or(0)
    );
  }

  view fn quote_hooked_swap(Name order_id) -> (quantity, quantity, quantity, quantity, int) {
    require(LimitOrderOwner.contains(order_id), DlmmHookManagerError::OrderMissing);
    return (
      LimitOrderAmountIn.get(order_id).unwrap_or(zero_quantity()),
      LimitOrderMinOut.get(order_id).unwrap_or(zero_quantity()),
      LimitOrderExecutedIn.get(order_id).unwrap_or(zero_quantity()),
      LimitOrderExecutedOut.get(order_id).unwrap_or(zero_quantity()),
      HookEnabled.get(LimitOrderHook.get(order_id).unwrap_or(missing_name())).unwrap_or(0)
    );
  }

  view fn twamm_order_state(Name order_id) -> (
    int,
    quantity,
    quantity,
    quantity,
    quantity,
    quantity,
    int,
    int,
    int
  ) {
    let exists = TwammOrderOwner.contains(order_id) ? 1 : 0;
    return (
      exists,
      TwammOrderTotalIn.get(order_id).unwrap_or(zero_quantity()),
      TwammOrderRemainingIn.get(order_id).unwrap_or(zero_quantity()),
      TwammOrderExecutedIn.get(order_id).unwrap_or(zero_quantity()),
      TwammOrderExecutedOut.get(order_id).unwrap_or(zero_quantity()),
      TwammOrderClaimedOut.get(order_id).unwrap_or(zero_quantity()),
      TwammOrderNextSlot.get(order_id).unwrap_or(0),
      TwammOrderIntervalSlots.get(order_id).unwrap_or(0),
      TwammOrderStatus.get(order_id).unwrap_or(0)
    );
  }

  view fn twamm_trigger_state() -> (int, int, int, int, int, int, int) {
    return (
      TwammTriggerEnabled,
      TwammCadenceSlots,
      TwammMaxOrdersPerTick,
      TwammNextSlotCursor,
      TwammActiveOrderCount,
      TwammLastTickSlot,
      TwammLastTickProcessed
    );
  }
}
