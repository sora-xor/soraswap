// Trigger-native bounded batch auction for XOR/stable launch routing.
// Each epoch admits at most 64 orders and 64 price ticks, matching Kotodama
// the compiler-proven runtime bound. Asset amounts are `quantity`.

seiyaku EpochAuction {
  error enum EpochAuctionError {
    IdenticalAssets = 1,
    AuctionOwnerMismatch = 2,
    AuctionGuardianMismatch = 3,
    AuctionPaused = 4,
    InvalidPaused = 5,
    EpochActive = 6,
    EpochNotActive = 7,
    EpochNotClosed = 8,
    EpochNotStarted = 9,
    EpochClosed = 10,
    StaleEpoch = 11,
    InvalidStartSlot = 12,
    InvalidEndSlot = 13,
    InvalidLowerTick = 14,
    InvalidUpperTick = 15,
    InvalidTickStep = 16,
    TooManyTicks = 17,
    InvalidMaxOrders = 18,
    EpochOrderCap = 19,
    InvalidSide = 20,
    InvalidAmount = 21,
    InvalidLimitTick = 22,
    OrderExists = 23,
    OrderMissing = 24,
    OrderOwnerMismatch = 25,
    OrderNotActive = 26,
    OrderSettled = 27,
    OrderIndexCorrupt = 28,
    EpochAccountingInvariant = 29,
    CustodyAccountIsOwner = 30,
    StaleStartSlot = 31,
    MisalignedTickGrid = 32,
    LimitTickOutsideGrid = 33,
    LimitTickMisaligned = 34,
  }

  state int AuctionInitialized;
  state AccountId AuctionOwner;
  state AccountId AuctionGuardian;
  state AccountId AuctionContractId;
  state int AuctionContractBound;
  state int AuctionPaused;
  state AssetDefinitionId AuctionBaseAsset;
  state AssetDefinitionId AuctionQuoteAsset;

  state int EpochId;
  state int EpochStartSlot;
  state int EpochEndSlot;
  state int EpochLowerTick;
  state int EpochUpperTick;
  state int EpochTickStep;
  state int EpochMaxOrders;
  state int EpochStatus;
  state int EpochOrderCount;
  state quantity EpochClearingBase;
  state int EpochClearingTick;
  state quantity EpochBidBaseAtClearing;
  state quantity EpochAskBaseAtClearing;
  state int EpochLastCloseSlot;

  state StateMap<int, int> EpochStatusById;
  state StateMap<int, int> EpochClearingTickById;
  state StateMap<int, quantity> EpochClearingBaseById;
  state StateMap<int, quantity> EpochBidBaseAtClearingById;
  state StateMap<int, quantity> EpochAskBaseAtClearingById;

  state int NextOrderIndex;
  state StateMap<int, Name> OrderByIndex;
  state StateMap<Name, AccountId> OrderOwner;
  state StateMap<Name, int> OrderEpoch;
  state StateMap<Name, int> OrderSide;
  state StateMap<Name, quantity> OrderAmount;
  state StateMap<Name, int> OrderLimitTick;
  state StateMap<Name, int> OrderStatus;
  state StateMap<Name, quantity> OrderBaseOut;
  state StateMap<Name, quantity> OrderQuoteOut;
  state StateMap<Name, quantity> OrderBaseRefund;
  state StateMap<Name, quantity> OrderQuoteRefund;

  trigger soraswap_epoch_auction_close -> native_epoch_auction_close {
    on time pre_commit;
    repeats indefinitely;
    metadata { "tag": "soraswap"; "module": "batch_amm.epoch_auction"; "__enabled": false; }
  }

  fn zero_quantity() -> quantity {
    let quantity zero = 0;
    return zero;
  }

  fn universal_dataspace() -> DataSpaceId {
    let dataspace = DataSpaceId::parse("0");
    return dataspace;
  }

  fn close_trigger_name() -> Name {
    let trigger_name = Name::parse("soraswap_epoch_auction_close");
    return trigger_name;
  }

  fn min_quantity(quantity left, quantity right) -> quantity {
    if left <= right {
      return left;
    }
    return right;
  }

  fn quantity_distance(quantity left, quantity right) -> quantity {
    if left >= right {
      return left - right;
    }
    return right - left;
  }

  fn assert_owner() {
    require(AuctionOwner == context::authority(), EpochAuctionError::AuctionOwnerMismatch);
  }

  fn assert_owner_or_guardian() {
    if AuctionOwner == context::authority() {
      return;
    }
    require(
      AuctionGuardian == context::authority(),
      EpochAuctionError::AuctionGuardianMismatch
    );
  }

  fn assert_not_paused() {
    require(AuctionPaused == 0, EpochAuctionError::AuctionPaused);
  }

  fn assert_active_epoch() {
    require(EpochStatus == 1, EpochAuctionError::EpochNotActive);
  }

  fn assert_order_exists(Name order_id) {
    require(OrderOwner.contains(order_id), EpochAuctionError::OrderMissing);
    require(OrderEpoch.contains(order_id), EpochAuctionError::OrderMissing);
  }

  fn order_owner_value(Name order_id) -> AccountId {
    assert_order_exists(order_id);
    return OrderOwner.get(order_id).unwrap_or(context::authority());
  }

  fn order_epoch_value(Name order_id) -> int {
    assert_order_exists(order_id);
    return OrderEpoch.get(order_id).unwrap_or(0);
  }

  fn order_amount_value(Name order_id) -> quantity {
    return OrderAmount.get(order_id).unwrap_or(zero_quantity());
  }

  fn epoch_status_for(int order_epoch) -> int {
    if order_epoch == EpochId {
      return EpochStatus;
    }
    return EpochStatusById.get(order_epoch).unwrap_or(0);
  }

  fn epoch_clearing_tick_for(int order_epoch) -> int {
    if order_epoch == EpochId && !EpochClearingTickById.contains(order_epoch) {
      return EpochClearingTick;
    }
    return EpochClearingTickById.get(order_epoch).unwrap_or(0);
  }

  fn epoch_clearing_base_for(int order_epoch) -> quantity {
    if order_epoch == EpochId && !EpochClearingBaseById.contains(order_epoch) {
      return EpochClearingBase;
    }
    return EpochClearingBaseById.get(order_epoch).unwrap_or(zero_quantity());
  }

  fn epoch_bid_base_at_clearing_for(int order_epoch) -> quantity {
    if order_epoch == EpochId && !EpochBidBaseAtClearingById.contains(order_epoch) {
      return EpochBidBaseAtClearing;
    }
    return EpochBidBaseAtClearingById.get(order_epoch).unwrap_or(zero_quantity());
  }

  fn epoch_ask_base_at_clearing_for(int order_epoch) -> quantity {
    if order_epoch == EpochId && !EpochAskBaseAtClearingById.contains(order_epoch) {
      return EpochAskBaseAtClearing;
    }
    return EpochAskBaseAtClearingById.get(order_epoch).unwrap_or(zero_quantity());
  }

  fn persist_current_epoch_state() {
    if EpochId > 0 {
      EpochStatusById[EpochId] = EpochStatus;
      EpochClearingTickById[EpochId] = EpochClearingTick;
      EpochClearingBaseById[EpochId] = EpochClearingBase;
      EpochBidBaseAtClearingById[EpochId] = EpochBidBaseAtClearing;
      EpochAskBaseAtClearingById[EpochId] = EpochAskBaseAtClearing;
    }
  }

  fn close_current_epoch(
    int clearing_tick,
    quantity clearing_base,
    quantity bid_base_at_clearing,
    quantity ask_base_at_clearing,
    int close_slot
  ) {
    EpochClearingTick = clearing_tick;
    EpochClearingBase = clearing_base;
    EpochBidBaseAtClearing = bid_base_at_clearing;
    EpochAskBaseAtClearing = ask_base_at_clearing;
    EpochLastCloseSlot = close_slot;
    EpochStatus = 2;
    persist_current_epoch_state();
  }

  fn tick_price(int tick) -> decimal {
    let decimal scale = 1_000_000;
    return decimal::from_int(value: tick) / scale;
  }

  fn base_capacity_for_bid(quantity quote_amount, int tick) -> quantity {
    if quote_amount == zero_quantity() || tick <= 0 {
      return zero_quantity();
    }
    return quote_amount.div_round(
      divisor: tick_price(tick),
      scale: 28,
      mode: Rounding::floor
    );
  }

  fn quote_for_base(quantity base_amount, int tick) -> quantity {
    if base_amount == zero_quantity() || tick <= 0 {
      return zero_quantity();
    }
    return base_amount * tick_price(tick);
  }

  fn order_crosses_tick(Name order_id, int tick) -> int {
    let side = OrderSide.get(order_id).unwrap_or(0);
    let limit = OrderLimitTick.get(order_id).unwrap_or(0);
    if side == 1 && limit >= tick {
      return 1;
    }
    if side == 2 && limit <= tick {
      return 1;
    }
    return 0;
  }

  fn totals_at_tick(int tick) -> (quantity, quantity, quantity) {
    var bid_base = zero_quantity();
    var ask_base = zero_quantity();
    for offset in range(64) {
      let index = offset + 1;
      if index >= NextOrderIndex {
        break;
      }
      require(OrderByIndex.contains(index), EpochAuctionError::OrderIndexCorrupt);
      let order_id = OrderByIndex.get(index).unwrap_or(Name::parse("missing"));
      if OrderStatus.get(order_id).unwrap_or(0) == 1 &&
        order_epoch_value(order_id) == EpochId &&
        order_crosses_tick(order_id: order_id, tick: tick) == 1 {
        if OrderSide.get(order_id).unwrap_or(0) == 1 {
          bid_base = bid_base + base_capacity_for_bid(
            quote_amount: order_amount_value(order_id),
            tick: tick
          );
        } else {
          ask_base = ask_base + order_amount_value(order_id);
        }
      }
    }
    return (bid_base, ask_base, min_quantity(left: bid_base, right: ask_base));
  }

  fn compute_clearing() -> (int, quantity, quantity, quantity) {
    var tick = EpochLowerTick;
    var first_best_tick = 0;
    var last_best_tick = 0;
    var best_base = zero_quantity();
    var best_imbalance = zero_quantity();
    var best_found = 0;
    for _tick_index in range(64) {
      if tick > EpochUpperTick {
        break;
      }
      let totals = totals_at_tick(tick);
      let imbalance = quantity_distance(left: totals.0, right: totals.1);
      if best_found == 0 || totals.2 > best_base ||
        (totals.2 == best_base && imbalance < best_imbalance) {
        first_best_tick = tick;
        last_best_tick = tick;
        best_base = totals.2;
        best_imbalance = imbalance;
        best_found = 1;
      } else {
        if totals.2 == best_base && imbalance == best_imbalance {
          last_best_tick = tick;
        }
      }
      tick = tick + EpochTickStep;
    }
    if best_base == zero_quantity() {
      return (0, zero_quantity(), zero_quantity(), zero_quantity());
    }
    let midpoint_steps = (last_best_tick - first_best_tick) / EpochTickStep / 2;
    let best_tick = first_best_tick + midpoint_steps * EpochTickStep;
    let best_totals = totals_at_tick(best_tick);
    return (best_tick, best_totals.2, best_totals.0, best_totals.1);
  }

  fn move_asset_if_needed(
    AccountId source,
    AccountId destination,
    AssetDefinitionId asset,
    quantity amount
  ) {
    if amount > zero_quantity() && source != destination {
      ledger::asset::transfer(
        source: source,
        destination: destination,
        asset_definition: asset,
        amount: amount,
        dataspace: universal_dataspace()
      );
    }
  }

  fn close_epoch_impl(int reject_before_deadline) {
    assert_active_epoch();
    let current_slot = context::block_height();
    if current_slot < EpochEndSlot {
      require(reject_before_deadline == 0, EpochAuctionError::EpochNotClosed);
      return;
    }
    if EpochOrderCount == 0 {
      close_current_epoch(
        clearing_tick: 0,
        clearing_base: zero_quantity(),
        bid_base_at_clearing: zero_quantity(),
        ask_base_at_clearing: zero_quantity(),
        close_slot: current_slot
      );
      return;
    }
    let clearing = compute_clearing();
    close_current_epoch(
      clearing_tick: clearing.0,
      clearing_base: clearing.1,
      bid_base_at_clearing: clearing.2,
      ask_base_at_clearing: clearing.3,
      close_slot: current_slot
    );
  }

  fn assert_valid_initialization(
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    AccountId custody_account
  ) {
    require(base_asset != quote_asset, EpochAuctionError::IdenticalAssets);
    require(
      custody_account != context::authority(),
      EpochAuctionError::CustodyAccountIsOwner
    );
  }

  fn assert_valid_epoch_configuration(
    int epoch_id,
    int start_slot,
    int end_slot,
    int lower_tick,
    int upper_tick,
    int tick_step,
    int max_orders
  ) {
    require(epoch_id > EpochId, EpochAuctionError::StaleEpoch);
    require(start_slot >= 0, EpochAuctionError::InvalidStartSlot);
    require(end_slot > start_slot, EpochAuctionError::InvalidEndSlot);
    require(lower_tick > 0, EpochAuctionError::InvalidLowerTick);
    require(upper_tick >= lower_tick, EpochAuctionError::InvalidUpperTick);
    require(tick_step > 0, EpochAuctionError::InvalidTickStep);
    require(
      (upper_tick - lower_tick) % tick_step == 0,
      EpochAuctionError::MisalignedTickGrid
    );
    let tick_count = (upper_tick - lower_tick) / tick_step + 1;
    require(tick_count <= 64, EpochAuctionError::TooManyTicks);
    require(max_orders > 0 && max_orders <= 64, EpochAuctionError::InvalidMaxOrders);
    require(start_slot >= context::block_height(), EpochAuctionError::StaleStartSlot);
  }

  hajimari(
    AssetDefinitionId base_asset,
    AssetDefinitionId quote_asset,
    AccountId custody_account,
    AccountId guardian
  ) {
    assert_valid_initialization(
      base_asset: base_asset,
      quote_asset: quote_asset,
      custody_account: custody_account
    );
    AuctionInitialized = 1;
    AuctionOwner = context::authority();
    AuctionGuardian = guardian;
    AuctionContractId = custody_account;
    AuctionContractBound = 1;
    AuctionPaused = 1;
    AuctionBaseAsset = base_asset;
    AuctionQuoteAsset = quote_asset;
    EpochId = 0;
    EpochStartSlot = 0;
    EpochEndSlot = 0;
    EpochLowerTick = 0;
    EpochUpperTick = 0;
    EpochTickStep = 1;
    EpochMaxOrders = 0;
    EpochStatus = 0;
    EpochOrderCount = 0;
    EpochClearingTick = 0;
    EpochClearingBase = zero_quantity();
    EpochBidBaseAtClearing = zero_quantity();
    EpochAskBaseAtClearing = zero_quantity();
    EpochLastCloseSlot = 0;
    NextOrderIndex = 1;
  }

  view fn main() -> int {
    return AuctionInitialized;
  }

  kotoage fn enter_paused() authorize("Admin") {
    assert_owner_or_guardian();
    AuctionPaused = 1;
  }

  kotoage fn exit_paused() authorize("Admin") {
    assert_owner();
    AuctionPaused = 0;
  }

  kotoage fn configure_epoch(
    int epoch_id,
    int start_slot,
    int end_slot,
    int lower_tick,
    int upper_tick,
    int tick_step,
    int max_orders
  ) authorize("Admin") {
    assert_owner();
    assert_not_paused();
    require(EpochStatus != 1, EpochAuctionError::EpochActive);
    persist_current_epoch_state();
    assert_valid_epoch_configuration(
      epoch_id: epoch_id,
      start_slot: start_slot,
      end_slot: end_slot,
      lower_tick: lower_tick,
      upper_tick: upper_tick,
      tick_step: tick_step,
      max_orders: max_orders
    );
    EpochId = epoch_id;
    EpochStartSlot = start_slot;
    EpochEndSlot = end_slot;
    EpochLowerTick = lower_tick;
    EpochUpperTick = upper_tick;
    EpochTickStep = tick_step;
    EpochMaxOrders = max_orders;
    EpochStatus = 1;
    EpochOrderCount = 0;
    EpochClearingTick = 0;
    EpochClearingBase = zero_quantity();
    EpochBidBaseAtClearing = zero_quantity();
    EpochAskBaseAtClearing = zero_quantity();
    EpochLastCloseSlot = 0;
    NextOrderIndex = 1;
    persist_current_epoch_state();
    ledger::trigger::set_enabled(close_trigger_name(), 1);
  }

  kotoage fn submit_order(
    Name order_id,
    int side,
    quantity amount,
    int limit_tick
  ) authorize("AssetOps") {
    assert_active_epoch();
    assert_not_paused();
    require(side == 1 || side == 2, EpochAuctionError::InvalidSide);
    require(amount > zero_quantity(), EpochAuctionError::InvalidAmount);
    require(limit_tick > 0, EpochAuctionError::InvalidLimitTick);
    require(
      limit_tick >= EpochLowerTick && limit_tick <= EpochUpperTick,
      EpochAuctionError::LimitTickOutsideGrid
    );
    require(
      (limit_tick - EpochLowerTick) % EpochTickStep == 0,
      EpochAuctionError::LimitTickMisaligned
    );
    require(!OrderOwner.contains(order_id), EpochAuctionError::OrderExists);
    require(EpochOrderCount < EpochMaxOrders, EpochAuctionError::EpochOrderCap);
    let current_slot = context::block_height();
    require(current_slot >= EpochStartSlot, EpochAuctionError::EpochNotStarted);
    require(current_slot < EpochEndSlot, EpochAuctionError::EpochClosed);
    let asset = (side == 1) ? AuctionQuoteAsset : AuctionBaseAsset;
    move_asset_if_needed(
      source: context::authority(),
      destination: AuctionContractId,
      asset: asset,
      amount: amount
    );
    let index = NextOrderIndex;
    NextOrderIndex = index + 1;
    OrderByIndex[index] = order_id;
    OrderOwner[order_id] = context::authority();
    OrderEpoch[order_id] = EpochId;
    OrderSide[order_id] = side;
    OrderAmount[order_id] = amount;
    OrderLimitTick[order_id] = limit_tick;
    OrderStatus[order_id] = 1;
    OrderBaseOut[order_id] = zero_quantity();
    OrderQuoteOut[order_id] = zero_quantity();
    OrderBaseRefund[order_id] = zero_quantity();
    OrderQuoteRefund[order_id] = zero_quantity();
    EpochOrderCount = EpochOrderCount + 1;
  }

  kotoage fn cancel_order(Name order_id) authorize("AssetOps") {
    require(order_owner_value(order_id) == context::authority(), EpochAuctionError::OrderOwnerMismatch);
    require(OrderStatus.get(order_id).unwrap_or(0) == 1, EpochAuctionError::OrderNotActive);
    require(
      epoch_status_for(order_epoch_value(order_id)) == 1,
      EpochAuctionError::EpochNotActive
    );
    require(context::block_height() < EpochEndSlot, EpochAuctionError::EpochClosed);
    let side = OrderSide.get(order_id).unwrap_or(0);
    let amount = order_amount_value(order_id);
    OrderStatus[order_id] = 2;
    if side == 1 {
      OrderQuoteRefund[order_id] = amount;
      move_asset_if_needed(
        source: AuctionContractId,
        destination: context::authority(),
        asset: AuctionQuoteAsset,
        amount: amount
      );
    } else {
      OrderBaseRefund[order_id] = amount;
      move_asset_if_needed(
        source: AuctionContractId,
        destination: context::authority(),
        asset: AuctionBaseAsset,
        amount: amount
      );
    }
  }

  kotoage fn close_epoch() authorize("Entry") {
    close_epoch_impl(1);
  }

  kotoage fn native_epoch_auction_close() authorize("Admin") {
    if EpochStatus != 1 {
      ledger::trigger::set_enabled(close_trigger_name(), 0);
      return;
    }
    close_epoch_impl(0);
    if EpochStatus != 1 {
      ledger::trigger::set_enabled(close_trigger_name(), 0);
    }
  }

  kotoage fn settle_order(Name order_id) -> quantity authorize("AssetOps") {
    let order_epoch = order_epoch_value(order_id);
    require(epoch_status_for(order_epoch) == 2, EpochAuctionError::EpochNotClosed);
    require(order_owner_value(order_id) == context::authority(), EpochAuctionError::OrderOwnerMismatch);
    require(OrderStatus.get(order_id).unwrap_or(0) == 1, EpochAuctionError::OrderSettled);
    let side = OrderSide.get(order_id).unwrap_or(0);
    let amount = order_amount_value(order_id);
    let tick = epoch_clearing_tick_for(order_epoch);
    let matched_base = epoch_clearing_base_for(order_epoch);
    let bid_base_at_clearing = epoch_bid_base_at_clearing_for(order_epoch);
    let ask_base_at_clearing = epoch_ask_base_at_clearing_for(order_epoch);
    var base_out = zero_quantity();
    var quote_out = zero_quantity();
    var base_refund = zero_quantity();
    var quote_refund = zero_quantity();

    if tick <= 0 || matched_base == zero_quantity() ||
      order_crosses_tick(order_id: order_id, tick: tick) == 0 {
      if side == 1 {
        quote_refund = amount;
      } else {
        base_refund = amount;
      }
    } else {
      if side == 1 {
        let capacity = base_capacity_for_bid(quote_amount: amount, tick: tick);
        if bid_base_at_clearing <= matched_base {
          base_out = capacity;
        } else {
          base_out = capacity * matched_base.ratio_round(
            divisor: bid_base_at_clearing,
            scale: 28,
            mode: Rounding::floor
          );
        }
        let quote_spent = quote_for_base(base_amount: base_out, tick: tick);
        require(amount >= quote_spent, EpochAuctionError::EpochAccountingInvariant);
        quote_refund = amount - quote_spent;
      } else {
        if ask_base_at_clearing <= matched_base {
          base_out = amount;
        } else {
          base_out = amount * matched_base.ratio_round(
            divisor: ask_base_at_clearing,
            scale: 28,
            mode: Rounding::floor
          );
        }
        quote_out = quote_for_base(base_amount: base_out, tick: tick);
        require(amount >= base_out, EpochAuctionError::EpochAccountingInvariant);
        base_refund = amount - base_out;
      }
    }

    OrderStatus[order_id] = 3;
    OrderBaseOut[order_id] = base_out;
    OrderQuoteOut[order_id] = quote_out;
    OrderBaseRefund[order_id] = base_refund;
    OrderQuoteRefund[order_id] = quote_refund;
    if side == 1 {
      move_asset_if_needed(
        source: AuctionContractId,
        destination: context::authority(),
        asset: AuctionBaseAsset,
        amount: base_out
      );
      move_asset_if_needed(
        source: AuctionContractId,
        destination: context::authority(),
        asset: AuctionQuoteAsset,
        amount: quote_refund
      );
      return base_out;
    }
    move_asset_if_needed(
      source: AuctionContractId,
      destination: context::authority(),
      asset: AuctionQuoteAsset,
      amount: quote_out
    );
    move_asset_if_needed(
      source: AuctionContractId,
      destination: context::authority(),
      asset: AuctionBaseAsset,
      amount: base_refund
    );
    return quote_out;
  }

  view fn epoch_state() -> (
    int,
    int,
    int,
    int,
    int,
    int,
    int,
    int,
    int,
    quantity,
    int
  ) {
    return (
      EpochId,
      EpochStatus,
      EpochStartSlot,
      EpochEndSlot,
      EpochLowerTick,
      EpochUpperTick,
      EpochTickStep,
      EpochOrderCount,
      EpochClearingTick,
      EpochClearingBase,
      EpochLastCloseSlot
    );
  }

  view fn auction_config() -> (int, int, int) {
    return (AuctionInitialized, AuctionContractBound, AuctionPaused);
  }

  view fn order_state(Name order_id) -> (
    int,
    int,
    int,
    quantity,
    int,
    int,
    quantity,
    quantity,
    quantity
  ) {
    let registered = OrderOwner.contains(order_id) ? 1 : 0;
    return (
      registered,
      OrderEpoch.get(order_id).unwrap_or(0),
      OrderSide.get(order_id).unwrap_or(0),
      order_amount_value(order_id),
      OrderLimitTick.get(order_id).unwrap_or(0),
      OrderStatus.get(order_id).unwrap_or(0),
      OrderBaseOut.get(order_id).unwrap_or(zero_quantity()),
      OrderQuoteOut.get(order_id).unwrap_or(zero_quantity()),
      OrderBaseRefund.get(order_id).unwrap_or(zero_quantity()) +
        OrderQuoteRefund.get(order_id).unwrap_or(zero_quantity())
    );
  }
}
