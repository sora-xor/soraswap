# macOS
.DS_Store

# Build and compile outputs
artifacts/**
build/
dist/

# Local runtime state
tmp*
deployments/local/**
!deployments/local/.gitkeep
deployments/staging/**
!deployments/staging/.gitkeep
deployments/testnet/**
!deployments/testnet/.gitkeep
deployments/production/**
!deployments/production/.gitkeep

# Local config and credentials
.env
.env.local
config/testnet/*.toml
!config/testnet/*.example
!config/testnet/*.toml.example
config/production/*.toml
!config/production/*.example
!config/production/*.toml.example
config/production/cutover-approval.json
config/*.local.toml
config/validation_fee/*.local.json
*.pid
*.log

# IDE/editor
.idea/
.vscode/

# Rust/Node/Python transient outputs if used in helper tooling
target/
node_modules/
__pycache__/
*.pyc
*.tsbuildinfo

# Generated manifests and compiled bytecode kept untracked by default
*.to
*.manifest.json
